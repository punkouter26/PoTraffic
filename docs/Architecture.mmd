graph TD
    subgraph Client [Client Side - Blazor WASM]
        WASM[PoTraffic.Client]
        Radzen[Radzen Blazor Components]
        WASM --> Radzen
    end

    subgraph Server [Server Side - ASP.NET Core 10]
        API[PoTraffic.API Minimal API]
        MediatR[MediatR Vertical Slices]
        Scheduler[Table Storage Scheduler]
        Serilog[Serilog Structured Logging]

        API --> MediatR
        API --> Scheduler
        API --> Serilog
    end

    subgraph Persistence [Data and External Services]
        Tables[Azure Table Storage / Azurite]
        Maps[Traffic Providers - Google and TomTom]
        AppInsights[Azure Monitor / App Insights]
        Scheduler --> Tables
        MediatR --> Tables
        MediatR --> Maps
        Serilog --> AppInsights
    end

    WASM -- HTTPS / JSON / JWT --> API
    API -- Static Files --> WASM
