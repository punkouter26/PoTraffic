graph LR
    subgraph Input [User Input]
        UI[Create Route / Window]
    end

    subgraph Processing [Engine]
        Job[Scheduled Poll Job]
        Prov[ITrafficProvider]
    end

    subgraph Storage [Persistence]
        Tables[(Table Storage)]
    end

    subgraph Output [Visualization]
        Chart[Radzen Analytics Chart]
    end

    UI --> Tables
    Job -- 'Poll every X min' --> UI
    Job --> Prov
    Prov -- 'External API (Google/TomTom)' --> Prov
    Prov --> Tables
    Tables --> Chart
