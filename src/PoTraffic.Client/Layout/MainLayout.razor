@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using PoTraffic.Client.Infrastructure.Auth
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject HttpClient Http

@* Radzen service host components — must be present exactly once in the root layout *@
<RadzenNotification />
<RadzenDialog />
<RadzenTooltip />

@* Standard §10 — top nav bar (portrait-phone-first), app name left-aligned, no nav items.
   User identity chip is on the right; ANON sessions show "ANON LOGGED IN" (§6). *@
<header class="pt-top-bar">
    <NavMenu />

    @* Mock-data banner — shown when server reports UseMockProviders=true (§10 / §7) *@
    @if (_isMockMode)
    {
        <span class="pt-mock-badge">⚠ USING MOCK DATA</span>
    }

    @if (_isAuthenticated)
    {
        @* Strategy: ANON accounts use email prefix "anon" + digits + "@potraffic.dev" *@
        @if (_isAnon)
        {
            @* §6 — When ANON is logged in show "ANON LOGGED IN" *@
            <div class="pt-user-chip pt-anon-chip" title="Development ANON session">
                <span class="pt-user-avatar">A</span>
                <span>ANON LOGGED IN</span>
                <button class="pt-anon-signout" @onclick="LogoutAsync" type="button" title="Sign out">✕</button>
            </div>
        }
        else
        {
            @* §6 — Regular user: show their email *@
            <div class="pt-user-chip" @onclick:stopPropagation="true">
                <button class="pt-user-chip-btn" @onclick="ToggleMenu" type="button">
                    <div class="pt-user-avatar">@_initials</div>
                    <span>@_email</span>
                    <span class="pt-chevron">▾</span>
                </button>
                @if (_menuOpen)
                {
                    <div class="pt-user-dropdown" @onclick:stopPropagation="true">
                        <div class="pt-user-dropdown-header">
                            <div class="pt-dropdown-label">Signed in as</div>
                            <div class="pt-user-dropdown-email">@_email</div>
                        </div>
                        <a class="pt-dropdown-item" href="/account/settings">
                            <span class="material-symbols-outlined" style="font-size:1rem;">settings</span>
                            Account Settings
                        </a>
                        <div class="pt-dropdown-divider"></div>
                        <button class="pt-dropdown-item danger" @onclick="LogoutAsync" type="button">
                            <span class="material-symbols-outlined" style="font-size:1rem;">logout</span>
                            Sign Out
                        </button>
                    </div>
                }
            </div>
        }
    }
</header>

<main class="pt-main-content">
    <article class="content px-4">
        @Body
    </article>
</main>

@* Close dropdown when clicking outside *@
@if (_menuOpen)
{
    <div style="position:fixed;inset:0;z-index:9998;" @onclick="CloseMenu"></div>
}

@code {
    private bool _menuOpen;
    private string _email = string.Empty;
    private string _initials = "?";
    private bool _isAuthenticated;
    private bool _isAnon;
    private bool _isMockMode;

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += HandleAuthStateChanged;
        await UpdateUserStateAsync(await AuthStateProvider.GetAuthenticationStateAsync());
        await LoadMockModeAsync();
    }

    private async void HandleAuthStateChanged(Task<AuthenticationState> stateTask)
    {
        await UpdateUserStateAsync(await stateTask);
        await InvokeAsync(StateHasChanged);
    }

    private Task UpdateUserStateAsync(AuthenticationState authState)
    {
        var user = authState.User;
        _isAuthenticated = user.Identity?.IsAuthenticated == true;

        if (_isAuthenticated)
        {
            _email = user.FindFirst("email")?.Value
                ?? user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                ?? user.Identity?.Name
                ?? "User";

            // §6 — Detect ANON session by email pattern (anonNNNNNN@potraffic.dev)
            _isAnon = _email.StartsWith("anon", StringComparison.OrdinalIgnoreCase)
                      && _email.EndsWith("@potraffic.dev", StringComparison.OrdinalIgnoreCase);

            _initials = _email[0].ToString().ToUpperInvariant();
            return Task.CompletedTask;
        }

        _menuOpen = false;
        _email = string.Empty;
        _initials = "?";
        _isAnon = false;
        return Task.CompletedTask;
    }

    /// <summary>
    /// Fetches feature flags from the server so the client can display the MOCK DATA banner
    /// when the server is running with mock providers active (§10).
    /// </summary>
    private async Task LoadMockModeAsync()
    {
        try
        {
            var flags = await Http.GetFromJsonAsync<SystemFlagsDto>("/api/system/features");
            _isMockMode = flags?.UseMockProviders == true;
        }
        catch
        {
            // Non-fatal — banner simply won't appear on network error
            _isMockMode = false;
        }
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    private async Task LogoutAsync()
    {
        _menuOpen = false;
        if (AuthStateProvider is JwtAuthenticationStateProvider jwtProvider)
            await jwtProvider.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= HandleAuthStateChanged;
    }

    // DTO for the /api/system/features response (local to this layout file)
    private sealed record SystemFlagsDto(bool UseMockProviders, bool TripleTestEnabled);
}

