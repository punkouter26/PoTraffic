@inherits LayoutComponentBase

@* Radzen service host components — must be present exactly once in the root layout *@
<RadzenNotification />
<RadzenDialog />
<RadzenTooltip />

<div class="page">
    <header class="app-header">
        <NavMenu />
    </header>

    <main>
        <article class="content">
            @Body
        </article>
    </main>

    <BottomNav />
</div>

@* Global overlay — one instance, above the page so it survives navigation.
   The command palette used to live here too. It was removed: a Ctrl+K launcher,
   a hotkey layer and a fuzzy matcher are a lot of machinery for an app with
   three destinations and a bottom nav, and everything it offered was reachable
   in one tap already. *@
<UndoBar />

@* Registers the service worker on first render, then offers the reload when a newer
   build is downloaded and waiting. In the layout so it happens once per session and
   the notice is not lost by navigating. *@
<PwaUpdateBar />

