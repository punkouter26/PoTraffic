@inherits LayoutComponentBase

@* Radzen service host components — must be present exactly once in the root layout *@
<RadzenNotification />
<RadzenDialog />
<RadzenTooltip />

<div class="page">
    <header class="app-header">
        <NavMenu />
    </header>

    <main>
        <article class="content">
            <InstallPrompt />
            @Body
        </article>
    </main>

    <BottomNav />
</div>

@* Global overlays — one instance each, above the page so they survive navigation. *@
<CommandPalette />
<UndoBar />

