@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using PoTraffic.Client.Infrastructure.Auth
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

@* Radzen service host components — must be present exactly once in the root layout *@
<RadzenNotification />
<RadzenDialog />
<RadzenTooltip />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @if (_isAuthenticated)
            {
                @* UX-10: User chip with dropdown replacing the version label *@
                <div class="pt-user-chip" @onclick:stopPropagation="true">
                    <button class="pt-user-chip-btn" @onclick="ToggleMenu" type="button">
                        <div class="pt-user-avatar">@_initials</div>
                        <span>@_email</span>
                        <span style="font-size:0.7rem; color:#94a3b8; margin-left:2px;">▾</span>
                    </button>
                    @if (_menuOpen)
                    {
                        <div class="pt-user-dropdown">
                            <div class="pt-user-dropdown-header">
                                <div style="font-size:0.72rem; color:#94a3b8; margin-bottom:2px;">Signed in as</div>
                                <div class="pt-user-dropdown-email">@_email</div>
                            </div>
                            <a class="pt-dropdown-item" href="/account/settings">
                                <span class="material-symbols-outlined" style="font-size:1rem;">settings</span>
                                Account Settings
                            </a>
                            <div class="pt-dropdown-divider"></div>
                            <button class="pt-dropdown-item danger" @onclick="LogoutAsync" type="button">
                                <span class="material-symbols-outlined" style="font-size:1rem;">logout</span>
                                Sign Out
                            </button>
                        </div>
                    }
                </div>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@* Close dropdown when clicking outside *@
@if (_menuOpen)
{
    <div style="position:fixed;inset:0;z-index:9998;" @onclick="CloseMenu"></div>
}

@code {
    private bool _menuOpen;
    private string _email = string.Empty;
    private string _initials = "?";
    private bool _isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += HandleAuthStateChanged;
        await UpdateUserStateAsync(await AuthStateProvider.GetAuthenticationStateAsync());
    }

    private async void HandleAuthStateChanged(Task<AuthenticationState> stateTask)
    {
        await UpdateUserStateAsync(await stateTask);
        await InvokeAsync(StateHasChanged);
    }

    private Task UpdateUserStateAsync(AuthenticationState authState)
    {
        var user = authState.User;
        _isAuthenticated = user.Identity?.IsAuthenticated == true;

        if (_isAuthenticated)
        {
            _email = user.FindFirst("email")?.Value
                ?? user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                ?? user.Identity?.Name
                ?? "User";
            _initials = _email[0].ToString().ToUpperInvariant();
            return Task.CompletedTask;
        }

        _menuOpen = false;
        _email = string.Empty;
        _initials = "?";
        return Task.CompletedTask;
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    private async Task LogoutAsync()
    {
        _menuOpen = false;
        if (AuthStateProvider is JwtAuthenticationStateProvider jwtProvider)
            await jwtProvider.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= HandleAuthStateChanged;
    }
}

