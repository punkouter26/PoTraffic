@using Microsoft.AspNetCore.Components.Authorization
@using PoTraffic.Client.Infrastructure.Auth
@using System.Net.Http.Json
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject NavigationManager Nav

<nav class="navbar navbar-dark app-navbar" role="navigation" aria-label="Main navigation">
    <a class="navbar-brand" href="dashboard">PoTraffic</a>

    @if (_useMockProviders)
    {
        <span class="pt-mock-data-badge" role="status">USING MOCK DATA</span>
    }

    <button class="navbar-toggler" @onclick="ToggleNavMenu" aria-expanded="@(!collapseNavMenu)" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="navbar-collapse @(collapseNavMenu ? "" : "show")">
        <div class="navbar-nav me-auto">
            @if (_isAuthenticated)
            {
                <NavLink class="nav-link" href="dashboard" Match="NavLinkMatch.All">Dashboard</NavLink>
                @if (_isAdmin)
                {
                    <NavLink class="nav-link" href="admin">Admin</NavLink>
                }
            }
            else
            {
                <NavLink class="nav-link" href="login" Match="NavLinkMatch.All">Sign In</NavLink>
            }
        </div>

        @if (_isAuthenticated)
        {
            <div class="pt-user-chip" @onclick:stopPropagation="true">
                <button class="pt-user-chip-btn" @onclick="ToggleUserMenu" type="button">
                    <div class="pt-user-avatar">@_initials</div>
                    <span>
                        @if (_isGuest)
                        {
                            <text>@_displayLabel LOGGED IN</text>
                        }
                        else
                        {
                            <text>@_email</text>
                        }
                    </span>
                    <span class="pt-user-caret">▾</span>
                </button>
                @if (_menuOpen)
                {
                    <div class="pt-user-dropdown" @onclick:stopPropagation="true">
                        <div class="pt-user-dropdown-header">
                            <div class="pt-user-dropdown-label">Signed in as</div>
                            <div class="pt-user-dropdown-email">@_displayLabel</div>
                        </div>
                        <a class="pt-dropdown-item" href="/account/settings">Account Settings</a>
                        <div class="pt-dropdown-divider"></div>
                        <button class="pt-dropdown-item danger" @onclick="LogoutAsync" type="button">Sign Out</button>
                    </div>
                }
            </div>
        }
    </div>
</nav>

@if (_menuOpen)
{
    <div class="pt-overlay" @onclick="CloseUserMenu"></div>
}

@code {
    private bool collapseNavMenu = true;
    private bool _menuOpen;
    private bool _isAuthenticated;
    private bool _isAdmin;
    private bool _isGuest;
    private string _email = string.Empty;
    private string _displayLabel = string.Empty;
    private string _initials = "?";
    private bool _useMockProviders;

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += HandleAuthStateChanged;
        await LoadFeatureFlagsAsync();
        await UpdateUserStateAsync(await AuthStateProvider.GetAuthenticationStateAsync());
    }

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
    private void ToggleUserMenu() => _menuOpen = !_menuOpen;
    private void CloseUserMenu() => _menuOpen = false;

    private async Task LoadFeatureFlagsAsync()
    {
        try
        {
            FeatureFlags? flags = await Http.GetFromJsonAsync<FeatureFlags>("/api/system/features");
            _useMockProviders = flags?.UseMockProviders == true;
        }
        catch
        {
            _useMockProviders = false;
        }
    }

    private async void HandleAuthStateChanged(Task<AuthenticationState> stateTask)
    {
        await UpdateUserStateAsync(await stateTask);
        await InvokeAsync(StateHasChanged);
    }

    private Task UpdateUserStateAsync(AuthenticationState authState)
    {
        var user = authState.User;
        _isAuthenticated = user.Identity?.IsAuthenticated == true;
        _isAdmin = _isAuthenticated &&
            (user.IsInRole("Administrator") ||
             user.Claims.Any(c => c.Type is "role" or System.Security.Claims.ClaimTypes.Role && c.Value == "Administrator"));
        _isGuest = _isAuthenticated && (
            user.IsInRole("Guest") ||
            user.Claims.Any(c => c.Type is "role" or System.Security.Claims.ClaimTypes.Role && c.Value == "Guest"));

        if (_isAuthenticated)
        {
            _email = user.FindFirst("email")?.Value
                ?? user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                ?? user.Identity?.Name
                ?? "User";

            // Rule 6: display "GUEST12345678 LOGGED IN" for guest sessions.
            if (_isGuest && _email.StartsWith("guest", StringComparison.OrdinalIgnoreCase) && _email.EndsWith("@potraffic.dev", StringComparison.OrdinalIgnoreCase))
            {
                // guest12345678@potraffic.dev → GUEST12345678
                string localPart = _email[..^"@potraffic.dev".Length];
                string digits = localPart["guest".Length..];
                _displayLabel = $"GUEST{digits}";
                _initials = "G";
            }
            else
            {
                _displayLabel = _email;
                _initials = _email[0].ToString().ToUpperInvariant();
            }
        }
        else
        {
            _menuOpen = false;
            _email = string.Empty;
            _displayLabel = string.Empty;
            _isGuest = false;
            _initials = "?";
        }
        return Task.CompletedTask;
    }

    private async Task LogoutAsync()
    {
        _menuOpen = false;
        if (AuthStateProvider is CookieAuthenticationStateProvider cookieProvider)
            await cookieProvider.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= HandleAuthStateChanged;
    }

    private sealed record FeatureFlags(bool TripleTestEnabled, bool UseMockProviders);
}
