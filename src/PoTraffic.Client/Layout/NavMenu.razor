@using Microsoft.AspNetCore.Components.Authorization
@using System.Net.Http.Json
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject NavigationManager Nav

<header class="app-shell">
    @* ── Left: Branding ─────────────────────────────────────────────────── *@
    <a class="app-shell-brand" href="dashboard">PoTraffic</a>

    @* ── Center: only "Sign In" when signed out. Signed in, the app has one destination
       and the brand already links to it; Admin lives in the menu, the one piece of
       chrome that survives every width, instead of being shown twice. *@
    <nav class="app-shell-actions" aria-label="Primary">
        @* Mock mode rides the bar as a chip. It was a full-width strip under the header that
           appeared only once /api/system/features answered — pushing every page down after
           first paint (CLS ~0.06 on phones) and costing two lines of a phone screen. *@
        @if (_useMockProviders)
        {
            <span class="pt-mock-banner" role="status"
                  title="API responses are deterministic; do not use for production routing.">
                <PtIcon Name="science" Size="sm" />Mock data
            </span>
        }
        @if (_authResolved && !_id.IsAuthenticated)
        {
            <NavLink class="app-nav-link" href="login" Match="NavLinkMatch.All">Sign In</NavLink>
        }
    </nav>

    @* ── Right: User chip / logout ──────────────────────────────────────── *@
    <div class="app-shell-user">
        @if (_id.IsAuthenticated)
        {
            <PoTraffic.Client.Features.Alerts.NotificationBell />
            <button class="pt-user-chip-btn" @onclick="ToggleUserMenu" type="button" aria-haspopup="menu" aria-expanded="@_menuOpen" title="@_id.Label">
                <span class="pt-user-avatar">@_id.Initials</span>
                @* Rule 6: guest sessions read "GUEST12345678 LOGGED IN". *@
                <span class="pt-user-chip-label">@(_id.IsGuest ? $"{_id.Label} LOGGED IN" : _id.Label)</span>
                <PtIcon Name="expand_more" Size="sm" Class="pt-user-caret" />
            </button>
            @if (_menuOpen)
            {
                <div class="pt-user-dropdown" @onclick:stopPropagation="true" role="menu">
                    <div class="pt-user-dropdown-header">
                        <div class="pt-user-dropdown-label">Signed in as</div>
                        <div class="pt-user-dropdown-email">@_id.Label</div>
                    </div>
                    @foreach (AccountMenu.Link link in AccountMenu.Links(_id.IsAdmin))
                    {
                        <a class="pt-dropdown-item" href="@link.Href" role="menuitem">
                            <PtIcon Name="@link.Icon" Size="sm" />@link.Label
                        </a>
                    }
                    <div class="pt-dropdown-divider" role="separator"></div>
                    <button class="pt-dropdown-item danger" @onclick="LogoutAsync" type="button" role="menuitem">
                        <PtIcon Name="logout" Size="sm" />Sign out
                    </button>
                </div>
            }
        }
    </div>
</header>

@if (_menuOpen)
{
    @* Catches the click that closes the menu. This is deliberately NOT the native
       popover light-dismiss: the dropdown is rendered by Blazor inside the header,
       which is its own stacking context, so hoisting it to the top layer would take
       it out of the flow its positioning depends on. See the z-index note in
       NavMenu.razor.css — this element must stay below the header. *@
    <div class="pt-overlay" @onclick="CloseUserMenu"></div>
}

@code {
    private bool _menuOpen;
    private bool _authResolved;   // false until the first auth state comes back — avoids a "Sign In" flash for logged-in users
    private AccountMenu.Identity _id = AccountMenu.Describe(new System.Security.Claims.ClaimsPrincipal());
    private bool _useMockProviders;

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += HandleAuthStateChanged;
        // Close the dropdown on every navigation — it survives Blazor's router
        // otherwise, sits there intercepting clicks on the new page, and the
        // overlay click-outside never fires because the click happens under it.
        Nav.LocationChanged += CloseMenuOnNavigate;
        await LoadFeatureFlagsAsync();
        UpdateUserState(await AuthStateProvider.GetAuthenticationStateAsync());
    }

    private void CloseMenuOnNavigate(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!_menuOpen)
            return;
        _menuOpen = false;
        // Nothing else re-renders this component on navigation (it takes no parameters).
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleUserMenu() => _menuOpen = !_menuOpen;
    private void CloseUserMenu() => _menuOpen = false;

    private async Task LoadFeatureFlagsAsync()
    {
        try
        {
            FeatureFlags? flags = await Http.GetFromJsonAsync("/api/system/features", AppJsonContext.Default.FeatureFlags);
            _useMockProviders = flags?.UseMockProviders == true;
        }
        catch
        {
            _useMockProviders = false;
        }
    }

    private async void HandleAuthStateChanged(Task<AuthenticationState> stateTask)
    {
        UpdateUserState(await stateTask);
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateUserState(AuthenticationState authState)
    {
        _authResolved = true;
        _id = AccountMenu.Describe(authState.User);
        if (!_id.IsAuthenticated)
            _menuOpen = false;
    }

    private async Task LogoutAsync()
    {
        _menuOpen = false;
        await AccountMenu.SignOutAsync(AuthStateProvider, Nav);
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= HandleAuthStateChanged;
        Nav.LocationChanged -= CloseMenuOnNavigate;
    }
}
