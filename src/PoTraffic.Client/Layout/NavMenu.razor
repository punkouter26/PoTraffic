@using Microsoft.AspNetCore.Components.Authorization
@using PoTraffic.Client.Infrastructure.Auth
@using System.Net.Http.Json
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject NavigationManager Nav

<header class="app-shell">
    @* ── Left: Branding ─────────────────────────────────────────────────── *@
    <a class="app-shell-brand" href="dashboard">PoTraffic</a>

    @* ── Center: Actions (auth-gated) ──────────────────────────────────── *@
    <nav class="app-shell-actions" aria-label="Primary">
        @if (_isAuthenticated)
        {
            <NavLink class="app-nav-link" href="dashboard" Match="NavLinkMatch.All">Dashboard</NavLink>
            @if (_isAdmin)
            {
                <NavLink class="app-nav-link" href="admin">Admin</NavLink>
            }
        }
        else if (_authResolved)
        {
            <NavLink class="app-nav-link" href="login" Match="NavLinkMatch.All">Sign In</NavLink>
        }
    </nav>

    @* ── Right: User chip / logout ──────────────────────────────────────── *@
    <div class="app-shell-user">
        @if (_isAuthenticated)
        {
            <PoTraffic.Client.Features.Alerts.NotificationBell />
            <button class="pt-user-chip-btn" @onclick="ToggleUserMenu" type="button" aria-haspopup="menu" aria-expanded="@_menuOpen" title="@_displayLabel">
                <span class="pt-user-avatar">@_initials</span>
                <span class="pt-user-chip-label">
                    @if (_isGuest)
                    {
                        <text>@_displayLabel LOGGED IN</text>
                    }
                    else
                    {
                        <text>@_displayLabel</text>
                    }
                </span>
                <span class="pt-user-caret" aria-hidden="true">▾</span>
            </button>
            @if (_menuOpen)
            {
                <div class="pt-user-dropdown" @onclick:stopPropagation="true" role="menu">
                    <div class="pt-user-dropdown-header">
                        <div class="pt-user-dropdown-label">Signed in as</div>
                        <div class="pt-user-dropdown-email">@_displayLabel</div>
                    </div>
                    <a class="pt-dropdown-item" href="/account/settings" role="menuitem">Account Settings</a>
                    <div class="pt-dropdown-divider" role="separator"></div>
                    <button class="pt-dropdown-item danger" @onclick="LogoutAsync" type="button" role="menuitem">Sign Out</button>
                </div>
            }
        }
    </div>
</header>

@* ── Top notice banner: only when the API is running in mock mode ─────── *@
@if (_useMockProviders)
{
    <div class="pt-mock-banner" role="status" aria-live="polite">
        USING MOCK DATA — API responses are deterministic; do not use for production routing.
    </div>
}

@if (_menuOpen)
{
    <div class="pt-overlay" @onclick="CloseUserMenu"></div>
}

@code {
    private bool _menuOpen;
    private bool _authResolved;   // false until the first auth state comes back — avoids a "Sign In" flash for logged-in users
    private bool _isAuthenticated;
    private bool _isAdmin;
    private bool _isGuest;
    private string _email = string.Empty;
    private string _displayLabel = string.Empty;
    private string _initials = "?";
    private bool _useMockProviders;

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += HandleAuthStateChanged;
        await LoadFeatureFlagsAsync();
        UpdateUserState(await AuthStateProvider.GetAuthenticationStateAsync());
    }

    private void ToggleUserMenu() => _menuOpen = !_menuOpen;
    private void CloseUserMenu() => _menuOpen = false;

    private async Task LoadFeatureFlagsAsync()
    {
        try
        {
            FeatureFlags? flags = await Http.GetFromJsonAsync("/api/system/features", AppJsonContext.Default.FeatureFlags);
            _useMockProviders = flags?.UseMockProviders == true;
        }
        catch
        {
            _useMockProviders = false;
        }
    }

    private async void HandleAuthStateChanged(Task<AuthenticationState> stateTask)
    {
        UpdateUserState(await stateTask);
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateUserState(AuthenticationState authState)
    {
        var user = authState.User;
        _authResolved = true;
        _isAuthenticated = user.Identity?.IsAuthenticated == true;
        _isAdmin = _isAuthenticated &&
            (user.IsInRole("Administrator") ||
             user.Claims.Any(c => c.Type is "role" or System.Security.Claims.ClaimTypes.Role && c.Value == "Administrator"));
        _isGuest = _isAuthenticated && (
            user.IsInRole("Guest") ||
            user.Claims.Any(c => c.Type is "role" or System.Security.Claims.ClaimTypes.Role && c.Value == "Guest"));

        if (_isAuthenticated)
        {
            _email = user.FindFirst("email")?.Value
                ?? user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                ?? user.Identity?.Name
                ?? "User";

            // Rule 6: display "GUEST12345678 LOGGED IN" for guest sessions. The address shape
            // is owned by GuestAccountConstants, not restated here.
            if (_isGuest && GuestAccountConstants.IsGuestEmail(_email))
            {
                _displayLabel = GuestAccountConstants.ToDisplayLabel(_email);
                _initials = "G";
            }
            else
            {
                _displayLabel = _email;
                _initials = _email[0].ToString().ToUpperInvariant();
            }
        }
        else
        {
            _menuOpen = false;
            _email = string.Empty;
            _displayLabel = string.Empty;
            _isGuest = false;
            _initials = "?";
        }
    }

    private async Task LogoutAsync()
    {
        _menuOpen = false;
        if (AuthStateProvider is CookieAuthenticationStateProvider cookieProvider)
            await cookieProvider.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= HandleAuthStateChanged;
    }

}
