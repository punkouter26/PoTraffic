@using Microsoft.AspNetCore.Components.Authorization
@using PoTraffic.Client.Infrastructure.Auth
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider

@* Bottom navigation — only visible on mobile portrait (≤640px). Provides
   thumb-reach to the three most common destinations so the user doesn't
   have to scroll back to the top nav. The desktop top nav still owns
   branding + user chip per the L/C/R spatial contract.

   Previously: three hard-coded destinations (Commutes / Add / Account), and
   the catch-all destinations (settings, Sign out) lived behind a hidden
   avatar menu on mobile — a long thumb-reach to the top-right corner and a
   tap-target change to dismiss it. They live in an action sheet now,
   reachable from the rightmost "Account" pill on the bar, which mirrors the
   desktop user-menu's options (plus Sign out) so the two surfaces agree on
   what "Account" means. Two taps instead of one for the common paths, three
   for the rare ones, never any thumb-reach.

   NavLink rather than <a> for the active destinations: the bar had no active
   state at all, so the primary navigation on a phone never showed you where
   you were. *@
<nav class="pt-bottom-nav" aria-label="Quick actions">
    <NavLink class="pt-bottom-nav-link" href="dashboard" Match="NavLinkMatch.All">
        <PtIcon Name="dashboard" Class="pt-bottom-nav-icon" />
        <span class="pt-bottom-nav-label">Commutes</span>
    </NavLink>
    <a class="pt-bottom-nav-link pt-bottom-nav-fab" href="routes/create" aria-label="Add route">
        <span class="pt-bottom-nav-fab-inner">
            <PtIcon Name="add" />
        </span>
    </a>
    <button class="pt-bottom-nav-link" type="button" aria-haspopup="menu"
            aria-expanded="@_sheetOpen" aria-label="Account menu"
            @onclick="ToggleSheet" @onclick:stopPropagation="true">
        <PtIcon Name="account_circle" Class="pt-bottom-nav-icon" />
        <span class="pt-bottom-nav-label">@(_id.IsAuthenticated ? "Account" : "Menu")</span>
    </button>
</nav>

@if (_sheetOpen && _id.IsAuthenticated)
{
    @* Same items as the desktop dropdown — both read AccountMenu. *@
    <div class="pt-bottom-sheet" role="menu" aria-label="Account menu">
        @* Presentational: a screen reader walking the menu should hear items, not a heading. *@
        <div class="pt-bottom-sheet-header" role="presentation">
            <div class="pt-bottom-sheet-label">Signed in as</div>
            <div class="pt-bottom-sheet-email">@_id.Label</div>
        </div>
        @foreach (AccountMenu.Link link in AccountMenu.Links(_id.IsAdmin))
        {
            <a class="pt-bottom-sheet-item" href="@link.Href" role="menuitem" @onclick="CloseSheet">
                <PtIcon Name="@link.Icon" Size="sm" />@link.Label
            </a>
        }
        <div class="pt-bottom-sheet-divider" role="separator"></div>
        <button type="button" class="pt-bottom-sheet-item pt-bottom-sheet-danger" role="menuitem" @onclick="LogoutAsync">
            <PtIcon Name="logout" Size="sm" />Sign out
        </button>
    </div>
}
else if (_sheetOpen)
{
    <div class="pt-bottom-sheet" role="menu" aria-label="Menu">
        <a class="pt-bottom-sheet-item" href="/login" role="menuitem" @onclick="CloseSheet">
            <PtIcon Name="login" Size="sm" />Sign in
        </a>
    </div>
}

@if (_sheetOpen)
{
    <div class="pt-overlay" @onclick="CloseSheet" aria-hidden="true"></div>
}

@code {
    private bool _sheetOpen;
    private AccountMenu.Identity _id = AccountMenu.Describe(new System.Security.Claims.ClaimsPrincipal());

    protected override async Task OnInitializedAsync()
    {
        // The same auth state may surface through the auth provider's interface
        // AND through its concrete CookieAuthenticationStateProvider event, so
        // we subscribe to both — a duplicate just re-describes the same user.
        AuthStateProvider.AuthenticationStateChanged += OnAuthChanged;
        if (AuthStateProvider is CookieAuthenticationStateProvider cookie)
            cookie.AuthenticationStateChanged += OnAuthChanged;

        _id = AccountMenu.Describe((await AuthStateProvider.GetAuthenticationStateAsync()).User);
    }

    private void OnAuthChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            _id = AccountMenu.Describe((await task).User);
            _sheetOpen = false;
            StateHasChanged();
        });
    }

    private void ToggleSheet() => _sheetOpen = !_sheetOpen;
    private void CloseSheet() => _sheetOpen = false;

    private async Task LogoutAsync()
    {
        _sheetOpen = false;
        await AccountMenu.SignOutAsync(AuthStateProvider, Nav);
    }

    [Inject] private NavigationManager Nav { get; set; } = default!;

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthChanged;
        if (AuthStateProvider is CookieAuthenticationStateProvider cookie)
            cookie.AuthenticationStateChanged -= OnAuthChanged;
    }
}
