@page "/dashboard"
@using PoTraffic.Shared.DTOs.Routes
@using PoTraffic.Shared.DTOs.History
@using PoTraffic.Shared.DTOs.Account
@using PoTraffic.Shared.Enums
@using PoTraffic.Client.Features.Routes
@inherits PollingComponentBase
@inject HttpClient Http
@inject NavigationManager Nav

@using PoTraffic.Shared.Constants

<PageTitle>Dashboard — PoTraffic</PageTitle>

@* C2: Compact status bar replaces 4 KPI cards *@
<div class="pt-status-bar">
    @{
        int activeCount = _routes.Count(r => r.MonitoringStatus == MonitoringStatus.Active);
        string dotClass = activeCount > 0 ? "pt-status-dot-green" : "pt-status-dot-amber";
    }
    <span class="pt-status-item">
        <span class="pt-status-dot @dotClass"></span>
        @activeCount of @_routes.Count routes active
    </span>
    <span class="pt-status-sep">·</span>
    <span class="pt-status-item">
        @_quotaConsumed / @QuotaConstants.DefaultDailyQuota quota used today
    </span>
    <span class="pt-status-sep">·</span>
    <span class="pt-status-item" style="color:#94a3b8;">Resets midnight UTC</span>
    <div class="pt-status-bar-actions">
        <RadzenButton Text="+ Add Route" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                      Click="@(() => Nav.NavigateTo("/routes/create"))" />
    </div>
</div>

@if (_quotaConsumed >= QuotaConstants.DefaultDailyQuota - 2)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" class="rz-mb-3">
        Daily quota almost reached. Monitoring will pause once the limit is hit.
    </RadzenAlert>
}

@if (_loading)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else if (_routes.Count == 0)
{
    <div style="text-align:center; padding:3rem 1rem;">
        <div style="font-size:3rem; margin-bottom:1rem;">🛣️</div>
        <div style="font-size:1.2rem; font-weight:600; color:#334155; margin-bottom:0.5rem;">No routes yet</div>
        <div style="color:#94a3b8; margin-bottom:1.5rem;">Add your first commute route to start monitoring traffic patterns.</div>
        <RadzenButton Text="Add Your First Route" ButtonStyle="ButtonStyle.Primary" Icon="add"
                      Click="@(() => Nav.NavigateTo("/routes/create"))" />
    </div>
}
else
{
    @* C1/UI-1: Route cards replace the grid — one card per route *@
    <div class="pt-route-cards">
        @foreach (RouteDto route in _routes)
        {
            <RouteCard Route="route"
                       OptimalDeparture="@(_optimalDepartures.GetValueOrDefault(route.Id))"
                       OnDeleted="@LoadDataAsync"
                       OnRefresh="@LoadDataAsync" />
        }
    </div>
}

@code {
    private List<RouteDto> _routes = [];
    private Dictionary<Guid, OptimalDepartureDto> _optimalDepartures = [];
    private int _quotaConsumed;
    private bool _loading = true;

    protected override TimeSpan PollingInterval => TimeSpan.FromSeconds(60);

    protected override async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            string dayOfWeek = DateTime.Today.DayOfWeek.ToString();

            var result = await Http.GetFromJsonAsync<PagedResult<RouteDto>>("/api/routes?page=1&pageSize=100");
            if (result is not null)
                _routes = [.. result.Items];

            var quota = await Http.GetFromJsonAsync<QuotaDto>("/api/account/quota");
            if (quota is not null)
                _quotaConsumed = quota.UsedToday;

            // UI-2: Load optimal departure for each route (2-3 calls for typical user)
            _optimalDepartures = [];
            foreach (RouteDto route in _routes)
            {
                try
                {
                    var optimal = await Http.GetFromJsonAsync<OptimalDepartureDto>(
                        $"/api/routes/{route.Id}/optimal-departure?dayOfWeek={dayOfWeek}");
                    if (optimal is not null)
                        _optimalDepartures[route.Id] = optimal;
                }
                catch
                {
                    // Individual route failure doesn't break the dashboard
                }
            }
        }
        catch
        {
            // Silently handled — data shown may be partial
        }
        finally
        {
            _loading = false;
        }
    }
}
