@page "/dashboard"
@using PoTraffic.Shared.DTOs.Routes
@using PoTraffic.Shared.DTOs.History
@using PoTraffic.Shared.DTOs.Account
@using PoTraffic.Shared.Enums
@using PoTraffic.Client.Features.Routes
@inherits PollingComponentBase
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Nav
@inject ClientCache Cache
@inject PendingDeletionService Pending

@using PoTraffic.Shared.Constants

<PageTitle>Dashboard — PoTraffic</PageTitle>

<MeshBackground />

@* The page now leads with a heading like every other route. It carries the
   Add Route action, which used to hang off the right of the status bar — a
   primary action parked inside a connectivity indicator that hides itself
   whenever there is nothing to report. *@
<PageHeader Title="Your commutes"
            Subtitle="@_subtitle">
    <Actions>
        @if (ShowSkeletons || VisibleRoutes.Count > 0)
        {
            <RadzenButton Text="Add route" Icon="add" ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Small"
                          Click="@(() => Nav.NavigateTo("/routes/create"))" />
        }
    </Actions>
</PageHeader>

@* The bar used to report five things: active-route count, connectivity, a quota
   ring, today's provider spend and the reset time. Four of those are operator
   telemetry — they say nothing about when to leave — and they now live in
   Settings, where someone looking for them will look. What remains is the one
   fact that changes how much to trust the numbers below: whether they're live.

   It renders only when the news is bad. A permanent green "Live" chip on a
   healthy app is a row of pixels that never changes and therefore never gets
   read; the heading's subtitle carries that state instead. *@
@if (IsOffline || IsStale)
{
    <div class="pt-status-bar" role="status">
        <span class="pt-status-item pt-status-offline">
            <PtIcon Name="@(IsOffline ? "wifi_off" : "cloud_off")" Size="sm" />
            @(IsOffline ? "Offline — showing the last data received"
                        : "Can't reach the server — retrying")
        </span>
    </div>
}

@if (_quotaConsumed >= QuotaConstants.DefaultDailyQuota - 2)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" class="pt-mb-3 pt-enter">
        Daily monitoring limit almost reached — sampling will pause once it's hit.
    </RadzenAlert>
}

@if (ShowSkeletons)
{
    @* TASK #9: Skeleton placeholders avoid layout flash while routes load.
       Shown only when there is genuinely nothing to draw — a cached snapshot
       or a background refresh must never blank a populated dashboard. *@
    <div class="pt-skeleton-stack" aria-busy="true" aria-label="Loading routes">
        @for (int i = 0; i < 3; i++)
        {
            <div class="pt-skeleton-card">
                <div class="pt-skeleton-line lg w-50"></div>
                <div class="pt-skeleton-line w-70"></div>
                <div class="pt-skeleton-line w-30"></div>
            </div>
        }
    </div>
}
else if (VisibleRoutes.Count == 0 && !_hydrated)
{
    @* Nothing loaded and nothing cached — this is a failure, not an empty account.
       Showing "No routes yet" here would tell a user their routes had vanished. *@
    <div class="pt-empty-state">
        <PtIcon Name="cloud_off" Size="xl" Class="pt-empty-state-icon" />
        <div class="pt-empty-state-title">Couldn't load your routes</div>
        <div class="pt-empty-state-text">
            @(IsOffline ? "You're offline. We'll refresh as soon as you're back."
                        : "The server didn't respond. Retrying automatically.")
        </div>
        <RadzenButton Text="Retry now" ButtonStyle="ButtonStyle.Light" Icon="refresh"
                      Click="@RefreshAsync" />
    </div>
}
else if (VisibleRoutes.Count == 0)
{
    <div class="pt-empty-state">
        <PtIcon Name="route" Size="xl" Class="pt-empty-state-icon" />
        <div class="pt-empty-state-title">No routes yet</div>
        <div class="pt-empty-state-text">Add your first commute route to start monitoring traffic patterns.</div>
        <RadzenButton Text="Add Your First Route" ButtonStyle="ButtonStyle.Primary" Icon="add"
                      Click="@(() => Nav.NavigateTo("/routes/create"))" />

        @* #10: a real route takes days of monitoring before it has anything to say. The
           sample route fills that gap with data that is clearly labelled as invented. *@
        <div class="pt-empty-state-alt">
            <RadzenButton Text="Or explore a sample route" ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small" Icon="science"
                          Click="@LoadDemoRouteAsync" IsBusy="_loadingDemo" />
            <div class="pt-empty-state-note">
                Two weeks of made-up commute data, so you can see the charts before your own fill in.
            </div>
        </div>
    </div>
}
else
{
    @* One card per route, and the card is the answer.

       This was a <Virtualize>, which is incompatible with the two-column grid
       the container now becomes on a wide screen: Virtualize works by rendering
       spacer <div>s above and below the visible window, and in a grid those
       spacers are grid ITEMS — they would each claim a cell and shred the
       layout. Rendering the list outright is fine here because the dashboard
       fetches at most 100 routes (pageSize=100) and a card is a handful of
       spans; the ItemSize="120" hint it relied on had already drifted from the
       card's real height twice. *@
    <div class="pt-route-cards pt-stagger" role="list">
        @foreach (RouteDto route in VisibleRoutes)
        {
            <div role="listitem" @key="route.Id">
                <SwipeableRouteCard Route="route"
                           OptimalDeparture="@(_optimalDepartures.GetValueOrDefault(route.Id))"
                           RecentPolls="@(_recentPolls.GetValueOrDefault(route.Id, []))"
                           OnDeleted="@RefreshAsync"
                           OnRefresh="@RefreshAsync" />
            </div>
        }
    </div>
}

@code {
    /// <summary>How stale a cached snapshot may be and still be worth painting on mount.</summary>
    private static readonly TimeSpan CacheMaxAge = TimeSpan.FromHours(12);

    private List<RouteDto> _routes = [];
    private Dictionary<RouteId, OptimalDepartureDto> _optimalDepartures = [];
    private Dictionary<RouteId, List<PollRecordDto>> _recentPolls = [];
    private int _quotaConsumed;
    private int _pollsToday;
    private decimal _estimatedCostToday;
    private decimal _projectedMonthlyCost;
    private bool _hydrated;
    private bool _loadingDemo;

    protected override TimeSpan PollingInterval => TimeSpan.FromSeconds(60);

    /// <summary>
    /// Routes with a pending delete are hidden immediately, so the swipe feels instant
    /// while the request itself is still parked behind the undo window (#3). Cached
    /// rather than derived per read — the markup reads it several times per render.
    /// </summary>
    private List<RouteDto> VisibleRoutes { get; set; } = [];

    /// <summary>
    /// The header's supporting line. Carries the connectivity state that the permanent
    /// green "Live" chip used to occupy a whole bar to report — a healthy app says so
    /// once, quietly, next to the title.
    /// </summary>
    private string? _subtitle;

    private void RecomputeVisible()
    {
        VisibleRoutes = [.. _routes.Where(r => !Pending.IsPending(r.Id))];

        // Null, not empty — PageHeader renders the subtitle element only when there
        // is one, and an empty <p> still occupies a line.
        int active = VisibleRoutes.Count(r => r.MonitoringStatus == MonitoringStatus.Active);
        _subtitle = VisibleRoutes.Count == 0
            ? null
            : $"{active} of {VisibleRoutes.Count} monitoring · updated {DateTime.Now:HH:mm}";
    }

    /// <summary>
    /// Skeletons only when there is genuinely nothing to show. A cached snapshot or a
    /// background refresh must never blank a dashboard the user is already reading.
    /// </summary>
    private bool ShowSkeletons => IsFirstLoad && !_hydrated;

    protected override void OnInitialized() => Pending.Changed += OnPendingChanged;

    private void OnPendingChanged()
    {
        RecomputeVisible();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Seeds the sample route (#10) and lands the user on it. The endpoint is idempotent,
    /// so a double-click produces one route, not two.
    /// </summary>
    private async Task LoadDemoRouteAsync()
    {
        _loadingDemo = true;
        try
        {
            HttpResponseMessage response = await Http.PostAsync("/api/routes/demo", null);
            if (!response.IsSuccessStatusCode)
                return;

            RouteDto? demo = await response.Content.ReadFromJsonAsync(AppJsonContext.Default.RouteDto);
            await RefreshAsync();

            if (demo is not null)
                Nav.NavigateTo($"/routes/{demo.Id}");
        }
        catch
        {
            // Transient — the empty state stays up and the button can be pressed again.
        }
        finally
        {
            _loadingDemo = false;
        }
    }

    protected override async Task LoadDataAsync()
    {
        // First paint comes from the last snapshot, if there is one — real routes on
        // screen before the network has answered (#5).
        if (IsFirstLoad)
            await HydrateFromCacheAsync();

        string dayOfWeek = DateTime.Today.DayOfWeek.ToString();

        // The route list and the quota card are independent — one round-trip, not two.
        Task<PagedResult<RouteDto>?> routesTask =
            Http.GetFromJsonAsync("/api/routes?page=1&pageSize=100", AppJsonContext.Default.PagedResultRouteDto);
        Task<QuotaDto?> quotaTask =
            Http.GetFromJsonAsync("/api/account/quota", AppJsonContext.Default.QuotaDto);

        PagedResult<RouteDto>? result = await routesTask;
        if (result is not null)
            _routes = [.. result.Items];

        QuotaDto? quota = await quotaTask;
        if (quota is not null)
        {
            _quotaConsumed = quota.UsedToday;
            _pollsToday = quota.PollsToday;
            _estimatedCostToday = quota.EstimatedCostTodayUsd;
            _projectedMonthlyCost = quota.ProjectedMonthlyCostUsd;
        }

        // UI-2/UI-12: Load optimal departure + 24h trend for each route. Every route's
        // pair is independent of every other's, so they all go out at once — awaiting
        // them in a loop made the refresh cost the SUM of 2×N latencies every 60s.
        // Per-route failures stay non-fatal.
        Dictionary<RouteId, OptimalDepartureDto> departures = [];
        Dictionary<RouteId, List<PollRecordDto>> polls = [];
        string sinceUtc = Uri.EscapeDataString(DateTime.UtcNow.AddHours(-24).ToString("o"));

        await Task.WhenAll(_routes.Select(async route =>
        {
            try
            {
                Task<OptimalDepartureDto?> optimalTask = Http.GetFromJsonAsync(
                    $"/api/routes/{route.Id}/optimal-departure?dayOfWeek={dayOfWeek}", AppJsonContext.Default.OptimalDepartureDto);
                Task<PagedResult<PollRecordDto>?> historyTask = Http.GetFromJsonAsync(
                    $"/api/routes/{route.Id}/poll-history?page=1&pageSize=60&sinceUtc={sinceUtc}", AppJsonContext.Default.PagedResultPollRecordDto);

                OptimalDepartureDto? optimal = await optimalTask;
                if (optimal is not null)
                    departures[route.Id] = optimal;

                PagedResult<PollRecordDto>? history = await historyTask;
                if (history is not null && history.Items.Count > 0)
                    polls[route.Id] = [.. history.Items];
            }
            catch
            {
                // Individual route failure doesn't break the dashboard
            }
        }));

        // Swapped in wholesale rather than cleared up front: clearing first would blank
        // every card for the duration of the fan-out.
        _optimalDepartures = departures;
        _recentPolls = polls;
        _hydrated = true;
        RecomputeVisible();

        await PersistSnapshotAsync(quota);
    }

    /// <summary>Paints the last stored snapshot. A miss simply leaves the skeletons up.</summary>
    private async Task HydrateFromCacheAsync()
    {
        DashboardSnapshot? snapshot = await Cache.GetAsync(
            ClientCacheKeys.Dashboard, AppJsonContext.Default.DashboardSnapshot, CacheMaxAge);

        if (snapshot is null || snapshot.Routes.Count == 0)
            return;

        _routes = snapshot.Routes;
        _optimalDepartures = snapshot.Insights
            .Where(i => i.OptimalDeparture is not null)
            .ToDictionary(i => i.RouteId, i => i.OptimalDeparture!);
        _recentPolls = snapshot.Insights
            .Where(i => i.RecentPolls.Count > 0)
            .ToDictionary(i => i.RouteId, i => i.RecentPolls);

        if (snapshot.Quota is { } quota)
        {
            _quotaConsumed = quota.UsedToday;
            _pollsToday = quota.PollsToday;
            _estimatedCostToday = quota.EstimatedCostTodayUsd;
            _projectedMonthlyCost = quota.ProjectedMonthlyCostUsd;
        }

        _hydrated = true;
        RecomputeVisible();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Stores the fresh payload for the next cold start and for the command palette.</summary>
    private async Task PersistSnapshotAsync(QuotaDto? quota)
    {
        List<RouteInsight> insights = [.. _routes.Select(r => new RouteInsight(
            r.Id,
            _optimalDepartures.GetValueOrDefault(r.Id),
            _recentPolls.GetValueOrDefault(r.Id, [])))];

        await Cache.SetAsync(
            ClientCacheKeys.Dashboard,
            new DashboardSnapshot(_routes, quota, insights),
            AppJsonContext.Default.DashboardSnapshot);
    }

    public void Dispose() => Pending.Changed -= OnPendingChanged;
}
