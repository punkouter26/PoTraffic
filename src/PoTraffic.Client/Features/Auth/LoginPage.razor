@page "/login"
@attribute [AllowAnonymous]
@layout AuthLayout
@using System.Net.Http.Json
@using PoTraffic.Client.Layout
@using PoTraffic.Client.Infrastructure.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<RadzenCard class="rz-p-6">
    <RadzenText TextStyle="TextStyle.H5" class="rz-mb-2">Sign In</RadzenText>
    <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-4 pt-fg-tertiary">
        @(_guestEnabled
            ? "Sign in with your Microsoft account, or continue as a guest (local development)."
            : "Sign in with your Microsoft account to continue.")
    </RadzenText>

    @if (!string.IsNullOrEmpty(_error))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" class="rz-mb-3">@_error</RadzenAlert>
    }

    @if (_providersLoaded && !_microsoftConfigured && !_guestEnabled)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false" class="rz-mb-3">
            Microsoft sign-in is not configured on this server.
        </RadzenAlert>
    }

    @if (!_providersLoaded || _microsoftConfigured || !_guestEnabled)
    {
        <RadzenButton Text="Continue with Microsoft" ButtonStyle="ButtonStyle.Primary"
                      class="rz-w-100 auth-social-btn"
                      Click='() => StartExternalLogin("microsoft")'
                      Disabled="@(_loading || (_providersLoaded && !_microsoftConfigured))" />
    }

    @* Rule 4.4 — Dev split view / Testing bypass: guest login skips OAuth entirely. *@
    @if (_guestEnabled)
    {
        <RadzenButton Text="Continue as Guest" ButtonStyle="ButtonStyle.Secondary"
                      class="rz-w-100 rz-mt-3 auth-social-btn"
                      Click="@GuestLoginAsync"
                      IsBusy="@_guestLoading"
                      Disabled="@_loading" />
        <RadzenText TextStyle="TextStyle.Caption" class="rz-mt-2 pt-fg-tertiary">
            Guest sessions are for local development and testing only.
        </RadzenText>
    }

</RadzenCard>

@code {
    private string _error = "";
    private bool _loading;
    private bool _guestLoading;
    private bool _providersLoaded;
    private bool _guestEnabled;
    private List<string> _availableProviders = [];
    private bool _microsoftConfigured => _availableProviders.Contains("microsoft");

    protected override async Task OnInitializedAsync()
    {
        // The BFF OAuth callback redirects here with ?error=CODE on failure.
        string query = new Uri(Nav.Uri).Query;
        if (!string.IsNullOrEmpty(query))
        {
            var parsed = System.Web.HttpUtility.ParseQueryString(query);
            if (!string.IsNullOrWhiteSpace(parsed["error"]))
                _error = "Microsoft sign-in failed. Please try again.";
        }

        try
        {
            var result = await Http.GetFromJsonAsync("/api/auth/providers", AppJsonContext.Default.ProvidersResponse);
            if (result is not null)
            {
                _availableProviders = result.Providers;
                _guestEnabled = result.GuestEnabled;
            }
        }
        catch
        {
            // Non-fatal — the Microsoft button stays enabled and falls back to a server-side error.
        }
        finally
        {
            _providersLoaded = true;
        }
    }

    private void StartExternalLogin(string provider)
    {
        _loading = true;
        string encodedReturnUrl = Uri.EscapeDataString("/dashboard");
        Nav.NavigateTo($"/api/auth/external/{provider}/start?returnUrl={encodedReturnUrl}", forceLoad: true);
    }

    private async Task GuestLoginAsync()
    {
        _guestLoading = true;
        _error = "";
        try
        {
            HttpResponseMessage resp = await Http.PostAsync("/api/auth/guest-login", content: null);
            if (resp.IsSuccessStatusCode)
            {
                if (AuthStateProvider is CookieAuthenticationStateProvider cookieProvider)
                    cookieProvider.Refresh();
                Nav.NavigateTo("/dashboard");
            }
            else
            {
                _error = "Guest sign-in failed. Please try again.";
            }
        }
        catch
        {
            _error = "Unable to connect. Please try again.";
        }
        finally
        {
            _guestLoading = false;
        }
    }
}
