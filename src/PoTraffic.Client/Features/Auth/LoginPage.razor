@page "/login"
@layout AuthLayout
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using PoTraffic.Client.Infrastructure.Auth
@using PoTraffic.Client.Layout
@using PoTraffic.Shared.DTOs.Auth
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@inject HttpClient Http
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebAssemblyHostEnvironment HostEnvironment

<RadzenCard class="rz-p-6">
    <RadzenText TextStyle="TextStyle.H5" class="rz-mb-2">Sign In</RadzenText>
    <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-4" style="color:var(--rz-text-tertiary-color)">
        Sign in with your Microsoft account to continue.
    </RadzenText>

    @if (!string.IsNullOrEmpty(_error))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" class="rz-mb-3">@_error</RadzenAlert>
    }

    @if (_providersLoaded && !_microsoftConfigured)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false" class="rz-mb-3">
            Microsoft sign-in is not configured on this server.
        </RadzenAlert>
    }

    <RadzenButton Text="🪟  Continue with Microsoft" ButtonStyle="ButtonStyle.Primary"
                  class="rz-w-100 auth-social-btn"
                  Click='() => StartExternalLogin("microsoft")'
                  Disabled="@(_loading || (_providersLoaded && !_microsoftConfigured))" />

    @if (HostEnvironment.IsDevelopment())
    {
        <RadzenButton Text="🔓  GUEST (Dev Only)" ButtonStyle="ButtonStyle.Warning" class="rz-w-100 rz-mt-2"
                      Click="@GuestLoginAsync" IsBusy="_loading" />
        <RadzenButton Text="🔑  Dev Admin (Dev Only)" ButtonStyle="ButtonStyle.Secondary" class="rz-w-100 rz-mt-2"
                      Click="@DevAdminLoginAsync" IsBusy="_loading" />
    }
</RadzenCard>

@code {
    private string _error = "";
    private bool _loading;
    private bool _providersLoaded;
    private List<string> _availableProviders = [];
    private bool _microsoftConfigured => _availableProviders.Contains("microsoft");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<ProvidersResponse>("/api/auth/providers");
            if (result is not null)
                _availableProviders = result.Providers;
        }
        catch
        {
            // Non-fatal — the Microsoft button stays enabled and falls back to a server-side error.
        }
        finally
        {
            _providersLoaded = true;
        }
    }

    private void StartExternalLogin(string provider)
    {
        _loading = true;
        string encodedReturnUrl = Uri.EscapeDataString("/dashboard");
        Nav.NavigateTo($"/api/auth/external/{provider}/start?returnUrl={encodedReturnUrl}", forceLoad: true);
    }

    private async Task GuestLoginAsync()
    {
        _error = "";
        _loading = true;

        try
        {
            HttpResponseMessage response = await Http.PostAsJsonAsync("/api/auth/guest-login", new { });

            if (response.IsSuccessStatusCode)
            {
                AuthResponse? auth = await response.Content.ReadFromJsonAsync<AuthResponse>();
                if (auth is not null)
                {
                    if (AuthStateProvider is JwtAuthenticationStateProvider jwtProvider)
                    {
                        await jwtProvider.LoginAsync(auth.AccessToken);
                    }
                    Nav.NavigateTo("/dashboard");
                }
            }
            else
            {
                _error = "GUEST login failed. Check server logs.";
            }
        }
        catch
        {
            _error = "Unable to connect. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DevAdminLoginAsync()
    {
        _error = "";
        _loading = true;

        try
        {
            HttpResponseMessage response = await Http.PostAsJsonAsync("/api/auth/dev-admin-login", new { });

            if (response.IsSuccessStatusCode)
            {
                AuthResponse? auth = await response.Content.ReadFromJsonAsync<AuthResponse>();
                if (auth is not null)
                {
                    if (AuthStateProvider is JwtAuthenticationStateProvider jwtProvider)
                    {
                        await jwtProvider.LoginAsync(auth.AccessToken);
                    }
                    Nav.NavigateTo("/dashboard");
                }
            }
            else
            {
                _error = "Dev admin login failed. Check server logs.";
            }
        }
        catch
        {
            _error = "Unable to connect. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed record ProvidersResponse(List<string> Providers);
}
