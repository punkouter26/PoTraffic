@page "/login"
@layout AuthLayout
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using PoTraffic.Client.Infrastructure.Auth
@using PoTraffic.Client.Layout
@using PoTraffic.Shared.DTOs.Auth
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@inject HttpClient Http
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebAssemblyHostEnvironment HostEnvironment

<RadzenCard class="rz-p-6">
    <RadzenText TextStyle="TextStyle.H5" class="rz-mb-4">Sign In</RadzenText>

    @if (!string.IsNullOrEmpty(_error))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" class="rz-mb-3">@_error</RadzenAlert>
    }

    <RadzenFormField Text="Email" class="rz-w-100 rz-mb-3">
        <RadzenTextBox @bind-Value="_email" InputAttributes="@(new Dictionary<string,object>{{"type","email"}})" />
    </RadzenFormField>

    <RadzenFormField Text="Password" class="rz-w-100 rz-mb-4">
        <RadzenPassword @bind-Value="_password" />
    </RadzenFormField>

    <RadzenButton Text="Sign In" ButtonStyle="ButtonStyle.Primary" class="rz-w-100"
                  Click="@LoginAsync" IsBusy="_loading" />

    @if (HostEnvironment.IsDevelopment())
    {
        <RadzenButton Text="🔓  ANON (Dev Only)" ButtonStyle="ButtonStyle.Warning" class="rz-w-100 rz-mt-2"
                      Click="@AnonLoginAsync" IsBusy="_loading" />
    }

    @if (_availableProviders.Contains("google"))
    {
        <RadzenButton Text="🔵  Continue with Google" ButtonStyle="ButtonStyle.Light" class="rz-w-100 rz-mt-2 auth-social-btn"
                      Click='() => StartExternalLogin("google")' Disabled="_loading" />
    }

    @if (_availableProviders.Contains("microsoft"))
    {
        <RadzenButton Text="🪟  Continue with Microsoft" ButtonStyle="ButtonStyle.Light" class="rz-w-100 rz-mt-2 auth-social-btn"
                      Click='() => StartExternalLogin("microsoft")' Disabled="_loading" />
    }

    <RadzenText class="rz-mt-3">
        No account? <a href="/register">Register</a>
    </RadzenText>
</RadzenCard>

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _error = "";
    private bool _loading;
    private List<string> _availableProviders = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<ProvidersResponse>("/api/auth/providers");
            if (result is not null)
                _availableProviders = result.Providers;
        }
        catch
        {
            // Non-fatal — social login buttons simply won't appear
        }
    }

    private async Task LoginAsync()
    {
        _error = "";
        _loading = true;

        try
        {
            HttpResponseMessage response = await Http.PostAsJsonAsync(
                "/api/auth/login",
                new LoginRequest(_email, _password));

            if (response.IsSuccessStatusCode)
            {
                AuthResponse? auth = await response.Content.ReadFromJsonAsync<AuthResponse>();
                if (auth is not null)
                {
                    // Store JWT via the auth state provider and navigate to dashboard
                    if (AuthStateProvider is JwtAuthenticationStateProvider jwtProvider)
                    {
                        await jwtProvider.LoginAsync(auth.AccessToken);
                    }
                    Nav.NavigateTo("/dashboard");
                }
            }
            else
            {
                _error = "Invalid email or password.";
            }
        }
        catch
        {
            _error = "Unable to connect. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void StartExternalLogin(string provider)
    {
        string encodedReturnUrl = Uri.EscapeDataString("/dashboard");
        Nav.NavigateTo($"/api/auth/external/{provider}/start?returnUrl={encodedReturnUrl}", forceLoad: true);
    }

    private async Task AnonLoginAsync()
    {
        _error = "";
        _loading = true;

        try
        {
            HttpResponseMessage response = await Http.PostAsJsonAsync("/api/auth/anon-login", new { });

            if (response.IsSuccessStatusCode)
            {
                AuthResponse? auth = await response.Content.ReadFromJsonAsync<AuthResponse>();
                if (auth is not null)
                {
                    if (AuthStateProvider is JwtAuthenticationStateProvider jwtProvider)
                    {
                        await jwtProvider.LoginAsync(auth.AccessToken);
                    }
                    Nav.NavigateTo("/dashboard");
                }
            }
            else
            {
                _error = "ANON login failed. Check server logs.";
            }
        }
        catch
        {
            _error = "Unable to connect. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed record ProvidersResponse(List<string> Providers);
}
