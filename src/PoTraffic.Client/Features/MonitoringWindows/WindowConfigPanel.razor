@using System.Net.Http.Json
@using PoTraffic.Shared.DTOs.Routes
@using PoTraffic.Shared.DTOs.History
@using PoTraffic.Shared.Enums
@inject HttpClient Http
@implements IDisposable

<RadzenFieldset Text="Monitoring Schedule" class="pt-mb-3">
    @* Loading + load-failure presentation comes from the shared scaffold every other
       data surface uses (Health, AdminUsage, Diag), so this panel can't drift from them. *@
    <LoadingErrorCard IsLoading="_loadingWindows" Error="@(string.IsNullOrEmpty(_loadError) ? null : _loadError)">
    @if (_activeWindow is not null && !_editing)
    {
        @* Read-only view with Edit Schedule button — hides the delete-to-replace mechanic *@
        <div class="pt-flex pt-items-center pt-gap-4 pt-mb-2">
            <div>
                <RadzenText TextStyle="TextStyle.Caption" class="pt-mb-0">Schedule</RadzenText>
                <RadzenText>@string.Join(", ", _activeWindow.DaysOfWeek) · @_activeWindow.StartTime – @_activeWindow.EndTime</RadzenText>
            </div>
            <RadzenButton Text="Edit Schedule" Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                          Click="@StartEditing" />
        </div>

        @if (_activeSession is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" class="pt-mb-2">
                Monitoring active — @_activeSession.PollCount poll(s) recorded today.
                @if (_activeSession.LastPollAt.HasValue)
                {
                    <span> Last poll: @_activeSession.LastPollAt.Value.ToLocalTime().ToString("HH:mm:ss")</span>
                }
                @if (!TodayIsScheduled)
                {
                    <div class="pt-mt-1">Today (@DateTime.UtcNow.DayOfWeek) is outside this schedule — polling resumes on the next scheduled day.</div>
                }
            </RadzenAlert>
        }
        else
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" class="pt-mb-2">
                No active session for today. Click <strong>Start Monitoring</strong> to begin.
            </RadzenAlert>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" class="pt-mb-2">@_error</RadzenAlert>
        }

        <div class="pt-flex pt-gap-2">
            @if (_activeSession is not null)
            {
                <RadzenButton Text="Stop Monitoring" ButtonStyle="ButtonStyle.Warning" Icon="stop"
                              Click="@StopMonitoringAsync" IsBusy="_saving" />
            }
            else
            {
                <RadzenButton Text="Start Monitoring" ButtonStyle="ButtonStyle.Success" Icon="play_arrow"
                              Click="@StartMonitoringAsync" IsBusy="_saving" />
            }
        </div>
    }
    else
    {
        @* Create / Edit form — _editing=true means updating an existing window *@
        @if (_editing)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" class="pt-mb-3">
                Saving a new schedule replaces the current one. Today's session will be restarted.
            </RadzenAlert>
        }

        <RadzenText TextStyle="TextStyle.Caption" class="pt-mb-2">Days of week:</RadzenText>
        <div class="pt-flex pt-wrap pt-gap-3 pt-mb-3">
            @foreach ((string name, byte bit) in _days)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                    <RadzenCheckBox TValue="bool" Value="_selectedDays[name]"
                                    Change="@(v => _selectedDays[name] = v)" />
                    <RadzenText TextStyle="TextStyle.Body2" class="pt-wcp-day-label">@name</RadzenText>
                </RadzenStack>
            }
        </div>

        <div class="pt-flex pt-gap-4 pt-mb-3">
            <RadzenFormField Text="Start Time" class="pt-mr-3">
                <RadzenDatePicker @bind-Value="_startTime" ShowTime="true" DateFormat="HH:mm" />
            </RadzenFormField>
            <RadzenFormField Text="End Time">
                <RadzenDatePicker @bind-Value="_endTime" ShowTime="true" DateFormat="HH:mm" />
            </RadzenFormField>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" class="pt-mb-2">@_error</RadzenAlert>
        }

        <div class="pt-flex pt-gap-2">
            <RadzenButton Text="@(_editing ? "Save Changes" : "Save Schedule")" ButtonStyle="ButtonStyle.Primary"
                          Click="@SaveWindowAsync" IsBusy="_saving" />
            @if (_editing)
            {
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light"
                              Click="@CancelEditing" />
            }
        </div>
    }
    </LoadingErrorCard>
</RadzenFieldset>

@code {
    [Parameter] public Guid RouteId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool _loadingWindows = true;
    private bool _saving;
    private bool _editing;
    private Guid _loadedRouteId;   // guards against reloading on every parent re-render (the 15s dashboard poll)
    private MonitoringWindowDto? _activeWindow;
    private SessionDto? _activeSession;

    /// <summary>True when today's UTC day-of-week is one the active window polls on.
    /// A Mon–Fri schedule viewed on Saturday is "active" (session running) but not scheduled,
    /// which is why the poll count can sit at 0 all day.</summary>
    private bool TodayIsScheduled =>
        _activeWindow is not null && _activeWindow.DaysOfWeek.Contains(DateTime.UtcNow.DayOfWeek.ToString());

    private string _error = "";
    private string _loadError = "";
    private System.Timers.Timer? _sessionRefreshTimer;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Refresh PollCount + LastPollAt every 15s so the "X poll(s) recorded today"
            // banner stays current while the scheduler is actively polling. Cheap call,
            // never blocks UI.
            _sessionRefreshTimer = new System.Timers.Timer(TimeSpan.FromSeconds(15).TotalMilliseconds);
            _sessionRefreshTimer.Elapsed += async (_, _) =>
            {
                if (_activeWindow is not null && !_editing)
                {
                    try { await RefreshSessionAsync(); }
                    catch { /* swallow — periodic refresh only */ }
                }
            };
            _sessionRefreshTimer.AutoReset = true;
            _sessionRefreshTimer.Start();
        }
    }

    private async Task RefreshSessionAsync()
    {
        if (_activeWindow is null) return;
        var sessions = await Http.GetFromJsonAsync(
            $"/api/routes/{RouteId}/sessions", AppJsonContext.Default.ListSessionDto);
        DateOnly today = DateOnly.FromDateTime(DateTime.UtcNow.Date);
        _activeSession = sessions?.FirstOrDefault(
            s => s.State == SessionState.Active && s.SessionDate == today);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_sessionRefreshTimer is not null)
        {
            _sessionRefreshTimer.Stop();
            _sessionRefreshTimer.Dispose();
            _sessionRefreshTimer = null;
        }
    }

    // Defaults for a new schedule: start = local time now, end = two hours later.
    // Window times are stored/interpreted server-side as UTC (see PollRouteJob),
    // but we display defaults in local time so they match the user's wall clock.
    // Editing an existing window overwrites these in LoadWindowAsync.
    private DateTime? _startTime = Routes.CreateRoutePage.LocalNowToMinute();
    private DateTime? _endTime = Routes.CreateRoutePage.LocalNowToMinute().AddHours(2);

    /// <summary>Convert local wall-clock <paramref name="local"/> to UTC and return "HH:mm".
    /// Delegates to <see cref="Routes.CreateRoutePage.ToUtcHHmm"/> so behavior is consistent.</summary>
    private static string ToUtcHHmm(DateTime local) => Routes.CreateRoutePage.ToUtcHHmm(local);

    private readonly (string name, byte bit)[] _days =
    [
        ("Mon", 0x01), ("Tue", 0x02), ("Wed", 0x04),
        ("Thu", 0x08), ("Fri", 0x10), ("Sat", 0x20), ("Sun", 0x40)
    ];

    private readonly Dictionary<string, bool> _selectedDays = new()
    {
        ["Mon"] = true, ["Tue"] = true, ["Wed"] = true,
        ["Thu"] = true, ["Fri"] = true, ["Sat"] = false, ["Sun"] = false
    };

    protected override async Task OnParametersSetAsync()
    {
        // Only (re)load when the route actually changes. The parent (RouteDetailPage) polls
        // every 15s and re-renders, which re-invokes this on an unchanged RouteId — reloading
        // there would flash the spinner and wipe any in-progress schedule edit.
        if (RouteId == _loadedRouteId)
            return;

        _loadedRouteId = RouteId;
        await LoadWindowAsync();
    }

    private async Task LoadWindowAsync()
    {
        _loadingWindows = true;
        _error = "";
        _loadError = "";
        try
        {
            var windows = await Http.GetFromJsonAsync(
                $"/api/routes/{RouteId}/windows", AppJsonContext.Default.ListMonitoringWindowDto);
            _activeWindow = windows?.FirstOrDefault(w => w.IsActive);

            _activeSession = null;
            if (_activeWindow is not null)
            {
                var sessions = await Http.GetFromJsonAsync(
                    $"/api/routes/{RouteId}/sessions", AppJsonContext.Default.ListSessionDto);
                DateOnly today = DateOnly.FromDateTime(DateTime.UtcNow.Date);
                _activeSession = sessions?.FirstOrDefault(
                    s => s.State == SessionState.Active && s.SessionDate == today);
            }
        }
        catch
        {
            _loadError = "Failed to load monitoring configuration. Please refresh the page.";
        }
        finally
        {
            _loadingWindows = false;
        }
    }

    private void StartEditing()
    {
        _editing = true;
        _error = "";
        // Default to "monitor from now" — start at the current local wall-clock minute,
        // end two hours later. The existing window is replaced wholesale on save, so
        // there's no value in re-populating its saved times here; the user is almost
        // always opening this panel to start a fresh window starting right now.
        _startTime = Routes.CreateRoutePage.LocalNowToMinute();
        _endTime = Routes.CreateRoutePage.LocalNowToMinute().AddHours(2);

        if (_activeWindow is not null)
        {
            // Carry over the day mask so the user doesn't have to re-pick Mon–Fri etc.
            // each time. Time fields stay on the now/+2h defaults.
            foreach (var (name, bit) in _days)
                _selectedDays[name] = false;
            foreach (string day in _activeWindow.DaysOfWeek)
                if (_selectedDays.ContainsKey(day[..3]))
                    _selectedDays[day[..3]] = true;
        }
    }

    private void CancelEditing()
    {
        _editing = false;
        _error = "";
    }

    private async Task StartMonitoringAsync()
    {
        if (_activeWindow is null) return;
        _saving = true;
        _error = "";
        try
        {
            HttpResponseMessage resp = await Http.PostAsync(
                $"/api/routes/{RouteId}/windows/{_activeWindow.Id}/start", null);

            if (resp.IsSuccessStatusCode)
            {
                await LoadWindowAsync();
                await OnSaved.InvokeAsync();
            }
            else if (resp.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
                _error = "Daily monitoring quota exceeded. Try again tomorrow.";
            else
                _error = "Failed to start monitoring. Please try again.";
        }
        catch { _error = "Unable to connect. Please try again."; }
        finally { _saving = false; }
    }

    private async Task StopMonitoringAsync()
    {
        if (_activeWindow is null || _activeSession is null) return;
        _saving = true;
        _error = "";
        try
        {
            HttpResponseMessage resp = await Http.PostAsJsonAsync(
                $"/api/routes/{RouteId}/windows/{_activeWindow.Id}/stop",
                new StopSessionRequest(_activeSession.Id), AppJsonContext.Default.StopSessionRequest);

            if (resp.IsSuccessStatusCode)
            {
                await LoadWindowAsync();
                await OnSaved.InvokeAsync();
            }
            else
                _error = "Failed to stop monitoring. Please try again.";
        }
        catch { _error = "Unable to connect. Please try again."; }
        finally { _saving = false; }
    }

    private async Task SaveWindowAsync()
    {
        _error = "";

        byte mask = 0;
        foreach ((string name, byte bit) in _days)
            if (_selectedDays[name]) mask |= bit;

        if (mask == 0) { _error = "Select at least one day."; return; }
        if (_endTime <= _startTime) { _error = "End time must be after start time."; return; }

        _saving = true;
        try
        {
            // C3/UX-7: Delete existing window first if editing — hide this mechanic from the user
            if (_editing && _activeWindow is not null)
            {
                await Http.DeleteAsync($"/api/routes/{RouteId}/windows/{_activeWindow.Id}");
            }

            HttpResponseMessage resp = await Http.PostAsJsonAsync(
                $"/api/routes/{RouteId}/windows",
                new SaveWindowRequest(
                    ToUtcHHmm(_startTime!.Value),
                    ToUtcHHmm(_endTime!.Value),
                    mask), AppJsonContext.Default.SaveWindowRequest);

            if (resp.IsSuccessStatusCode)
            {
                _editing = false;
                await LoadWindowAsync();
                await OnSaved.InvokeAsync();
            }
            else
                _error = "Failed to save schedule. Please try again.";
        }
        catch { _error = "Unable to connect. Please try again."; }
        finally { _saving = false; }
    }
}
