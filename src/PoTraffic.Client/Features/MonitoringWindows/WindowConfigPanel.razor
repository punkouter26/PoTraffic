@using System.Net.Http.Json
@using PoTraffic.Shared.DTOs.Routes
@using PoTraffic.Shared.DTOs.History
@using PoTraffic.Shared.Enums
@inject HttpClient Http

<RadzenFieldset Text="Monitoring Schedule" class="rz-mb-3">
    @if (_loadingWindows)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" class="rz-mb-2" />
    }
    else if (!string.IsNullOrEmpty(_loadError))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" class="rz-mb-2">@_loadError</RadzenAlert>
    }
    else if (_activeWindow is not null && !_editing)
    {
        @* Read-only view with Edit Schedule button — hides the delete-to-replace mechanic *@
        <div class="rz-display-flex rz-align-items-center rz-gap-4 rz-mb-2">
            <div>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">Schedule</RadzenText>
                <RadzenText>@string.Join(", ", _activeWindow.DaysOfWeek) · @_activeWindow.StartTime – @_activeWindow.EndTime</RadzenText>
            </div>
            <RadzenButton Text="Edit Schedule" Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                          Click="@StartEditing" />
        </div>

        @if (_activeSession is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" class="rz-mb-2">
                Monitoring active — @_activeSession.PollCount poll(s) recorded today.
                @if (_activeSession.LastPollAt.HasValue)
                {
                    <span> Last poll: @_activeSession.LastPollAt.Value.ToLocalTime().ToString("HH:mm:ss")</span>
                }
            </RadzenAlert>
        }
        else
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" class="rz-mb-2">
                No active session for today. Click <strong>Start Monitoring</strong> to begin.
            </RadzenAlert>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" class="rz-mb-2">@_error</RadzenAlert>
        }

        <div class="rz-display-flex rz-gap-2">
            @if (_activeSession is not null)
            {
                <RadzenButton Text="Stop Monitoring" ButtonStyle="ButtonStyle.Warning" Icon="stop"
                              Click="@StopMonitoringAsync" IsBusy="_saving" />
            }
            else
            {
                <RadzenButton Text="Start Monitoring" ButtonStyle="ButtonStyle.Success" Icon="play_arrow"
                              Click="@StartMonitoringAsync" IsBusy="_saving" />
            }
        </div>
    }
    else
    {
        @* Create / Edit form — _editing=true means updating an existing window *@
        @if (_editing)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" class="rz-mb-3">
                Saving a new schedule replaces the current one. Today's session will be restarted.
            </RadzenAlert>
        }

        <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-2">Days of week:</RadzenText>
        <div class="rz-display-flex rz-wrap rz-gap-3 rz-mb-3">
            @foreach ((string name, byte bit) in _days)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                    <RadzenCheckBox TValue="bool" Value="_selectedDays[name]"
                                    Change="@(v => _selectedDays[name] = v)" />
                    <RadzenText TextStyle="TextStyle.Body2" Style="margin:0;cursor:pointer;">@name</RadzenText>
                </RadzenStack>
            }
        </div>

        <div class="rz-display-flex rz-gap-4 rz-mb-3">
            <RadzenFormField Text="Start Time" class="rz-mr-3">
                <RadzenDatePicker @bind-Value="_startTime" ShowTime="true" DateFormat="HH:mm" />
            </RadzenFormField>
            <RadzenFormField Text="End Time">
                <RadzenDatePicker @bind-Value="_endTime" ShowTime="true" DateFormat="HH:mm" />
            </RadzenFormField>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" class="rz-mb-2">@_error</RadzenAlert>
        }

        <div class="rz-display-flex rz-gap-2">
            <RadzenButton Text="@(_editing ? "Save Changes" : "Save Schedule")" ButtonStyle="ButtonStyle.Primary"
                          Click="@SaveWindowAsync" IsBusy="_saving" />
            @if (_editing)
            {
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light"
                              Click="@CancelEditing" />
            }
        </div>
    }
</RadzenFieldset>

@code {
    [Parameter] public Guid RouteId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool _loadingWindows = true;
    private bool _saving;
    private bool _editing;
    private MonitoringWindowDto? _activeWindow;
    private SessionDto? _activeSession;
    private string _error = "";
    private string _loadError = "";

    // Defaults for a new schedule: start = now, end = one hour later (UTC —
    // window times are interpreted server-side as UTC). Editing an existing
    // window overwrites these in LoadWindowAsync.
    private DateTime? _startTime = Routes.CreateRoutePage.UtcNowToMinute();
    private DateTime? _endTime = Routes.CreateRoutePage.UtcNowToMinute().AddHours(1);

    private readonly (string name, byte bit)[] _days =
    [
        ("Mon", 0x01), ("Tue", 0x02), ("Wed", 0x04),
        ("Thu", 0x08), ("Fri", 0x10), ("Sat", 0x20), ("Sun", 0x40)
    ];

    private readonly Dictionary<string, bool> _selectedDays = new()
    {
        ["Mon"] = true, ["Tue"] = true, ["Wed"] = true,
        ["Thu"] = true, ["Fri"] = true, ["Sat"] = false, ["Sun"] = false
    };

    protected override async Task OnParametersSetAsync()
    {
        await LoadWindowAsync();
    }

    private async Task LoadWindowAsync()
    {
        _loadingWindows = true;
        _error = "";
        _loadError = "";
        try
        {
            var windows = await Http.GetFromJsonAsync(
                $"/api/routes/{RouteId}/windows", AppJsonContext.Default.ListMonitoringWindowDto);
            _activeWindow = windows?.FirstOrDefault(w => w.IsActive);

            _activeSession = null;
            if (_activeWindow is not null)
            {
                var sessions = await Http.GetFromJsonAsync(
                    $"/api/routes/{RouteId}/sessions", AppJsonContext.Default.ListSessionDto);
                DateOnly today = DateOnly.FromDateTime(DateTime.UtcNow.Date);
                _activeSession = sessions?.FirstOrDefault(
                    s => s.State == SessionState.Active && s.SessionDate == today);
            }
        }
        catch
        {
            _loadError = "Failed to load monitoring configuration. Please refresh the page.";
        }
        finally
        {
            _loadingWindows = false;
        }
    }

    private void StartEditing()
    {
        _editing = true;
        _error = "";
        // Pre-populate form with existing window values
        if (_activeWindow is not null)
        {
            if (TimeSpan.TryParse(_activeWindow.StartTime, out var start))
                _startTime = DateTime.Today + start;
            if (TimeSpan.TryParse(_activeWindow.EndTime, out var end))
                _endTime = DateTime.Today + end;

            foreach (var (name, bit) in _days)
                _selectedDays[name] = false;
            foreach (string day in _activeWindow.DaysOfWeek)
                if (_selectedDays.ContainsKey(day[..3]))
                    _selectedDays[day[..3]] = true;
        }
    }

    private void CancelEditing()
    {
        _editing = false;
        _error = "";
    }

    private async Task StartMonitoringAsync()
    {
        if (_activeWindow is null) return;
        _saving = true;
        _error = "";
        try
        {
            HttpResponseMessage resp = await Http.PostAsync(
                $"/api/routes/{RouteId}/windows/{_activeWindow.Id}/start", null);

            if (resp.IsSuccessStatusCode)
            {
                await LoadWindowAsync();
                await OnSaved.InvokeAsync();
            }
            else if (resp.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
                _error = "Daily monitoring quota exceeded. Try again tomorrow.";
            else
                _error = "Failed to start monitoring. Please try again.";
        }
        catch { _error = "Unable to connect. Please try again."; }
        finally { _saving = false; }
    }

    private async Task StopMonitoringAsync()
    {
        if (_activeWindow is null || _activeSession is null) return;
        _saving = true;
        _error = "";
        try
        {
            HttpResponseMessage resp = await Http.PostAsJsonAsync(
                $"/api/routes/{RouteId}/windows/{_activeWindow.Id}/stop",
                new StopSessionRequest(_activeSession.Id), AppJsonContext.Default.StopSessionRequest);

            if (resp.IsSuccessStatusCode)
            {
                await LoadWindowAsync();
                await OnSaved.InvokeAsync();
            }
            else
                _error = "Failed to stop monitoring. Please try again.";
        }
        catch { _error = "Unable to connect. Please try again."; }
        finally { _saving = false; }
    }

    private async Task SaveWindowAsync()
    {
        _error = "";

        byte mask = 0;
        foreach ((string name, byte bit) in _days)
            if (_selectedDays[name]) mask |= bit;

        if (mask == 0) { _error = "Select at least one day."; return; }
        if (_endTime <= _startTime) { _error = "End time must be after start time."; return; }

        _saving = true;
        try
        {
            // C3/UX-7: Delete existing window first if editing — hide this mechanic from the user
            if (_editing && _activeWindow is not null)
            {
                await Http.DeleteAsync($"/api/routes/{RouteId}/windows/{_activeWindow.Id}");
            }

            HttpResponseMessage resp = await Http.PostAsJsonAsync(
                $"/api/routes/{RouteId}/windows",
                new SaveWindowRequest(
                    _startTime!.Value.ToString("HH:mm:ss"),
                    _endTime!.Value.ToString("HH:mm:ss"),
                    mask), AppJsonContext.Default.SaveWindowRequest);

            if (resp.IsSuccessStatusCode)
            {
                _editing = false;
                await LoadWindowAsync();
                await OnSaved.InvokeAsync();
            }
            else
                _error = "Failed to save schedule. Please try again.";
        }
        catch { _error = "Unable to connect. Please try again."; }
        finally { _saving = false; }
    }
}
