@using System.Text.Json
@using PoTraffic.Shared.DTOs.Routes
@using PoTraffic.Shared.DTOs.History
@inject HttpClient Http

@* The route's monitoring schedule as one line of the route page's settings card, and
   the shared editor when it is being changed.

   The window and today's session come from the page, which already loads both on its
   15-second refresh. This panel used to fetch them itself, on a second 15-second timer,
   to render a "Monitoring active — N polls recorded today" alert that repeated the
   header's status chip. *@
<div class="pt-schedule">
    @if (Window is not null && !_editing)
    {
        <div class="pt-setting-row">
            <span class="pt-setting-label">Schedule</span>
            <span class="pt-setting-value">
                @ScheduleFields.DaysLabel(Window.DaysOfWeek) · @FormatWindowTime(Window.StartTime)–@FormatWindowTime(Window.EndTime)
            </span>
            <RadzenButton Text="Edit schedule" Icon="edit" ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.ExtraSmall" Click="@StartEditing" />
            @if (Session is not null)
            {
                <RadzenButton Text="Stop" Icon="stop" ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.ExtraSmall" Click="@StopMonitoringAsync" IsBusy="_saving"
                              title="Stop monitoring today" />
            }
        </div>
        @if (_error is not null)
        {
            <div class="pt-field-error" role="alert">@_error</div>
        }
    }
    else
    {
        <RadzenTemplateForm TItem="ScheduleForm" Data="@_form" Submit="@SaveWindowAsync">
            <div class="pt-setting-label pt-mb-2">
                @(_editing ? "Saving replaces the current schedule and restarts today's session." : "Schedule")
            </div>

            <ScheduleFields @bind-Start="_startTime" @bind-End="_endTime" @bind-Days="_days" />

            @if (_error is not null)
            {
                <div class="pt-field-error" role="alert">@_error</div>
            }

            <div class="pt-flex pt-gap-2">
                <RadzenButton ButtonType="ButtonType.Submit" Text="Save schedule" ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Small" IsBusy="_saving" />
                @if (_editing)
                {
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Click="@(() => { _editing = false; _error = null; })" />
                }
            </div>
        </RadzenTemplateForm>
    }
</div>

@code {
    [Parameter] public Guid RouteId { get; set; }

    /// <summary>The route's active window, or null when it has none.</summary>
    [Parameter] public MonitoringWindowDto? Window { get; set; }

    /// <summary>Today's active session — Stop is offered only while there is one.</summary>
    [Parameter] public SessionDto? Session { get; set; }

    [Parameter] public EventCallback OnSaved { get; set; }

    /// <summary>RadzenTemplateForm needs a model; the fields bind to component state.</summary>
    private sealed class ScheduleForm { }
    private readonly ScheduleForm _form = new();

    private bool _saving;
    private bool _editing;
    private string? _error;

    // A new window defaults to "monitor from now": this minute through two hours later.
    private DateTime? _startTime = ScheduleFields.LocalNowToMinute();
    private DateTime? _endTime = ScheduleFields.LocalNowToMinute().AddHours(2);
    private IEnumerable<byte> _days = ScheduleFields.WeekdayBits;

    /// <summary>
    /// A window with a zone holds wall-clock times already; a legacy window (no zone)
    /// holds UTC and is converted to local time.
    /// </summary>
    private string FormatWindowTime(string hhmm)
        => Window?.TimeZoneId is null
            ? LocalTimeFormatter.FormatUtcHHmmAsLocal(hhmm)
            : LocalTimeFormatter.FormatWallClock(hhmm);

    private void StartEditing()
    {
        _editing = true;
        _error = null;
        // Times reset to now → +2h: the window is replaced wholesale, and the user is almost
        // always here to watch from now. The day mask carries over.
        _startTime = ScheduleFields.LocalNowToMinute();
        _endTime = _startTime.Value.AddHours(2);
        if (Window is not null)
            _days = ScheduleFields.ToBits(Window.DaysOfWeek);
    }

    private async Task StopMonitoringAsync()
    {
        if (Window is null || Session is null) return;
        _saving = true;
        _error = null;
        try
        {
            HttpResponseMessage resp = await Http.PostAsJsonAsync(
                $"/api/routes/{RouteId}/windows/{Window.Id}/stop",
                new StopSessionRequest(Session.Id), AppJsonContext.Default.StopSessionRequest);

            if (resp.IsSuccessStatusCode)
                await OnSaved.InvokeAsync();
            else
                _error = "Failed to stop monitoring. Please try again.";
        }
        catch { _error = "Unable to connect. Please try again."; }
        finally { _saving = false; }
    }

    private async Task SaveWindowAsync()
    {
        _error = null;
        byte mask = ScheduleFields.ToMask(_days);
        if (mask == 0) { _error = "Select at least one day."; return; }
        if (_startTime is null || _endTime is null || !ScheduleFields.EndDiffersFromStart(_startTime, _endTime))
            return;

        _saving = true;
        try
        {
            // Editing replaces the window: delete the old one first, out of the user's sight.
            if (_editing && Window is not null)
                await Http.DeleteAsync($"/api/routes/{RouteId}/windows/{Window.Id}");

            HttpResponseMessage resp = await Http.PostAsJsonAsync(
                $"/api/routes/{RouteId}/windows",
                new SaveWindowRequest(
                    ScheduleFields.ToHHmm(_startTime.Value),
                    ScheduleFields.ToHHmm(_endTime.Value),
                    mask,
                    ScheduleFields.LocalZoneId), AppJsonContext.Default.SaveWindowRequest);

            if (!resp.IsSuccessStatusCode)
            {
                _error = await BuildSaveErrorMessageAsync(resp);
                return;
            }

            JsonElement body = await resp.Content.ReadFromJsonAsync(AppJsonContext.Default.JsonElement);
            if (!body.TryGetProperty("windowId", out JsonElement windowIdElement) ||
                !windowIdElement.TryGetGuid(out Guid windowId))
            {
                _error = "Schedule saved, but monitoring could not be initialized.";
                return;
            }

            HttpResponseMessage startResp = await Http.PostAsync(
                $"/api/routes/{RouteId}/windows/{windowId}/start", null);
            if (!startResp.IsSuccessStatusCode)
            {
                _error = startResp.StatusCode == System.Net.HttpStatusCode.TooManyRequests
                    ? "Schedule saved, but daily monitoring quota is exhausted."
                    : "Schedule saved, but monitoring could not be initialized.";
                return;
            }

            _editing = false;
            await OnSaved.InvokeAsync();
        }
        catch { _error = "Unable to connect. Please try again."; }
        finally { _saving = false; }
    }

    /// <summary>
    /// Maps non-2xx POST /windows responses to a user-facing message, rather than one
    /// generic line hiding 422s, 409s and auth issues alike.
    /// </summary>
    private static async Task<string> BuildSaveErrorMessageAsync(HttpResponseMessage resp)
    {
        string serverMessage = "";
        try
        {
            string body = await resp.Content.ReadAsStringAsync();
            if (!string.IsNullOrWhiteSpace(body))
            {
                using JsonDocument doc = JsonDocument.Parse(body);
                if (doc.RootElement.TryGetProperty("error", out JsonElement err)
                    && err.ValueKind == JsonValueKind.String)
                {
                    serverMessage = err.GetString() ?? "";
                }
            }
        }
        catch { /* body wasn't JSON — fall through to default message */ }

        return resp.StatusCode switch
        {
            System.Net.HttpStatusCode.BadRequest => serverMessage switch
            {
                "INVALID_START_TIME" => "Start time is not a valid time. Please re-enter.",
                "INVALID_END_TIME"   => "End time is not a valid time. Please re-enter.",
                _                    => "The server rejected the schedule format."
            },
            System.Net.HttpStatusCode.UnprocessableEntity => serverMessage.Contains("Equal", StringComparison.OrdinalIgnoreCase)
                ? "End time cannot equal start time."
                : "The server rejected this schedule — check the times and selected days.",
            System.Net.HttpStatusCode.Conflict => "A schedule is already active for this commute. " +
                                                  "Stop monitoring or refresh the page, then try again.",
            System.Net.HttpStatusCode.NotFound => "This commute no longer exists.",
            System.Net.HttpStatusCode.Unauthorized => "You're signed out. Sign in and try again.",
            _ => "Failed to save schedule. Please try again."
        };
    }
}
