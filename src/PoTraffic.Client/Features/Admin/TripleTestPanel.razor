@using System.Net.Http.Json
@using System.Text.Json
@using PoTraffic.Shared.DTOs.Admin
@using PoTraffic.Shared.Enums
@inject HttpClient Http
@inject NotificationService NotificationService
@implements IAsyncDisposable

<RadzenText TextStyle="TextStyle.Body2" class="pt-mb-4 pt-tt-lead">
    Fires 3 live travel-time queries at t=0 s, t+20 s, t+40 s via the scheduler and reports which departure was fastest.
</RadzenText>

@if (_session is null && !_running)
{
    <TripleTestConfigForm @bind-Origin="_origin" @bind-Destination="_destination"
                          @bind-Provider="_provider" @bind-StartAt="_startAt"
                          IsSubmitting="_submitting" Error="@_error"
                          OnSubmit="StartAsync" />
}
else if (_running && _session is null)
{
    <TripleTestProgress SessionId="_sessionId" StartAt="_startAt"
                        OnRefresh="@(async () => await PollSessionAsync())" />
}
else if (_session is not null)
{
    <TripleTestResults Session="_session"
                       AllDone="_allDone"
                       CompletedShots="_completedShots"
                       PollCount="_pollCount"
                       LastPollAge="_lastPollAge"
                       OnRefresh="@(async () => await PollSessionAsync())"
                       OnReset="Reset" />
}

@code {
    private string _origin = "501 Sylview Dr, Pasadena, CA 91107";
    private string _destination = "456 S Fair Oaks Ave, Pasadena, CA 91105";
    private int _provider = 0;
    private DateTime? _startAt = DateTime.Now.AddMinutes(1);
    private bool _submitting;
    private bool _running;
    private string? _error;

    private Guid? _sessionId;
    private TripleTestSessionDto? _session;

    private PeriodicTimer? _timer;
    private Task? _timerLoop;
    private readonly CancellationTokenSource _cts = new();

    private PeriodicTimer? _countdownTimer;
    private Task? _countdownLoop;
    private int _pollCount;
    private DateTime? _lastPollAt;
    private string _lastPollAge => _lastPollAt.HasValue
        ? $"{(int)(DateTime.Now - _lastPollAt.Value).TotalSeconds}s ago"
        : "never";

    private int _completedShots => _session?.Shots.Count(s => s.IsSuccess.HasValue) ?? 0;
    private bool _allDone => _completedShots == 3;

    private async Task StartAsync()
    {
        _error = null;
        _submitting = true;
        StateHasChanged();

        try
        {
            var request = new TripleTestRequest(
                _origin.Trim(),
                _destination.Trim(),
                (RouteProvider)_provider,
                _startAt?.ToUniversalTime());

            HttpResponseMessage resp = await Http.PostAsJsonAsync("/api/admin/triple-test", request, AppJsonContext.Default.TripleTestRequest);

            if (!resp.IsSuccessStatusCode)
            {
                _error = $"Failed to start triple test ({(int)resp.StatusCode}).";
                return;
            }

            var body = await resp.Content.ReadFromJsonAsync(AppJsonContext.Default.JsonElement);
            _sessionId = body.GetProperty("sessionId").GetGuid();
            _running = true;
            _pollCount = 0;
            _lastPollAt = null;

            _countdownTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            _countdownLoop = CountdownLoopAsync();

            _timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
            _timerLoop = PollLoopAsync();
        }
        catch (Exception ex)
        {
            _error = $"Error: {ex.Message}";
        }
        finally
        {
            _submitting = false;
            StateHasChanged();
        }
    }

    private async Task PollLoopAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                await PollSessionAsync();
                if (_session is not null && _session.Shots.All(s => s.IsSuccess.HasValue))
                {
                    _timer.Dispose();
                    _timer = null;
                    break;
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task CountdownLoopAsync()
    {
        try
        {
            while (await _countdownTimer!.WaitForNextTickAsync(_cts.Token))
            {
                await InvokeAsync(StateHasChanged);
                if (_allDone) break;
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task PollSessionAsync()
    {
        if (_sessionId is null) return;
        try
        {
            HttpResponseMessage resp = await Http.GetAsync($"/api/admin/triple-test/{_sessionId}");
            _lastPollAt = DateTime.Now;
            _pollCount++;

            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                _error = "Session expired — please sign in again.";
                _running = false;
                _timer?.Dispose();
                _timer = null;
                await InvokeAsync(StateHasChanged);
                return;
            }

            if (!resp.IsSuccessStatusCode)
            {
                _error = $"Poll failed ({(int)resp.StatusCode}). Retrying…";
                await InvokeAsync(StateHasChanged);
                return;
            }

            _session = await resp.Content.ReadFromJsonAsync(AppJsonContext.Default.TripleTestSessionDto);
            _error = null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = $"Poll error: {ex.Message}";
        }
        await InvokeAsync(StateHasChanged);
    }

    private void Reset()
    {
        _session = null;
        _sessionId = null;
        _running = false;
        _error = null;
        _pollCount = 0;
        _lastPollAt = null;
        _origin = "501 Sylview Dr, Pasadena, CA 91107";
        _destination = "456 S Fair Oaks Ave, Pasadena, CA 91105";
        _startAt = DateTime.Now.AddMinutes(1);
        _timer?.Dispose();
        _timer = null;
        _countdownTimer?.Dispose();
        _countdownTimer = null;
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _timer?.Dispose();
        _countdownTimer?.Dispose();
        if (_timerLoop is not null) await _timerLoop.ConfigureAwait(false);
        if (_countdownLoop is not null) await _countdownLoop.ConfigureAwait(false);
        _cts.Dispose();
    }
}
