@page "/account/settings"
@attribute [Authorize]
@implements IAsyncDisposable
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject DialogService DialogService
@inject NotificationService NotificationService

<PageTitle>Account Settings</PageTitle>

<PageHeader Title="Account settings"
            Subtitle="Profile, appearance, and what this account is costing." />

<RadzenCard class="pt-p-6">
    @* Four tabs held about six controls between them, which cost a click and hid
       two thirds of the page to save no scrolling. They are sections now. *@
    <section class="pt-settings-section">
        <RadzenText TextStyle="TextStyle.H6" class="pt-mb-2">Profile</RadzenText>
                @if (_loading)
                {
                    <div class="pt-skeleton-stack pt-mt-4">
                        <div class="pt-skeleton-line lg w-40"></div>
                        <div class="pt-skeleton-line w-70"></div>
                        <div class="pt-skeleton-line lg w-40"></div>
                        <div class="pt-skeleton-line w-70"></div>
                        <div class="pt-skeleton-line w-30"></div>
                    </div>
                }
                else if (_profile is not null)
                {
                    @* The form is a RadzenTemplateForm rather than loose inputs, so the
                       locale rule is enforced before the request goes out and failures
                       land on the field instead of arriving as a server round-trip. *@
                    <RadzenTemplateForm TItem="ProfileForm" Data="@_form" Submit="@SaveProfileAsync">
                        <RadzenStack Gap="1rem" class="pt-mt-4">
                            <RadzenFormField Text="Email">
                                <ChildContent>
                                    <RadzenTextBox Value="@_profile.Email" ReadOnly="true" aria-label="Email address" />
                                </ChildContent>
                                <Helper>
                                    <RadzenText TextStyle="TextStyle.Caption">
                                        Your sign-in address can't be changed here.
                                    </RadzenText>
                                </Helper>
                            </RadzenFormField>

                            <RadzenFormField Text="Locale">
                                <ChildContent>
                                    @* Whitelist mirrors the server validator — no freeform text
                                       that can only fail once it reaches the API. *@
                                    <RadzenDropDown Name="Locale" @bind-Value="_form.Locale"
                                                    Data="@ValidLocales" class="pt-settings-full"
                                                    AllowFiltering="true" AllowClear="false" />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="Locale"
                                                             Text="Choose the locale your times should display in." />
                                </Helper>
                            </RadzenFormField>

                            <div>
                                <RadzenButton ButtonType="ButtonType.Submit" Text="Save"
                                              ButtonStyle="ButtonStyle.Primary" IsBusy="@_saving" />
                            </div>

                            @if (_profileSaved)
                            {
                                <RadzenAlert AlertStyle="AlertStyle.Success" AllowClose="false"
                                             Text="Profile updated." class="pt-enter" />
                            }
                            @if (_profileError is not null)
                            {
                                <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false"
                                             Text="@_profileError" class="pt-enter" />
                            }
                        </RadzenStack>
                    </RadzenTemplateForm>
                }
    </section>

    <section class="pt-settings-section">
        <RadzenText TextStyle="TextStyle.H6" class="pt-mb-2">Appearance</RadzenText>
                <RadzenStack Gap="1.5rem" class="pt-mt-4">
                    @* Both pickers were hand-rolled <button role="radio"> grids with their
                       own aria-checked plumbing and their own emoji glyphs — a segmented
                       control reimplemented twice, next to a RadzenDropDown that already
                       proves the app uses Radzen form controls. RadzenSelectBar IS this
                       control: it owns the roving-tabindex keyboard model, the selected
                       state and the theming, and it takes Material icon names. *@
                    <div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="pt-mb-1">Theme</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" class="pt-mb-2 pt-settings-meta">
                            System follows your device setting and switches with it.
                        </RadzenText>
                        <RadzenSelectBar TValue="string" Value="@_theme" Change="@OnThemeChanged"
                                         Size="ButtonSize.Medium" aria-label="Theme">
                            <Items>
                                <RadzenSelectBarItem Value="@("system")" Text="System" Icon="computer" />
                                <RadzenSelectBarItem Value="@("light")" Text="Light" Icon="light_mode" />
                                <RadzenSelectBarItem Value="@("dark")" Text="Dark" Icon="dark_mode" />
                            </Items>
                        </RadzenSelectBar>
                    </div>

                    <div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="pt-mb-1">Density</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" class="pt-mb-2 pt-settings-meta">
                            Scales spacing across the whole app. Compact fits more on screen.
                        </RadzenText>
                        <RadzenSelectBar TValue="string" Value="@_density" Change="@OnDensityChanged"
                                         Size="ButtonSize.Medium" aria-label="Density">
                            <Items>
                                <RadzenSelectBarItem Value="@("compact")" Text="Compact" Icon="density_small" />
                                <RadzenSelectBarItem Value="@("normal")" Text="Normal" Icon="density_medium" />
                                <RadzenSelectBarItem Value="@("comfortable")" Text="Comfortable" Icon="density_large" />
                            </Items>
                        </RadzenSelectBar>
                    </div>

                    @* Neither of these is ours to set — the OS owns them. Reporting them
                       explains why the app already looks different rather than leaving
                       the user hunting for a switch that shouldn't exist. *@
                    @if (_prefersContrast || _prefersReducedMotion)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" class="pt-enter">
                            Following your system preferences:
                            @if (_prefersContrast)
                            {
                                <text>higher contrast</text>
                            }
                            @if (_prefersContrast && _prefersReducedMotion)
                            {
                                <text> and </text>
                            }
                            @if (_prefersReducedMotion)
                            {
                                <text>reduced motion</text>
                            }.
                        </RadzenAlert>
                    }
                </RadzenStack>
    </section>

    <section class="pt-settings-section">
        <RadzenText TextStyle="TextStyle.H6" class="pt-mb-2">Monitoring limits &amp; cost</RadzenText>
                @if (_loading)
                {
                    <div class="pt-skeleton-stack pt-mt-4">
                        <div class="pt-skeleton-line w-50"></div>
                        <div class="pt-skeleton-line lg w-70"></div>
                        <div class="pt-skeleton-line w-40"></div>
                    </div>
                }
                else if (_quota is not null)
                {
                    @* Moved here from the dashboard status bar, where a quota ring, a
                       running spend figure and a reset time sat between the user and
                       the departure times they came for. This is where someone goes
                       when they actually want to know. *@
                    <RadzenStack Gap="1rem" class="pt-mt-4">
                        <RadzenText>
                            Used today: @_quota.UsedToday of @_quota.DailyLimit monitoring sessions
                        </RadzenText>
                        <RadzenProgressBar Value="@QuotaPercent" ShowValue="true"
                                           ProgressBarStyle="@QuotaStyle" />
                        <RadzenText class="pt-settings-meta">
                            Resets at @_quota.ResetsAtUtc.ToString("HH:mm") UTC.
                            @if (_quota.PollsToday > 0)
                            {
                                <text>
                                    @_quota.PollsToday traffic look-ups so far today,
                                    about @_quota.EstimatedCostTodayUsd.ToString("C3") —
                                    roughly @_quota.ProjectedMonthlyCostUsd.ToString("C2") a month at this rate.
                                </text>
                            }
                        </RadzenText>
                    </RadzenStack>
                }
    </section>

    <section class="pt-settings-section pt-settings-danger">
        <RadzenText TextStyle="TextStyle.H6" class="pt-mb-2">Delete account</RadzenText>
                <RadzenStack Gap="1rem" class="pt-mt-4">
                    <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false"
                                 Text="Deleting your account is permanent and cannot be undone. All your routes, history, and data will be removed (GDPR Art. 17)." />
                    <div>
                        <RadzenButton Text="Delete My Account" ButtonStyle="ButtonStyle.Danger"
                                      Click="@ConfirmDeleteAsync" IsBusy="@_deleting" />
                    </div>
                </RadzenStack>
    </section>
</RadzenCard>

@code {
    /// <summary>Bound by the profile form so validation has a model to work against.</summary>
    private sealed class ProfileForm
    {
        public string Locale { get; set; } = string.Empty;
    }

    // Whitelist matches the server-side validator.
    private static readonly List<string> ValidLocales = ["en-IE", "en-GB", "en-US", "de-DE", "fr-FR"];

    private ProfileDto? _profile;
    private QuotaDto? _quota;
    private readonly ProfileForm _form = new();
    private bool _loading = true;
    private bool _saving;
    private bool _deleting;
    private bool _profileSaved;
    private string? _profileError;

    private string _theme = "system";
    private string _density = "normal";
    private bool _prefersContrast;
    private bool _prefersReducedMotion;
    private IJSObjectReference? _appearance;

    private double QuotaPercent =>
        _quota is { DailyLimit: > 0 } q ? Math.Min(100, (double)q.UsedToday / q.DailyLimit * 100) : 0;

    private ProgressBarStyle QuotaStyle => QuotaPercent switch
    {
        >= 90 => ProgressBarStyle.Danger,
        >= 70 => ProgressBarStyle.Warning,
        _ => ProgressBarStyle.Primary
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _profile = await Http.GetFromJsonAsync("/api/account/profile", AppJsonContext.Default.ProfileDto);
            _quota = await Http.GetFromJsonAsync("/api/account/quota", AppJsonContext.Default.QuotaDto);
            _form.Locale = _profile?.Locale ?? string.Empty;
        }
        catch { /* handled by null guards */ }
        finally { _loading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _appearance = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pt-appearance.js");
            AppearanceState state = await _appearance.InvokeAsync<AppearanceState>("getAppearance");
            _theme = state.Theme;
            _density = state.Density;
            _prefersContrast = state.PrefersContrast;
            _prefersReducedMotion = state.PrefersReducedMotion;
            StateHasChanged();
        }
        catch
        {
            // No interop is a degraded settings panel, not a broken page — the
            // controls simply show the defaults.
        }
    }

    /// <summary>
    /// RadzenSelectBar's Change hands back the item's Value boxed as object. A null can
    /// only mean a deselect, which this bar does not offer — guard anyway rather than
    /// stamping "" onto &lt;html data-theme&gt; and losing the theme entirely.
    /// </summary>
    private async Task OnThemeChanged(object? value)
    {
        if (value?.ToString() is not { Length: > 0 } theme)
            return;

        _theme = theme;
        if (_appearance is not null)
            await _appearance.InvokeVoidAsync("setTheme", theme);
    }

    private async Task OnDensityChanged(object? value)
    {
        if (value?.ToString() is not { Length: > 0 } density)
            return;

        _density = density;
        if (_appearance is not null)
            await _appearance.InvokeVoidAsync("setDensity", density);
    }

    private async Task SaveProfileAsync()
    {
        _saving = true;
        _profileSaved = false;
        _profileError = null;
        try
        {
            HttpResponseMessage resp = await Http.PutAsJsonAsync(
                "/api/account/profile",
                new UpdateProfileRequest(_form.Locale),
                AppJsonContext.Default.UpdateProfileRequest);

            if (resp.IsSuccessStatusCode)
                _profileSaved = true;
            else
                _profileError = $"Couldn't save your profile ({(int)resp.StatusCode}). Try again.";
        }
        catch
        {
            _profileError = "Couldn't reach the server. Your profile wasn't saved.";
        }
        finally { _saving = false; }
    }

    /// <summary>
    /// FR-031: confirm before irreversible deletion. This previously read
    /// `await Task.FromResult(true)` — the dialog was never shown and the button
    /// deleted the account on the first click.
    /// </summary>
    private async Task ConfirmDeleteAsync()
    {
        bool? confirmed = await DialogService.Confirm(
            "This permanently deletes your account, every route you monitor, and all of their history. This cannot be undone.",
            "Delete account?",
            new ConfirmOptions { OkButtonText = "Delete my account", CancelButtonText = "Keep my account" });

        if (confirmed != true)
            return;

        _deleting = true;
        try
        {
            HttpResponseMessage resp = await Http.DeleteAsync("/api/account/");
            if (resp.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/login", forceLoad: true);
                return;
            }

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Account not deleted",
                Detail = $"The server refused the request ({(int)resp.StatusCode}). Nothing was removed.",
                Duration = 6000
            });
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Account not deleted",
                Detail = "Couldn't reach the server. Nothing was removed.",
                Duration = 6000
            });
        }
        finally { _deleting = false; }
    }

    /// <summary>Shape returned by <c>getAppearance</c> in pt-appearance.js.</summary>
    private sealed record AppearanceState(
        string Theme,
        string Density,
        bool PrefersContrast,
        bool PrefersReducedMotion);

    public async ValueTask DisposeAsync()
    {
        if (_appearance is not null)
        {
            try { await _appearance.DisposeAsync(); } catch { /* page tearing down */ }
        }
    }
}
