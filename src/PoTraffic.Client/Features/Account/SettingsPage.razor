@page "/account/settings"
@attribute [Authorize]
@implements IAsyncDisposable
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject NotificationService NotificationService
@inject PoTraffic.Client.Infrastructure.PwaService Pwa
@inject PoTraffic.Client.Infrastructure.FxService Fx
@using PoTraffic.Client.Infrastructure

<PageTitle>Account Settings</PageTitle>

<PageHeader Title="Account settings"
            Subtitle="Profile, appearance, and what this account is costing."
            BackHref="/dashboard" BackLabel="Commutes" />

@*  Six sections, one long scroll. The index on the left is sticky, so on a wide
    screen "where am I and what else is here" is answered without scrolling, and
    a jump is one click. It is display:none below 1024px — a phone has no column
    to spare and the scroll is short enough to flick.                            *@
<div class="pt-settings-layout">
    <nav class="pt-settings-index" aria-label="Settings sections">
        <a href="#settings-profile">Profile</a>
        <a href="#settings-appearance">Appearance</a>
        <a href="#settings-effects">Effects &amp; sound</a>
        <a href="#settings-install">Install</a>
        <a href="#settings-limits">Limits &amp; cost</a>
        <a href="#settings-delete" class="pt-settings-index-danger">Delete account</a>
    </nav>

<RadzenCard class="pt-p-6">
    @* Four tabs held about six controls between them, which cost a click and hid
       two thirds of the page to save no scrolling. They are sections now. *@
    <section class="pt-settings-section" id="settings-profile">
        <RadzenText TextStyle="TextStyle.H3" class="pt-mb-2 pt-section-heading">Profile</RadzenText>
                @if (_loading)
                {
                    <div class="pt-skeleton-stack pt-mt-4">
                        <div class="pt-skeleton-line lg w-40"></div>
                        <div class="pt-skeleton-line w-70"></div>
                        <div class="pt-skeleton-line lg w-40"></div>
                        <div class="pt-skeleton-line w-70"></div>
                        <div class="pt-skeleton-line w-30"></div>
                    </div>
                }
                else if (_profile is not null)
                {
                    @* The form is a RadzenTemplateForm rather than loose inputs, so the
                       locale rule is enforced before the request goes out and failures
                       land on the field instead of arriving as a server round-trip. *@
                    <RadzenTemplateForm TItem="ProfileForm" Data="@_form" Submit="@SaveProfileAsync">
                        <RadzenStack Gap="1rem" class="pt-mt-4">
                            <RadzenFormField Text="Email">
                                <ChildContent>
                                    <RadzenTextBox Value="@_profile.Email" ReadOnly="true" aria-label="Email address" />
                                </ChildContent>
                                <Helper>
                                    <RadzenText TextStyle="TextStyle.Caption">
                                        Your sign-in address can't be changed here.
                                    </RadzenText>
                                </Helper>
                            </RadzenFormField>

                            <RadzenFormField Text="Locale">
                                <ChildContent>
                                    @* Whitelist mirrors the server validator — no freeform text
                                       that can only fail once it reaches the API. *@
                                    <RadzenDropDown Name="Locale" @bind-Value="_form.Locale"
                                                    Data="@ValidLocales" class="pt-settings-full"
                                                    AllowFiltering="true" AllowClear="false" />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="Locale"
                                                             Text="Choose the locale your times should display in." />
                                </Helper>
                            </RadzenFormField>

                            <div>
                                <RadzenButton ButtonType="ButtonType.Submit" Text="Save"
                                              ButtonStyle="ButtonStyle.Primary" IsBusy="@_saving" />
                                @* Discard unsaved locale change. Disabled when nothing has changed
                                   so the affordance only appears when it would actually undo
                                   something — a Cancel that's always live teaches users it doesn't
                                   cancel anything. *@
                                <RadzenButton ButtonType="ButtonType.Button" Text="Cancel"
                                              ButtonStyle="ButtonStyle.Light" class="pt-ml-2"
                                              Disabled="@(!_formDirty)"
                                              Click="@DiscardProfileChanges" />
                            </div>

                            @if (_profileSaved)
                            {
                                <RadzenAlert AlertStyle="AlertStyle.Success" AllowClose="false"
                                             Text="Profile updated." class="pt-enter" />
                            }
                            @if (_profileError is not null)
                            {
                                <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false"
                                             Text="@_profileError" class="pt-enter" />
                            }
                        </RadzenStack>
                    </RadzenTemplateForm>
                }
    </section>

    <section class="pt-settings-section" id="settings-appearance">
        <RadzenText TextStyle="TextStyle.H3" class="pt-mb-2 pt-section-heading">Appearance</RadzenText>
                <RadzenStack Gap="1.5rem" class="pt-mt-4">
                    @* Both pickers were hand-rolled <button role="radio"> grids with their
                       own aria-checked plumbing and their own emoji glyphs — a segmented
                       control reimplemented twice, next to a RadzenDropDown that already
                       proves the app uses Radzen form controls. RadzenSelectBar IS this
                       control: it owns the roving-tabindex keyboard model, the selected
                       state and the theming, and it takes Material icon names. *@
                    <div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="pt-mb-1">Theme</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" class="pt-mb-2 pt-settings-meta">
                            System follows your device setting and switches with it.
                        </RadzenText>
                        <RadzenSelectBar TValue="string" Value="@_theme" Change="@OnThemeChanged"
                                         Size="ButtonSize.Medium" aria-label="Theme">
                            <Items>
                                <RadzenSelectBarItem Value="@("system")" Text="System" Icon="computer" />
                                <RadzenSelectBarItem Value="@("light")" Text="Light" Icon="light_mode" />
                                <RadzenSelectBarItem Value="@("dark")" Text="Dark" Icon="dark_mode" />
                            </Items>
                        </RadzenSelectBar>
                    </div>

                    <div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="pt-mb-1">Density</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" class="pt-mb-2 pt-settings-meta">
                            Scales spacing across the whole app. Compact fits more on screen.
                        </RadzenText>
                        <RadzenSelectBar TValue="string" Value="@_density" Change="@OnDensityChanged"
                                         Size="ButtonSize.Medium" aria-label="Density">
                            <Items>
                                <RadzenSelectBarItem Value="@("compact")" Text="Compact" Icon="density_small" />
                                <RadzenSelectBarItem Value="@("normal")" Text="Normal" Icon="density_medium" />
                                <RadzenSelectBarItem Value="@("comfortable")" Text="Comfortable" Icon="density_large" />
                            </Items>
                        </RadzenSelectBar>
                    </div>

                    @* Neither of these is ours to set — the OS owns them. Reporting them
                       explains why the app already looks different rather than leaving
                       the user hunting for a switch that shouldn't exist. *@
                    @if (_prefersContrast || _prefersReducedMotion)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" class="pt-enter">
                            Following your system preferences:
                            @if (_prefersContrast)
                            {
                                <text>higher contrast</text>
                            }
                            @if (_prefersContrast && _prefersReducedMotion)
                            {
                                <text> and </text>
                            }
                            @if (_prefersReducedMotion)
                            {
                                <text>reduced motion</text>
                            }.
                        </RadzenAlert>
                    }
                </RadzenStack>
    </section>

    <section class="pt-settings-section" id="settings-effects">
        <RadzenText TextStyle="TextStyle.H3" class="pt-mb-2 pt-section-heading">Effects &amp; sound</RadzenText>

        <RadzenStack Gap="1.5rem" class="pt-mt-4">
            <div>
                <RadzenText TextStyle="TextStyle.Subtitle2" class="pt-mb-1">Motion</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="pt-mb-2 pt-settings-meta">
                    Full adds the moving background, the traffic flow on the map, and
                    animated charts. Still keeps the colours but stops the movement.
                </RadzenText>
                <RadzenSelectBar TValue="MotionLevel" Value="@Fx.Motion" Change="@OnMotionChanged"
                                 Size="ButtonSize.Medium" aria-label="Motion">
                    <Items>
                        <RadzenSelectBarItem Value="@MotionLevel.Full" Text="Full" Icon="auto_awesome" />
                        <RadzenSelectBarItem Value="@MotionLevel.Reduced" Text="Still" Icon="motion_photos_off" />
                        <RadzenSelectBarItem Value="@MotionLevel.Off" Text="Off" Icon="block" />
                    </Items>
                </RadzenSelectBar>

                @if (_prefersReducedMotion && Fx.Motion != MotionLevel.Off)
                {
                    @* The OS preference is a floor: it can force motion down but this
                       setting can never force it back up. Saying so beats leaving the
                       user to wonder why "Full" did not look full. *@
                    <RadzenText TextStyle="TextStyle.Caption" class="pt-mt-2 pt-settings-meta">
                        Your device asks for reduced motion, so animation stays off
                        whatever is picked here.
                    </RadzenText>
                }
            </div>

            <div>
                <RadzenText TextStyle="TextStyle.Subtitle2" class="pt-mb-1">Sound</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="pt-mb-2 pt-settings-meta">
                    Short musical cues when a check finishes or something is saved.
                    Nothing is downloaded — the sounds are generated in the browser.
                </RadzenText>
                <RadzenSwitch Value="@Fx.SoundEnabled" Change="@OnSoundChanged" aria-label="Sound effects" />

                @if (Fx.SoundEnabled)
                {
                    <div class="pt-volume-row pt-mt-3">
                        <PtIcon Name="volume_down" Size="sm" />
                        <RadzenSlider TValue="double" Value="@Fx.Volume" Min="0" Max="1" Step="0.05"
                                      Change="@OnVolumeChanged" aria-label="Volume" class="pt-volume-slider" />
                        <PtIcon Name="volume_up" Size="sm" />
                        <RadzenButton Text="Test" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="@TestSoundAsync" />
                    </div>
                }
            </div>
        </RadzenStack>
    </section>

    <section class="pt-settings-section" id="settings-install">
        <RadzenText TextStyle="TextStyle.H3" class="pt-mb-2 pt-section-heading">Install on this device</RadzenText>
        <RadzenText TextStyle="TextStyle.Caption" class="pt-mb-3 pt-settings-meta">
            Installing adds PoTraffic to your home screen and keeps the last data it loaded
            available when you have no signal.
        </RadzenText>

        @if (!Pwa.Supported)
        {
            @* Private windows and insecure origins have no service worker at all. Saying so
               beats an Install button that silently does nothing when tapped. *@
            <RadzenText TextStyle="TextStyle.Body2" class="pt-settings-meta">
                This browser can't install web apps. Everything else works normally.
            </RadzenText>
        }
        else if (Pwa.Installed)
        {
            <RadzenText TextStyle="TextStyle.Body2" class="pt-settings-meta">
                Installed — you're running the app version right now.
            </RadzenText>
        }
        else if (Pwa.CanInstall)
        {
            <RadzenButton Text="Install PoTraffic" Icon="install_mobile"
                          ButtonStyle="ButtonStyle.Primary" Click="InstallAsync" />
        }
        else
        {
            @* Chrome and Edge only offer beforeinstallprompt once their own heuristics are
               satisfied, and iOS Safari never fires it. Neither case is an error, so the
               manual route is spelled out rather than hidden behind a dead button. *@
            <RadzenText TextStyle="TextStyle.Body2" class="pt-settings-meta">
                Use your browser's menu to add PoTraffic to your home screen.
                On iPhone: Share, then "Add to Home Screen".
            </RadzenText>
        }
    </section>

    <section class="pt-settings-section" id="settings-limits">
        <RadzenText TextStyle="TextStyle.H3" class="pt-mb-2 pt-section-heading">Monitoring limits &amp; cost</RadzenText>
                @if (_loading)
                {
                    <div class="pt-skeleton-stack pt-mt-4">
                        <div class="pt-skeleton-line w-50"></div>
                        <div class="pt-skeleton-line lg w-70"></div>
                        <div class="pt-skeleton-line w-40"></div>
                    </div>
                }
                else if (_quota is not null)
                {
                    @* Moved here from the dashboard status bar, where a quota ring, a
                       running spend figure and a reset time sat between the user and
                       the departure times they came for. This is where someone goes
                       when they actually want to know. *@
                    <RadzenStack Gap="1rem" class="pt-mt-4">
                        <RadzenText>
                            Used today: <strong>@_quota.UsedToday of @_quota.DailyLimit</strong> monitoring sessions
                            (@QuotaPercent.ToString("F0")%)
                        </RadzenText>
                        @* ShowValue="false" because the line above already prints the
                           percentage — Radzen's overlay text was drawing a second "20%"
                           on top of the bar that doubled the same number. *@
                        <RadzenProgressBar Value="@QuotaPercent" ShowValue="false"
                                           ProgressBarStyle="@QuotaStyle"
                                           aria-label="Daily quota used" />
                        <RadzenText class="pt-settings-meta">
                            Resets at @_quota.ResetsAtUtc.ToLocalTime().ToString("HH:mm").
                            @if (_quota.PollsToday > 0)
                            {
                                <text>
                                    @_quota.PollsToday traffic look-ups so far today,
                                    about @_quota.EstimatedCostTodayUsd.ToString("C3") —
                                    roughly @_quota.ProjectedMonthlyCostUsd.ToString("C2") a month at this rate.
                                </text>
                            }
                        </RadzenText>
                    </RadzenStack>
                }
    </section>

    <section class="pt-settings-section pt-settings-danger" id="settings-delete">
        <RadzenText TextStyle="TextStyle.H3" class="pt-mb-2 pt-section-heading">Delete account</RadzenText>
                <RadzenStack Gap="1rem" class="pt-mt-4">
                    <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false"
                                 Text="Deleting your account is permanent and cannot be undone. All your routes, history, and data will be removed (GDPR Art. 17)." />

                    @* Two-stage destructive: the first tap reveals a typed-confirmation
                       input + a "Confirm delete" button. The dialog kept being closed by
                       accident in user tests; this keeps the affordance on the page, in
                       the same scrolling position, and lets us add the typed-confirmation
                       guard before the second tap reaches the API. *@
                    @if (!_confirmDeleteArmed)
                    {
                        <div>
                            <RadzenButton Text="Delete My Account" ButtonStyle="ButtonStyle.Danger"
                                          Click="@ArmDeleteConfirmation" />
                        </div>
                    }
                    else
                    {
                        <div class="pt-confirm-delete">
                            <RadzenText TextStyle="TextStyle.Caption" class="pt-mb-1">
                                Type <strong>DELETE</strong> to confirm.
                            </RadzenText>
                            <RadzenTextBox @bind-Value="_confirmDeletePhrase" class="pt-w-100 pt-mb-2"
                                           Placeholder="DELETE" autocomplete="off" />
                            <div>
                                <RadzenButton Text="Confirm delete" ButtonStyle="ButtonStyle.Danger"
                                              Disabled="@(_confirmDeletePhrase != "DELETE" || _deleting)"
                                              IsBusy="@_deleting"
                                              Click="@ConfirmDeleteAsync" />
                                <RadzenButton Text="Keep my account" ButtonStyle="ButtonStyle.Light"
                                              class="pt-ml-2"
                                              Click="@DisarmDeleteConfirmation" />
                            </div>
                        </div>
                    }
                </RadzenStack>
    </section>
</RadzenCard>
</div>

@code {
    /// <summary>
    /// The install section reflects browser state that can change after the page has
    /// rendered — the prompt event may not have fired yet when Settings first paints.
    /// </summary>
    private void OnPwaStateChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Bound by the profile form so validation has a model to work against.</summary>
    private sealed class ProfileForm
    {
        public string Locale { get; set; } = string.Empty;
    }

    // Whitelist matches the server-side validator.
    private static readonly List<string> ValidLocales = ["en-IE", "en-GB", "en-US", "de-DE", "fr-FR"];

    private ProfileDto? _profile;
    private QuotaDto? _quota;
    private readonly ProfileForm _form = new();
    private bool _loading = true;
    private bool _saving;
    private bool _deleting;
    private bool _profileSaved;
    private string? _profileError;
    private string _originalLocale = string.Empty;
    private bool _confirmDeleteArmed;
    private string _confirmDeletePhrase = string.Empty;

    /// <summary>
    /// True when the bound locale differs from what the profile was loaded with.
    /// Cancel is gated on this so the button only appears when it would
    /// actually undo something — a permanently-enabled Cancel teaches users that
    /// "Cancel" cancels nothing.
    /// </summary>
    private bool _formDirty => _form.Locale != _originalLocale;

    private string _theme = "system";
    private string _density = "normal";
    private bool _prefersContrast;
    private bool _prefersReducedMotion;
    private IJSObjectReference? _appearance;

    private double QuotaPercent =>
        _quota is { DailyLimit: > 0 } q ? Math.Min(100, (double)q.UsedToday / q.DailyLimit * 100) : 0;

    private ProgressBarStyle QuotaStyle => QuotaPercent switch
    {
        >= 90 => ProgressBarStyle.Danger,
        >= 70 => ProgressBarStyle.Warning,
        _ => ProgressBarStyle.Primary
    };

    protected override async Task OnInitializedAsync()
    {
        Pwa.StateChanged += OnPwaStateChanged;

        try
        {
            _profile = await Http.GetFromJsonAsync("/api/account/profile", AppJsonContext.Default.ProfileDto);
            _quota = await Http.GetFromJsonAsync("/api/account/quota", AppJsonContext.Default.QuotaDto);
            _form.Locale = _profile?.Locale ?? string.Empty;
            _originalLocale = _form.Locale;
        }
        catch { /* handled by null guards */ }
        finally { _loading = false; }
    }

    /// <summary>Reverts unsaved locale edits back to the server-known value.</summary>
    private void DiscardProfileChanges()
    {
        _form.Locale = _originalLocale;
        _profileError = null;
    }

    /// <summary>Reveals the typed-confirmation guard before allowing delete.</summary>
    private void ArmDeleteConfirmation()
    {
        _confirmDeleteArmed = true;
        _confirmDeletePhrase = string.Empty;
    }

    /// <summary>Closes the typed-confirmation guard without deleting.</summary>
    private void DisarmDeleteConfirmation()
    {
        _confirmDeleteArmed = false;
        _confirmDeletePhrase = string.Empty;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _appearance = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pt-appearance.js");
            AppearanceState state = await _appearance.InvokeAsync<AppearanceState>("getAppearance");
            _theme = state.Theme;
            _density = state.Density;
            _prefersContrast = state.PrefersContrast;
            _prefersReducedMotion = state.PrefersReducedMotion;
            StateHasChanged();
        }
        catch
        {
            // No interop is a degraded settings panel, not a broken page — the
            // controls simply show the defaults.
        }
    }

    /// <summary>
    /// RadzenSelectBar's Change hands back the item's Value boxed as object. A null can
    /// only mean a deselect, which this bar does not offer — guard anyway rather than
    /// stamping "" onto &lt;html data-theme&gt; and losing the theme entirely.
    /// </summary>
    private async Task OnThemeChanged(object? value)
    {
        if (value?.ToString() is not { Length: > 0 } theme)
            return;

        _theme = theme;
        if (_appearance is not null)
            await _appearance.InvokeVoidAsync("setTheme", theme);

        // The background wash resolves its palette from the design tokens, which have
        // just changed meaning. Without this it keeps the old theme's colours until
        // something else forces it to rebuild.
        await Fx.RefreshThemeAsync();
    }

    private async Task OnDensityChanged(object? value)
    {
        if (value?.ToString() is not { Length: > 0 } density)
            return;

        _density = density;
        if (_appearance is not null)
            await _appearance.InvokeVoidAsync("setDensity", density);
    }

    private async Task SaveProfileAsync()
    {
        _saving = true;
        _profileSaved = false;
        _profileError = null;
        try
        {
            HttpResponseMessage resp = await Http.PutAsJsonAsync(
                "/api/account/profile",
                new UpdateProfileRequest(_form.Locale),
                AppJsonContext.Default.UpdateProfileRequest);

            if (resp.IsSuccessStatusCode)
                _profileSaved = true;
            else
                _profileError = $"Couldn't save your profile ({(int)resp.StatusCode}). Try again.";
        }
        catch
        {
            _profileError = "Couldn't reach the server. Your profile wasn't saved.";
        }
        finally { _saving = false; }
    }

    /// <summary>
    /// FR-031: confirm before irreversible deletion. The typed-confirmation
    /// guard (see <see cref="ArmDeleteConfirmation"/>) sits between this and the
    /// destructive button so the API only sees a request after the user has
    /// both opted in twice and typed DELETE.
    /// </summary>
    private async Task ConfirmDeleteAsync()
    {
        if (_confirmDeletePhrase != "DELETE")
            return;

        _deleting = true;
        try
        {
            HttpResponseMessage resp = await Http.DeleteAsync("/api/account/");
            if (resp.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/login", forceLoad: true);
                return;
            }

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Account not deleted",
                Detail = $"The server refused the request ({(int)resp.StatusCode}). Nothing was removed.",
                Duration = 6000
            });
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Account not deleted",
                Detail = "Couldn't reach the server. Nothing was removed.",
                Duration = 6000
            });
        }
        finally { _deleting = false; }
    }

    /// <summary>Shape returned by <c>getAppearance</c> in pt-appearance.js.</summary>
    private sealed record AppearanceState(
        string Theme,
        string Density,
        bool PrefersContrast,
        bool PrefersReducedMotion);

    private async Task OnMotionChanged(MotionLevel level) => await Fx.SetMotionAsync(level);

    private async Task OnSoundChanged(bool enabled)
    {
        await Fx.SetSoundAsync(enabled);
        // Turning sound ON from a click is the one moment the browser will let us
        // unlock the audio context, so the very next cue is audible rather than the
        // one after it.
        if (enabled)
        {
            await Fx.UnlockAudioAsync();
            await Fx.PlayAsync("save");
        }
    }

    private async Task OnVolumeChanged(double volume)
    {
        await Fx.SetVolumeAsync(volume);
        await Fx.UnlockAudioAsync();
        // Play at the new level as it is dragged — a volume slider with no audible
        // feedback is a slider you have to guess at.
        await Fx.PlayAsync("click");
    }

    private async Task TestSoundAsync()
    {
        await Fx.UnlockAudioAsync();
        await Fx.PlayAsync("success");
    }

    /// <summary>Shows the browser's own install dialog.</summary>
    private async Task InstallAsync()
    {
        if (await Pwa.InstallAsync())
            NotificationService.Notify(NotificationSeverity.Success, "Installed",
                "PoTraffic has been added to this device.");
    }

    public async ValueTask DisposeAsync()
    {
        Pwa.StateChanged -= OnPwaStateChanged;

        if (_appearance is not null)
        {
            try { await _appearance.DisposeAsync(); } catch { /* page tearing down */ }
        }
    }
}
