@page "/account/settings"
@attribute [Authorize]
@implements IAsyncDisposable
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject NotificationService NotificationService
@inject PoTraffic.Client.Infrastructure.PwaService Pwa
@inject PoTraffic.Client.Infrastructure.FxService Fx
@using PoTraffic.Client.Infrastructure

<PageTitle>Settings — PoTraffic</PageTitle>

<PageHeader Title="Account settings" BackHref="/dashboard" BackLabel="Commutes" />

@*  Four sections, one short scroll. There used to be eight — for about eight
    controls — behind a sticky section index; Motion had its own section with the
    word "Motion" as both its heading and its only sub-heading. Grouped by what
    they are about, the page is short enough that it needs no index. *@
<RadzenCard class="pt-card-pad">
    <section class="pt-settings-section">
        <RadzenText TextStyle="TextStyle.H3" class="pt-mb-3 pt-section-heading">Appearance</RadzenText>
        @* RadzenSelectBar owns the roving-tabindex keyboard model, the selected state
           and the theming; the three pickers sit side by side where there is room. *@
        <div class="pt-settings-grid">
            <div>
                <span class="pt-settings-field-label">Theme</span>
                <RadzenSelectBar TValue="string" Value="@_theme" Change="@OnThemeChanged"
                                 Size="ButtonSize.Small" aria-label="Theme">
                    <Items>
                        <RadzenSelectBarItem Value="@("system")" Text="System" Icon="computer" />
                        <RadzenSelectBarItem Value="@("light")" Text="Light" Icon="light_mode" />
                        <RadzenSelectBarItem Value="@("dark")" Text="Dark" Icon="dark_mode" />
                    </Items>
                </RadzenSelectBar>
            </div>
            <div>
                <span class="pt-settings-field-label">Density</span>
                <RadzenSelectBar TValue="string" Value="@_density" Change="@OnDensityChanged"
                                 Size="ButtonSize.Small" aria-label="Density">
                    <Items>
                        <RadzenSelectBarItem Value="@("compact")" Text="Compact" Icon="density_small" />
                        <RadzenSelectBarItem Value="@("normal")" Text="Normal" Icon="density_medium" />
                        <RadzenSelectBarItem Value="@("comfortable")" Text="Comfortable" Icon="density_large" />
                    </Items>
                </RadzenSelectBar>
            </div>
            <div>
                @* Full animates the map's traffic flow and the charts; Still keeps the
                   colours but stops the movement. *@
                <span class="pt-settings-field-label">Motion</span>
                <RadzenSelectBar TValue="MotionLevel" Value="@Fx.Motion" Change="@OnMotionChanged"
                                 Size="ButtonSize.Small" aria-label="Motion">
                    <Items>
                        <RadzenSelectBarItem Value="@MotionLevel.Full" Text="Full" Icon="auto_awesome" />
                        <RadzenSelectBarItem Value="@MotionLevel.Reduced" Text="Still" Icon="motion_photos_off" />
                        <RadzenSelectBarItem Value="@MotionLevel.Off" Text="Off" Icon="block" />
                    </Items>
                </RadzenSelectBar>
            </div>
        </div>

        @* Neither of these is ours to set — the OS owns them. Reporting them explains
           why the app already looks different. The OS motion preference is a floor:
           this setting can never force animation back up past it. *@
        @if (_prefersContrast || _prefersReducedMotion)
        {
            <p class="pt-settings-meta pt-mt-3">Following your device: @DevicePreferences.</p>
        }
    </section>

    <section class="pt-settings-section">
        <RadzenText TextStyle="TextStyle.H3" class="pt-mb-3 pt-section-heading">This device</RadzenText>
        <div class="pt-settings-grid">
            <div>
                <span class="pt-settings-field-label">Notifications</span>
                <p class="pt-settings-meta">
                    Heavier-than-usual traffic, reroutes and time-to-leave — even with the app closed.
                </p>
                @switch (_pushState)
                {
                    case "unsupported":
                        <p class="pt-settings-meta">
                            This browser can't receive notifications. On iPhone, install PoTraffic to
                            your home screen first, then turn them on from the installed app.
                        </p>
                        break;
                    case "denied":
                        <p class="pt-settings-meta">
                            Blocked for this site. Allow them in your browser's site settings, then come back here.
                        </p>
                        break;
                    case "subscribed":
                        <RadzenButton Text="Turn off notifications" Icon="notifications_off" Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Light" Click="DisablePushAsync" IsBusy="_pushBusy" />
                        break;
                    case "off":
                        <RadzenButton Text="Turn on notifications" Icon="notifications_active" Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Primary" Click="EnablePushAsync" IsBusy="_pushBusy" />
                        break;
                }
            </div>
            <div>
                <span class="pt-settings-field-label">Install</span>
                <p class="pt-settings-meta">
                    Adds PoTraffic to your home screen and keeps its last data available offline.
                </p>
                @if (!Pwa.Supported)
                {
                    @* Private windows and insecure origins have no service worker at all. *@
                    <p class="pt-settings-meta">This browser can't install web apps. Everything else works normally.</p>
                }
                else if (Pwa.Installed)
                {
                    <p class="pt-settings-meta">Installed — you're running the app version right now.</p>
                }
                else if (Pwa.CanInstall)
                {
                    <RadzenButton Text="Install PoTraffic" Icon="install_mobile" Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Primary" Click="InstallAsync" />
                }
                else
                {
                    @* Chrome and Edge only offer beforeinstallprompt once their own heuristics are
                       satisfied, and iOS Safari never fires it — so the manual route is spelled out. *@
                    <p class="pt-settings-meta">
                        Use your browser's menu to add PoTraffic to your home screen.
                        On iPhone: Share, then "Add to Home Screen".
                    </p>
                }
            </div>
        </div>
    </section>

    <section class="pt-settings-section">
        <RadzenText TextStyle="TextStyle.H3" class="pt-mb-3 pt-section-heading">Profile &amp; usage</RadzenText>
        @if (_loading)
        {
            <div class="pt-skeleton-stack">
                <div class="pt-skeleton-line w-50"></div>
                <div class="pt-skeleton-line lg w-70"></div>
                <div class="pt-skeleton-line w-40"></div>
            </div>
        }
        else
        {
            <div class="pt-settings-grid">
                @if (_profile is not null)
                {
                    <div>
                        @* The sign-in address can't be changed here, so it is text, not a
                           read-only box that looks editable. *@
                        <span class="pt-settings-field-label">Signed in as</span>
                        <p class="pt-settings-value">@_profile.Email</p>

                        <span class="pt-settings-field-label">Locale</span>
                        @* Saves on change, like theme and density above — this was the one
                           setting on the page behind a Save/Cancel pair. The whitelist mirrors
                           the server validator, so there is no freeform value to reject. *@
                        <RadzenDropDown TValue="string" Value="@_locale" Data="@ValidLocales"
                                        Change="@(v => SaveLocaleAsync(v as string))"
                                        AllowFiltering="true" AllowClear="false" Disabled="_saving"
                                        class="pt-settings-full" aria-label="Locale" />
                        @if (_profileError is not null)
                        {
                            <div class="pt-field-error" role="alert">@_profileError</div>
                        }
                    </div>
                }
                @if (_quota is not null)
                {
                    <div>
                        <span class="pt-settings-field-label">Monitoring today</span>
                        <p class="pt-settings-value">
                            @_quota.UsedToday of @_quota.DailyLimit sessions (@QuotaPercent.ToString("F0")%)
                        </p>
                        <RadzenProgressBar Value="@QuotaPercent" ShowValue="false"
                                           ProgressBarStyle="@QuotaStyle" aria-label="Daily quota used" />
                        <p class="pt-settings-meta pt-mt-2">
                            Resets at @_quota.ResetsAtUtc.ToLocalTime().ToString("HH:mm").
                            @if (_quota.PollsToday > 0)
                            {
                                <text>
                                    @_quota.PollsToday look-ups so far, about @_quota.EstimatedCostTodayUsd.ToString("C3") —
                                    roughly @_quota.ProjectedMonthlyCostUsd.ToString("C2") a month at this rate.
                                </text>
                            }
                        </p>
                    </div>
                }
            </div>
        }
    </section>

    <section class="pt-settings-section pt-settings-danger">
        <RadzenText TextStyle="TextStyle.H3" class="pt-mb-3 pt-section-heading">Your data</RadzenText>
        <p class="pt-settings-meta">
            Everything PoTraffic stores about you — routes, schedules, every recorded trip and
            alert — as one JSON file. Deleting your account removes all of it permanently
            (GDPR Art. 17); it cannot be undone.
        </p>
        <div class="pt-flex pt-wrap pt-gap-2">
            @* A full navigation, not fetch: the server answers with an attachment, so the
               browser saves the file and the page stays where it is. *@
            <RadzenButton Text="Download my data" Icon="download" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                          Click="@(() => Nav.NavigateTo("/api/account/export", forceLoad: true))" />

            @* Two-stage destructive: the first tap reveals a typed-confirmation input. The
               dialog it replaced kept being closed by accident in user tests. *@
            @if (!_confirmDeleteArmed)
            {
                <RadzenButton Text="Delete my account" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                              Click="@ArmDeleteConfirmation" />
            }
        </div>
        @if (_confirmDeleteArmed)
        {
            <div class="pt-confirm-delete pt-mt-3">
                <p class="pt-settings-meta">Type <strong>DELETE</strong> to confirm.</p>
                <RadzenTextBox @bind-Value="_confirmDeletePhrase" class="pt-w-100 pt-mb-2"
                               Placeholder="DELETE" autocomplete="off" />
                <div>
                    <RadzenButton Text="Confirm delete" ButtonStyle="ButtonStyle.Danger"
                                  Disabled="@(_confirmDeletePhrase != "DELETE" || _deleting)"
                                  IsBusy="@_deleting"
                                  Click="@ConfirmDeleteAsync" />
                    <RadzenButton Text="Keep my account" ButtonStyle="ButtonStyle.Light"
                                  class="pt-ml-2"
                                  Click="@DisarmDeleteConfirmation" />
                </div>
            </div>
        }
    </section>
</RadzenCard>

@code {
    /// <summary>
    /// The install section reflects browser state that can change after the page has
    /// rendered — the prompt event may not have fired yet when Settings first paints.
    /// </summary>
    private void OnPwaStateChanged() => InvokeAsync(StateHasChanged);

    // Whitelist matches the server-side validator.
    private static readonly List<string> ValidLocales = ["en-IE", "en-GB", "en-US", "de-DE", "fr-FR"];

    private ProfileDto? _profile;
    private QuotaDto? _quota;
    private string _locale = string.Empty;
    private bool _loading = true;
    private bool _saving;
    private bool _deleting;
    private string? _profileError;
    private bool _confirmDeleteArmed;
    private string _confirmDeletePhrase = string.Empty;

    private string _theme = "system";
    private string _density = "normal";
    private bool _prefersContrast;
    private bool _prefersReducedMotion;
    private IJSObjectReference? _appearance;

    private double QuotaPercent =>
        _quota is { DailyLimit: > 0 } q ? Math.Min(100, (double)q.UsedToday / q.DailyLimit * 100) : 0;

    private ProgressBarStyle QuotaStyle => QuotaPercent switch
    {
        >= 90 => ProgressBarStyle.Danger,
        >= 70 => ProgressBarStyle.Warning,
        _ => ProgressBarStyle.Primary
    };

    protected override async Task OnInitializedAsync()
    {
        Pwa.StateChanged += OnPwaStateChanged;
        _pushState = await Pwa.GetPushStateAsync();

        try
        {
            _profile = await Http.GetFromJsonAsync("/api/account/profile", AppJsonContext.Default.ProfileDto);
            _quota = await Http.GetFromJsonAsync("/api/account/quota", AppJsonContext.Default.QuotaDto);
            _locale = _profile?.Locale ?? string.Empty;
        }
        catch { /* handled by null guards */ }
        finally { _loading = false; }
    }

    /// <summary>Reveals the typed-confirmation guard before allowing delete.</summary>
    private void ArmDeleteConfirmation()
    {
        _confirmDeleteArmed = true;
        _confirmDeletePhrase = string.Empty;
    }

    /// <summary>Closes the typed-confirmation guard without deleting.</summary>
    private void DisarmDeleteConfirmation()
    {
        _confirmDeleteArmed = false;
        _confirmDeletePhrase = string.Empty;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _appearance = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pt-appearance.js");
            AppearanceState state = await _appearance.InvokeAsync<AppearanceState>("getAppearance");
            _theme = state.Theme;
            _density = state.Density;
            _prefersContrast = state.PrefersContrast;
            _prefersReducedMotion = state.PrefersReducedMotion;
            StateHasChanged();
        }
        catch
        {
            // No interop is a degraded settings panel, not a broken page — the
            // controls simply show the defaults.
        }
    }

    /// <summary>
    /// RadzenSelectBar's Change hands back the item's Value boxed as object. A null can
    /// only mean a deselect, which this bar does not offer — guard anyway rather than
    /// stamping "" onto &lt;html data-theme&gt; and losing the theme entirely.
    /// </summary>
    private async Task OnThemeChanged(object? value)
    {
        if (value?.ToString() is not { Length: > 0 } theme)
            return;

        _theme = theme;
        if (_appearance is not null)
            await _appearance.InvokeVoidAsync("setTheme", theme);
    }

    private async Task OnDensityChanged(object? value)
    {
        if (value?.ToString() is not { Length: > 0 } density)
            return;

        _density = density;
        if (_appearance is not null)
            await _appearance.InvokeVoidAsync("setDensity", density);
    }

    /// <summary>"higher contrast and reduced motion (…)" — whichever the OS is asking for.</summary>
    private string DevicePreferences => string.Join(" and ", new[]
    {
        _prefersContrast ? "higher contrast" : null,
        _prefersReducedMotion ? "reduced motion, so animation stays off whatever Motion is set to" : null,
    }.Where(p => p is not null));

    /// <summary>Saves the locale the moment it is picked; a failure puts the old one back.</summary>
    private async Task SaveLocaleAsync(string? locale)
    {
        if (string.IsNullOrEmpty(locale) || locale == _profile?.Locale)
            return;

        string previous = _locale;
        _locale = locale;
        _saving = true;
        _profileError = null;
        try
        {
            HttpResponseMessage resp = await Http.PutAsJsonAsync(
                "/api/account/profile",
                new UpdateProfileRequest(locale),
                AppJsonContext.Default.UpdateProfileRequest);

            if (resp.IsSuccessStatusCode)
            {
                _profile = _profile! with { Locale = locale };
                NotificationService.Notify(NotificationSeverity.Success, "Saved", $"Locale set to {locale}.");
                return;
            }
            _profileError = $"Couldn't save the locale ({(int)resp.StatusCode}). Try again.";
        }
        catch
        {
            _profileError = "Couldn't reach the server. The locale wasn't saved.";
        }
        finally { _saving = false; }

        _locale = previous;
    }

    /// <summary>
    /// FR-031: confirm before irreversible deletion. The typed-confirmation
    /// guard (see <see cref="ArmDeleteConfirmation"/>) sits between this and the
    /// destructive button so the API only sees a request after the user has
    /// both opted in twice and typed DELETE.
    /// </summary>
    private async Task ConfirmDeleteAsync()
    {
        if (_confirmDeletePhrase != "DELETE")
            return;

        _deleting = true;
        try
        {
            HttpResponseMessage resp = await Http.DeleteAsync("/api/account/");
            if (resp.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/login", forceLoad: true);
                return;
            }

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Account not deleted",
                Detail = $"The server refused the request ({(int)resp.StatusCode}). Nothing was removed.",
                Duration = 6000
            });
        }
        catch
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Account not deleted",
                Detail = "Couldn't reach the server. Nothing was removed.",
                Duration = 6000
            });
        }
        finally { _deleting = false; }
    }

    /// <summary>Shape returned by <c>getAppearance</c> in pt-appearance.js.</summary>
    private sealed record AppearanceState(
        string Theme,
        string Density,
        bool PrefersContrast,
        bool PrefersReducedMotion);

    private async Task OnMotionChanged(MotionLevel level) => await Fx.SetMotionAsync(level);

    private string? _pushState;
    private bool _pushBusy;

    private async Task EnablePushAsync()
    {
        _pushBusy = true;
        try
        {
            PushKeyResponse? key = await Http.GetFromJsonAsync("/api/push/key", AppJsonContext.Default.PushKeyResponse);
            string[]? sub = key is null ? null : await Pwa.SubscribePushAsync(key.PublicKey);
            if (sub is [string endpoint, string p256dh, string auth])
            {
                HttpResponseMessage resp = await Http.PostAsJsonAsync("/api/push/subscriptions",
                    new PushSubscriptionRequest(endpoint, p256dh, auth), AppJsonContext.Default.PushSubscriptionRequest);
                if (!resp.IsSuccessStatusCode)
                {
                    await Pwa.UnsubscribePushAsync();
                    NotificationService.Notify(NotificationSeverity.Error, "Notifications",
                        "This browser's push service isn't supported.");
                }
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or JSException)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Notifications", "Couldn't turn notifications on.");
        }
        finally
        {
            _pushState = await Pwa.GetPushStateAsync();
            _pushBusy = false;
        }
    }

    private async Task DisablePushAsync()
    {
        _pushBusy = true;
        try
        {
            if (await Pwa.UnsubscribePushAsync() is { } endpoint)
                await Http.PostAsJsonAsync("/api/push/unsubscribe",
                    new PushUnsubscribeRequest(endpoint), AppJsonContext.Default.PushUnsubscribeRequest);
        }
        catch (Exception ex) when (ex is HttpRequestException or JSException) { /* server prunes it on next send */ }
        finally
        {
            _pushState = await Pwa.GetPushStateAsync();
            _pushBusy = false;
        }
    }

    /// <summary>Shows the browser's own install dialog.</summary>
    private async Task InstallAsync()
    {
        if (await Pwa.InstallAsync())
            NotificationService.Notify(NotificationSeverity.Success, "Installed",
                "PoTraffic has been added to this device.");
    }

    public async ValueTask DisposeAsync()
    {
        Pwa.StateChanged -= OnPwaStateChanged;

        if (_appearance is not null)
        {
            try { await _appearance.DisposeAsync(); } catch { /* page tearing down */ }
        }
    }
}
