@* ──────────────────────────────────────────────────────────────────────
   RouteProbeStatus — "when was this route last checked, and when is the next one?"

   One chip and one button in the route page's header. This used to be three
   chips (page refresh state, last probe, cadence + count) plus a separate
   "Next sample in…" row in the answer block and a "N polls recorded today"
   alert in the schedule panel: the same two facts, four times. The page's own
   15-second refresh is not something a commuter acts on, so it is not shown.
   ────────────────────────────────────────────────────────────────────── *@

@using PoTraffic.Shared.Enums
@inject HttpClient Http
@inject NotificationService NotificationService

<div class="pt-probe-chips" aria-label="Route probe status">
    @{ NextSampleInfo next = NextSample; }
    <span class="pt-probe-cell">
        <span class="pt-probe-dot @(next.Live ? "pt-probe-dot-green" : "pt-probe-dot-amber")" aria-hidden="true"></span>
        <span class="pt-probe-label">
            @(LatestProbe is null ? "Not checked yet" : $"Checked {FormatAgo(LatestProbe.PolledAtDateTime)}")
            <span class="pt-probe-sep">·</span>
            @if (next.CountdownTargetUtc is { } target)
            {
                @* LiveCountdown's own text already starts "in …". *@
                <text>next&nbsp;</text>
                <LiveCountdown TargetUtc="target"
                               PeriodHint="@TimeSpan.FromMinutes(Session?.Schedule?.PollIntervalMinutes ?? 5)"
                               DueText="moments" />
            }
            else
            {
                @next.Detail
            }
        </span>
    </span>

    @* The only user-initiated way to spend money on this route. *@
    <RadzenButton Text="Check now" Icon="radar" ButtonStyle="ButtonStyle.Light" aria-label="Check now"
                  Size="ButtonSize.Small" IsBusy="_checking" Click="@CheckNowAsync" />
</div>

@code {
    /// <summary>Route this status belongs to. Drives the check-now POST.</summary>
    [Parameter, EditorRequired] public Guid RouteId { get; set; }

    /// <summary>Most recent PollRecord — its time is the last provider hit.</summary>
    [Parameter] public PollRecordDto? LatestProbe { get; set; }

    /// <summary>Today's active session; carries the server-computed poll schedule.</summary>
    [Parameter] public SessionDto? Session { get; set; }

    /// <summary>Fired after a successful check so the parent can refresh from the wire.</summary>
    [Parameter] public EventCallback OnProbeCompleted { get; set; }

    private bool _checking;

    private async Task CheckNowAsync()
    {
        _checking = true;
        try
        {
            if (await CheckNow.RunAsync(Http, NotificationService, RouteId))
                await OnProbeCompleted.InvokeAsync();
        }
        finally { _checking = false; }
    }

    /// <param name="Detail">Text when there is no countdown to run.</param>
    /// <param name="Live">Whether the window is currently sampling.</param>
    /// <param name="CountdownTargetUtc">When set, rendered as a self-ticking countdown.</param>
    private readonly record struct NextSampleInfo(
        string Detail,
        bool Live,
        DateTimeOffset? CountdownTargetUtc = null);

    // Every schedule decision — is the window open, when does it reopen, what cadence is
    // in force — comes from the server on SessionDto.Schedule. The client only formats it.
    private NextSampleInfo NextSample
    {
        get
        {
            if (Session is not { State: SessionState.Active } session)
                return new NextSampleInfo("waiting for the next window", Live: false);

            if (session.Schedule is not { } schedule)
                return new NextSampleInfo("no polling days scheduled", Live: false);

            // A Mon–Fri schedule viewed Saturday is days away, not "within 5 min".
            if (!schedule.WindowIsOpenNow)
            {
                if (schedule.NextWindowOpenUtc is not { } nextOpen)
                    return new NextSampleInfo("no polling days scheduled", Live: false);

                DateTime openLocal = nextOpen.ToLocalTime().DateTime;
                string when = openLocal.Date == DateTime.Now.Date ? "today" : openLocal.ToString("ddd");
                return new NextSampleInfo($"next {when} {openLocal:HH:mm}", Live: false);
            }

            if (schedule.NextPollExpectedUtc is not { } nextPoll)
                return new NextSampleInfo($"next within {schedule.PollIntervalMinutes} min", Live: true);

            return new NextSampleInfo(string.Empty, Live: true, CountdownTargetUtc: nextPoll);
        }
    }

    /// <summary>
    /// Minute resolution: the parent re-renders this every 15 seconds, so a seconds count
    /// would sit frozen between refreshes.
    /// </summary>
    private static string FormatAgo(DateTime whenLocal)
    {
        TimeSpan ago = DateTime.Now - whenLocal;
        if (ago < TimeSpan.FromMinutes(1)) return "just now";
        if (ago < TimeSpan.FromHours(1)) return $"{(int)ago.TotalMinutes} min ago";
        if (ago < TimeSpan.FromHours(6)) return $"{(int)ago.TotalHours} h ago";
        return whenLocal.ToString("MMM d, HH:mm");
    }
}
