@using PoTraffic.Shared.DTOs.Routes
@using PoTraffic.Shared.Enums
@using PoTraffic.Client.Infrastructure
@using PoTraffic.Client.Infrastructure.Http
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject ClientCache Cache

@*  The other routes, beside the one you are reading.

    A route page on a 1600px monitor was a 1180px column with 400px of empty
    margin, and getting to a second route meant going back to the dashboard and
    coming forward again. This fills that margin with the list, so switching is
    one click and never leaves the page.

    Desktop only, by CSS. On a phone there is no spare column and the bottom nav
    already owns "back to the list".                                             *@

<nav class="pt-rail" aria-label="Your routes">
    <div class="pt-rail-head">
        <span class="pt-rail-title">Commutes</span>
        <a class="pt-rail-add" href="routes/create" aria-label="Add a commute">
            <PtIcon Name="add" Size="sm" />
        </a>
    </div>

    @foreach (RouteDto route in _routes)
    {
        bool current = route.Id.Value == CurrentRouteId;

        <a class="pt-rail-item @(current ? "pt-rail-current" : "")"
           href="@($"routes/{route.Id}")"
           aria-current="@(current ? "page" : null)">
            <span class="pt-rail-dot @StatusClass(route)" aria-hidden="true"></span>
            <span class="pt-rail-text">
                <span class="pt-rail-where">@Street(route.DestinationAddress)</span>
                <span class="pt-rail-from">from @Street(route.OriginAddress)</span>
            </span>
        </a>
    }

    @if (_routes.Count == 0)
    {
        <p class="pt-rail-empty">No other commutes yet.</p>
    }
</nav>

@code {
    /// <summary>The route currently on screen, so the rail can mark it.</summary>
    [Parameter] public Guid CurrentRouteId { get; set; }

    private List<RouteDto> _routes = [];

    protected override async Task OnInitializedAsync()
    {
        // Paint from the dashboard's cached snapshot first. The rail is navigation
        // chrome; it must be there when the page is, not a second later.
        DashboardSnapshot? cached = await Cache.GetAsync(
            ClientCacheKeys.Dashboard, AppJsonContext.Default.DashboardSnapshot, TimeSpan.FromHours(12));

        if (cached is not null)
        {
            _routes = [.. cached.Routes.Where(Visible)];
            StateHasChanged();
        }

        try
        {
            PagedResult<RouteDto>? fresh = await Http.GetFromJsonAsync(
                "/api/routes?page=1&pageSize=100", AppJsonContext.Default.PagedResultRouteDto);

            if (fresh is not null)
                _routes = [.. fresh.Items.Where(Visible)];
        }
        catch
        {
            // A rail that failed to refresh still shows the cached list, and the page
            // beside it reports connectivity properly. Nothing to add here.
        }
    }

    private static bool Visible(RouteDto route) => route.MonitoringStatus != MonitoringStatus.Deleted;

    private static string Street(string address) =>
        TextFormatting.ToTitleCase(address.Split(',')[0]);

    private static string StatusClass(RouteDto route) => route.MonitoringStatus switch
    {
        MonitoringStatus.Active => "pt-rail-dot-active",
        MonitoringStatus.Paused => "pt-rail-dot-paused",
        _ => "",
    };
}
