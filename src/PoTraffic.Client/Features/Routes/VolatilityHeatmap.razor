@using PoTraffic.Shared.DTOs.History
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject PoTraffic.Client.Infrastructure.FxService Fx

@* ──────────────────────────────────────────────────────────────────────
   #5 — Day-of-week × quarter-hour congestion grid.

   Colour encodes how much slower a 15-minute slot runs than the route's
   typical (median) sample; the dot marks slots whose spread is wide enough
   that the time is unpredictable rather than merely slow. Those are
   different problems: a reliably-40-minute slot can be planned around, a
   25-to-55-minute one can't.

   Portrait layout: one column per weekday, one row per quarter-hour for the
   whole day (00:00–24:00, 96 rows), scrolling vertically inside the card. The
   3D view still draws only the slots that carry samples.

   Rule 4: the markup hands CSS the level class only — the ramp itself is
   owned by .pt-heat-l0…l4 in app.css.

   Times are bucketed in the user's local time zone (Heatmap.TimeZoneId,
   resolved server-side from the user's ProfileDto.Locale) at 15-minute
   resolution — 11:00, 11:15, 11:30, 11:45 — so "17:30" reads as the rush hour
   it actually is for the driver, not as some other zone's 17:30.
   ────────────────────────────────────────────────────────────────────── *@

@if (Heatmap is null || Heatmap.TotalSamples == 0)
{
    <div class="pt-heatmap-empty">
        <PtIcon Name="calendar_month" Size="xl" Class="pt-heatmap-empty-icon" />
        <div class="pt-heatmap-empty-text">
            The weekly pattern appears once this route has sampled a few commutes.
        </div>
    </div>
}
else
{
    @* The 3D view is the same numbers as a landscape (js/pt-terrain.js), so it is a
       small toggle on the summary's line rather than a control bar of its own. Hidden
       when motion is off or WebGL2 turned out to be missing. *@
    <div class="pt-heatmap-head">
        @if (_summary is not null)
        {
            <p class="pt-heatmap-summary">@_summary</p>
        }
        @if (!_terrainFailed && Fx.Motion != PoTraffic.Client.Infrastructure.MotionLevel.Off)
        {
            <RadzenButton Text="@(_terrain ? "Grid view" : "3D view")" Icon="@(_terrain ? "grid_on" : "landscape")"
                          ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                          Click="@(() => OnViewChanged(!_terrain))" />
        }
    </div>

    @if (_terrain)
    {
        <div class="pt-terrain" role="img"
             aria-label="@($"Weekly pattern as a landscape: taller means slower than typical. {_summary}")">
            <canvas class="pt-terrain-canvas" @ref="_canvas"></canvas>
            <div class="pt-terrain-labels" @ref="_labels" aria-hidden="true"></div>
        </div>
        <div class="pt-heatmap-legend">
            <span class="pt-heatmap-legend-label">Height and colour = how much slower than typical · shimmer = unpredictable · drag to turn</span>
        </div>
    }

    @* In 3D the grid stays in the DOM, visually hidden, so screen readers keep every figure. *@
    <div class="pt-heatmap-scroll @(_terrain ? "pt-visually-hidden" : "")">
        <table class="pt-heatmap">
            <caption class="pt-visually-hidden">
                Mean travel time by day of week and quarter-hour, in @(Heatmap?.TimeZoneId ?? "the user's local time").
            </caption>
            <thead>
                <tr>
                    <th scope="col" class="pt-heatmap-day"><span class="pt-visually-hidden">Time</span></th>
                    @foreach (string day in Week)
                    {
                        <th scope="col" class="pt-heatmap-day">@day[..3]</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (QuarterSlot slot in AllSlots)
                {
                    <tr>
                        <th scope="row" class="pt-heatmap-hour @(slot.Quarter == 0 ? "pt-heatmap-hour-top" : "")"><span>@SlotLabel(slot)</span></th>
                        @foreach (string day in Week)
                        {
                            HeatmapCellDto? cell = _byKey.GetValueOrDefault((day, slot.Hour, slot.Quarter));
                            @if (cell is null)
                            {
                                <td class="pt-heat pt-heat-empty" title="@EmptyTooltip(day, slot)">
                                    <span class="pt-visually-hidden">@EmptyTooltip(day, slot)</span>
                                </td>
                            }
                            else
                            {
                                <td class="pt-heat @LevelClass(cell) @(IsVolatile(cell) ? "pt-heat-volatile" : "")"
                                    title="@CellTooltip(cell)">
                                    <span class="pt-heat-value">@((cell.MeanDurationSeconds / 60).ToString("F0"))</span>
                                    <span class="pt-visually-hidden">@CellTooltip(cell)</span>
                                </td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pt-heatmap-legend @(_terrain ? "pt-visually-hidden" : "")">
        <span class="pt-heatmap-legend-label">Typical</span>
        <span class="pt-heat pt-heat-l0" aria-hidden="true"></span>
        <span class="pt-heat pt-heat-l1" aria-hidden="true"></span>
        <span class="pt-heat pt-heat-l2" aria-hidden="true"></span>
        <span class="pt-heat pt-heat-l3" aria-hidden="true"></span>
        <span class="pt-heat pt-heat-l4" aria-hidden="true"></span>
        <span class="pt-heatmap-legend-label">Congested</span>
        <span class="pt-heatmap-legend-sep">·</span>
        <span class="pt-heat pt-heat-l2 pt-heat-volatile" aria-hidden="true"></span>
        <span class="pt-heatmap-legend-label">dot = unpredictable</span>
        <span class="pt-heatmap-legend-sep">·</span>
        <span class="pt-heatmap-legend-label">minutes, 15-minute slots in @(Heatmap?.TimeZoneId ?? "your local time")</span>
    </div>
}

@code {
    [Parameter] public VolatilityHeatmapDto? Heatmap { get; set; }

    private static readonly string[] Week =
        ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

    /// <summary>
    /// Coefficient of variation above which a half-hour is called unpredictable. Matches
    /// the stability threshold the adaptive poller uses, so "volatile" means the same
    /// thing on the grid as it does to the scheduler.
    /// </summary>
    private const double VolatileCoefficient = 0.08;

    /// <summary>One 15-minute slot in the user's local day.</summary>
    /// <param name="Hour">Local hour 0–23 in <see cref="VolatilityHeatmapDto.TimeZoneId"/>.</param>
    /// <param name="Quarter">0 = :00, 1 = :15, 2 = :30, 3 = :45.</param>
    private readonly record struct QuarterSlot(int Hour, int Quarter)
    {
        public int StartMinute => Quarter * 15;
    }

    /// <summary>Every quarter-hour of the day — the grid's rows.</summary>
    private static readonly QuarterSlot[] AllSlots =
        [.. Enumerable.Range(0, 96).Select(static i => new QuarterSlot(i / 4, i % 4))];

    private bool _terrain;
    private bool _terrainFailed;
    private ElementReference _canvas;
    private ElementReference _labels;
    private IJSObjectReference? _module;

    /// <summary>The heatmap last drawn in 3D; the page re-renders this on every refresh.</summary>
    private VolatilityHeatmapDto? _drawn;

    private Dictionary<(string Day, int Hour, int Quarter), HeatmapCellDto> _byKey = [];
    private List<QuarterSlot> _slots = [];
    private string? _summary;

    protected override void OnParametersSet()
    {
        if (Heatmap is null || Heatmap.Cells.Count == 0)
        {
            _byKey = [];
            _slots = [];
            _summary = null;
            return;
        }

        // Last cell wins on a duplicate key — the server groups by exactly that triple,
        // so a duplicate would be a server bug rather than something to render twice.
        _byKey = Heatmap.Cells
            .GroupBy(c => (c.DayOfWeek, c.Hour, c.Quarter))
            .ToDictionary(g => g.Key, g => g.Last());

        // The 3D view's columns: only slots that actually carry a sample, so the
        // landscape isn't mostly flat. The grid itself draws AllSlots.
        _slots = Heatmap.Cells
            .Select(c => new QuarterSlot(c.Hour, c.Quarter))
            .Distinct()
            .OrderBy(static s => s.Hour)
            .ThenBy(static s => s.Quarter)
            .ToList();

        _summary = BuildSummary(Heatmap);
    }

    private async Task OnViewChanged(bool terrain)
    {
        // Leaving 3D removes the canvas. Release its GL context and 30fps ticker while it
        // still exists — DisposeAsync only ever sees the last canvas, so the detached one
        // kept redrawing for the rest of the session.
        if (!terrain && _module is not null)
        {
            try { await _module.InvokeVoidAsync("destroy", _canvas); }
            catch (JSException) { /* nothing to release */ }
        }
        _terrain = terrain;
        _drawn = null;   // the canvas is a new element each time 3D is chosen
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_terrain || Heatmap is null || ReferenceEquals(Heatmap, _drawn))
            return;
        _drawn = Heatmap;

        double median = Heatmap.MedianDurationSeconds;
        var cells = Week.SelectMany(day => _slots.Select(slot => _byKey.GetValueOrDefault((day, slot.Hour, slot.Quarter))))
            .ToList();

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/pt-terrain.js");
            bool drawn = await _module.InvokeAsync<bool>("render", _canvas, _labels, new
            {
                cols = _slots.Select(SlotLabel).ToArray(),
                rows = Week,
                ratio = cells.Select(c => c is null || median <= 0 ? -1 : c.MeanDurationSeconds / median).ToArray(),
                cv = cells.Select(c => c is { SampleCount: > 1, MeanDurationSeconds: > 0 }
                    ? c.StdDevDurationSeconds / c.MeanDurationSeconds : 0).ToArray(),
            });
            if (!drawn)
            {
                (_terrain, _terrainFailed) = (false, true);
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException) { /* page tearing down */ }
        catch (ObjectDisposedException) { /* page tearing down */ }
        catch (JSException)
        {
            (_terrain, _terrainFailed) = (false, true);
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
            return;

        try
        {
            await _module.InvokeVoidAsync("destroy", _canvas);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { /* page already gone */ }
        catch (ObjectDisposedException) { /* page already gone */ }
    }

    /// <summary>"Tuesdays at 17:30 run 62% over your typical 23 min." Null until a cell
    /// is materially worse than the route's median — flagging a 4% bump as a hotspot is noise.</summary>
    private static string? BuildSummary(VolatilityHeatmapDto heatmap)
    {
        if (heatmap.MedianDurationSeconds <= 0)
            return null;

        HeatmapCellDto? worst = heatmap.Cells.MaxBy(c => c.MeanDurationSeconds);
        if (worst is null)
            return null;

        int pct = (int)Math.Round((worst.MeanDurationSeconds - heatmap.MedianDurationSeconds)
            / heatmap.MedianDurationSeconds * 100);

        string when = $"{worst.DayOfWeek}s at {worst.Hour:D2}:{worst.Quarter * 15:D2}";
        return pct < 10
            ? $"This route holds steady all week — no slot runs more than {Math.Max(pct, 0)}% over its typical {heatmap.MedianDurationSeconds / 60:F0} min."
            : $"{when} are the worst 15 minutes of your week — {pct}% over the typical {heatmap.MedianDurationSeconds / 60:F0} min.";
    }

    private string LevelClass(HeatmapCellDto cell)
    {
        double median = Heatmap?.MedianDurationSeconds ?? 0;
        if (median <= 0)
            return "pt-heat-l0";

        double ratio = cell.MeanDurationSeconds / median;
        return ratio switch
        {
            <= 1.05 => "pt-heat-l0",
            <= 1.20 => "pt-heat-l1",
            <= 1.40 => "pt-heat-l2",
            <= 1.70 => "pt-heat-l3",
            _ => "pt-heat-l4"
        };
    }

    /// <summary>Wide spread relative to the cell's own mean — slow is plannable, erratic isn't.</summary>
    private static bool IsVolatile(HeatmapCellDto cell) =>
        cell.SampleCount > 1
        && cell.MeanDurationSeconds > 0
        && cell.StdDevDurationSeconds / cell.MeanDurationSeconds > VolatileCoefficient;

    private static string SlotLabel(QuarterSlot slot) =>
        $"{slot.Hour:D2}:{slot.StartMinute:D2}";

    private static string EmptyTooltip(string day, QuarterSlot slot) =>
        $"{day} {SlotLabel(slot)} — no samples";

    private string CellTooltip(HeatmapCellDto cell)
    {
        double median = Heatmap?.MedianDurationSeconds ?? 0;
        string delta = median > 0
            ? $" · {(cell.MeanDurationSeconds - median) / median * 100:+0;-0;0}% vs typical"
            : string.Empty;
        string spread = IsVolatile(cell)
            ? $" · ±{cell.StdDevDurationSeconds / 60:F0} min swing"
            : string.Empty;

        return $"{cell.DayOfWeek} {SlotLabel(new QuarterSlot(cell.Hour, cell.Quarter))} — {cell.MeanDurationSeconds / 60:F0} min avg{delta}{spread} · {cell.SampleCount} sample(s)";
    }
}