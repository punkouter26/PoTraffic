@using System.Net.Http.Json
@using PoTraffic.Shared.DTOs.Routes
@using PoTraffic.Shared.DTOs.History
@using PoTraffic.Shared.Enums
@inject HttpClient Http
@inject NavigationManager Nav
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject PendingDeletionService Pending
@inject PtInterop Pt
@implements IDisposable

@* ──────────────────────────────────────────────────────────────────────
   Route card — one answer, one tap.

   This used to carry six parallel status channels (monitoring badge, provider
   badge, sample badge, schedule label, confidence meter, ambient border), three
   buttons and three gestures. None of that answers the question the app exists
   to answer, so the card is now the answer itself: when to leave and how long
   it takes. Everything else moved to the route's own page, one tap away.

   The whole card is the target — a card that navigates should not need a button
   inside it that also navigates.
   ────────────────────────────────────────────────────────────────────── *@
@* The swipe wrapper that used to sit around this card is folded in: it was a second
   component whose whole job was to attach gestures and forward them to the two public
   methods below. One card, one set of actions, one place they are triggered from. *@
<div class="pt-swipe-wrap @(_pendingDelete ? "pending-delete" : "")" @ref="_cardElement">
    <div class="pt-swipe-action pt-swipe-action-left" aria-hidden="true"><span>Check Now</span></div>
    <div class="pt-swipe-action pt-swipe-action-right" aria-hidden="true"><span>Delete</span></div>

<div class="pt-route-card @AmbientClass" role="button" tabindex="0"
     aria-label="@AriaLabel"
     @onclick="OpenDetail" @onkeydown="OnKeyDown">

    <div class="pt-route-card-body">
        <div class="pt-route-card-answer">
            <div class="pt-route-card-route">
                <span class="pt-route-addr-from">@_originStreet</span>
                <PtIcon Name="arrow_right_alt" Size="sm" Class="pt-route-addr-arrow" />
                <span class="pt-route-addr-to">@_destStreet</span>
                @* The card deliberately sheds status badges (see above), and this is the
                   one exception: the sample route's numbers are generated, and unlabelled
                   invented data presented next to real commutes is a lie, not a clean UI. *@
                @if (Route.IsSample)
                {
                    <span class="pt-sample-chip">Sample</span>
                }
            </div>
            <div class="pt-route-card-time">
                @if (OptimalDeparture is not null)
                {
                    <span class="pt-route-card-time-value">@_durationLabel</span>
                }
                else
                {
                    <span class="pt-route-card-time-pending">@_pendingDetail</span>
                }
            </div>
        </div>

        @if (RecentPolls.Count > 0)
        {
            <TrendSparkline Polls="RecentPolls" />
        }
    </div>

    @* Only one state worth flagging: monitoring is paused. *@
    @if (Route.MonitoringStatus != MonitoringStatus.Active)
    {
        <span class="pt-route-flag pt-route-flag-paused">Paused</span>
    }

    @* These two actions used to exist only as swipe gestures, which "simply don't fire on
       desktop" — so Check Now and Delete were unreachable there entirely, and unreachable
       by keyboard everywhere. The gestures still work; these are the equivalents that a
       pointer or a Tab key can find. stopPropagation keeps them from also opening the card. *@
    <div class="pt-route-card-actions" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
        <RadzenButton Text="Check now" Icon="radar" ButtonStyle="ButtonStyle.Light"
                      Size="ButtonSize.ExtraSmall" Click="@CheckNowAsync"
                      title="@($"Check {_originStreet} to {_destStreet} right now")" />
        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Light"
                      Size="ButtonSize.ExtraSmall" Click="@ScheduleDelete"
                      title="@($"Delete {_originStreet} to {_destStreet}")" />
    </div>
</div>
</div>

@code {
    [Parameter, EditorRequired] public RouteDto Route { get; set; } = default!;
    [Parameter] public OptimalDepartureDto? OptimalDeparture { get; set; }
    [Parameter] public IReadOnlyList<PollRecordDto> RecentPolls { get; set; } = [];
    [Parameter] public EventCallback OnDeleted { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }

    private ElementReference _cardElement;
    private DotNetObjectReference<RouteCard>? _selfRef;
    private IAsyncDisposable? _gestureCleanup;
    private bool _pendingDelete;

    private string _originStreet = string.Empty;
    private string _destStreet = string.Empty;
    private string _durationLabel = string.Empty;
    private string _pendingDetail = string.Empty;

    private string AriaLabel =>
        $"{_originStreet} to {_destStreet}. " +
        (OptimalDeparture is not null ? _durationLabel : "Still learning this route.");

    // Ambient colour: green once the route can actually answer the question,
    // amber while it is still learning, slate when it isn't collecting at all.
    private string AmbientClass => Route.MonitoringStatus switch
    {
        MonitoringStatus.Active when OptimalDeparture is not null => "pt-ambient-green",
        MonitoringStatus.Active => "pt-ambient-amber",
        _ => "pt-ambient-slate"
    };

    protected override void OnInitialized()
    {
        _selfRef = DotNetObjectReference.Create(this);
        Pending.Changed += OnPendingChanged;
    }

    /// <summary>
    /// Keeps the slide-out tied to the service rather than to a local flag: an undo restores
    /// the route, and the card has to come back with it instead of staying visually deleted
    /// because a bool was never reset.
    /// </summary>
    private void OnPendingChanged()
    {
        bool nowPending = Pending.IsPending(Route.Id);
        if (nowPending == _pendingDelete)
            return;

        _pendingDelete = nowPending;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _gestureCleanup = await Pt.AttachSwipeAsync(_cardElement, _selfRef!, nameof(OnGestureAsync));
    }

    /// <summary>Swipe gestures are shortcuts to the buttons, never the only way to reach them.</summary>
    [JSInvokable]
    public async Task OnGestureAsync(string gesture)
    {
        switch (gesture)
        {
            case "left":
                await CheckNowAsync();
                break;
            case "right":
                await AnimateThenScheduleDeleteAsync();
                break;
        }
    }

    /// <summary>Plays the slide-out, then hands the delete to the same undo-window scheduler
    /// the button uses. Nothing reaches the server until that window closes.</summary>
    private async Task AnimateThenScheduleDeleteAsync()
    {
        if (_pendingDelete) return;
        _pendingDelete = true;
        StateHasChanged();

        await Task.Delay(500);
        ScheduleDelete();
    }

    public void Dispose()
    {
        Pending.Changed -= OnPendingChanged;
        _ = _gestureCleanup?.DisposeAsync();
        _selfRef?.Dispose();
    }

    private void OpenDetail() => Nav.NavigateTo($"/routes/{Route.Id}");

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
            OpenDetail();
    }

    protected override void OnParametersSet()
    {
        // Display-side title-casing: the API returns addresses verbatim, so a
        // user-entered "4451 telfair blvd" and a Google-resolved "4451 Telfair
        // Blvd" would otherwise sit on the same dashboard with different
        // casings. Storage stays untouched; only the rendered string is shaped.
        _originStreet = TextFormatting.ToTitleCase(Route.OriginAddress.Split(',')[0]);
        _destStreet = TextFormatting.ToTitleCase(Route.DestinationAddress.Split(',')[0]);

        if (OptimalDeparture is { } optimal)
        {
            // Currently recording best travel time — the single most useful
            // number on the card, with the [lower–upper] range to telegraph
            // how confident we are. Rounded, not truncated, so a 35-second
            // probe displays as "1 min" rather than "0 min".
            int estMin = (int)Math.Round(optimal.PredictedDurationSeconds / 60.0);

            _durationLabel = optimal is { LowerBound: { } lower, UpperBound: { } upper }
                ? $"{estMin} min · {lower / 60:F0}–{upper / 60:F0} min"
                : $"{estMin} min";
        }
        else
        {
            int samples = RecentPolls.Count;
            _pendingDetail = samples == 0
                ? "No samples yet"
                : $"{samples} sample{(samples == 1 ? "" : "s")} so far";
        }
    }

    /// <summary>
    /// Runs a live poll. Reachable from the card's own button and from a swipe-left,
    /// which are the same call — the one action that spends money should not have two
    /// implementations that can drift.
    /// </summary>
    public async Task CheckNowAsync()
    {
        HttpResponseMessage resp = await Http.PostAsync($"/api/routes/{Route.Id}/check-now", null);
        if (resp.IsSuccessStatusCode)
        {
            CheckNowResponse? data = await resp.Content.ReadFromJsonAsync(AppJsonContext.Default.CheckNowResponse);
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Info,
                Summary = "Right now",
                Detail = data is not null
                    ? $"{data.DurationSeconds / 60} min"
                    : "Live travel time retrieved",
                Duration = 6000
            });
            await OnRefresh.InvokeAsync();
            return;
        }

        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = "Couldn't check now",
            Detail = resp.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable
                ? "Traffic provider unavailable — try again later."
                : $"Request failed ({(int)resp.StatusCode}).",
            Duration = 5000
        });
    }

    /// <summary>
    /// Hides the route now and sends the DELETE only once the undo window closes.
    /// Shared by the card's delete button and the swipe-right gesture.
    /// </summary>
    public void ScheduleDelete() =>
        Pending.Schedule(
            Route.Id,
            $"{_originStreet} → {_destStreet}",
            commit: async () =>
            {
                HttpResponseMessage response = await Http.DeleteAsync($"/api/routes/{Route.Id}");
                response.EnsureSuccessStatusCode();
            },
            onCommitted: () => OnDeleted.InvokeAsync(),
            onFailed: () =>
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Delete failed",
                    Detail = "The route has been restored.",
                    Duration = 5000
                });
                return Task.CompletedTask;
            });
}
