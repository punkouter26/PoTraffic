@using System.Net.Http.Json
@using PoTraffic.Shared.DTOs.Routes
@using PoTraffic.Shared.DTOs.History
@using PoTraffic.Shared.Enums
@inject HttpClient Http
@inject NavigationManager Nav
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject PendingDeletionService Pending

@* ──────────────────────────────────────────────────────────────────────
   Route card — one answer, one tap.

   This used to carry six parallel status channels (monitoring badge, provider
   badge, sample badge, schedule label, confidence meter, ambient border), three
   buttons and three gestures. None of that answers the question the app exists
   to answer, so the card is now the answer itself: when to leave and how long
   it takes. Everything else moved to the route's own page, one tap away.

   The whole card is the target — a card that navigates should not need a button
   inside it that also navigates.
   ────────────────────────────────────────────────────────────────────── *@
<div class="pt-route-card @AmbientClass" role="button" tabindex="0"
     aria-label="@AriaLabel"
     @onclick="OpenDetail" @onkeydown="OnKeyDown">

    <div class="pt-route-card-body">
        <div class="pt-route-card-answer">
            @if (OptimalDeparture is not null)
            {
                <div class="pt-departure-hero">@_leaveByLabel</div>
                <div class="pt-departure-sub">@_durationLabel</div>
            }
            else
            {
                <div class="pt-departure-pending">Learning this route</div>
                <div class="pt-departure-sub">@_pendingDetail</div>
            }
        </div>

        @if (RecentPolls.Count > 0)
        {
            <TrendSparkline Polls="RecentPolls" />
        }
    </div>

    <div class="pt-route-card-foot">
        <span class="pt-route-addresses">
            <span class="pt-route-addr-from">@_originStreet</span>
            <PtIcon Name="arrow_right_alt" Size="sm" Class="pt-route-addr-arrow" />
            <span class="pt-route-addr-to">@_destStreet</span>
        </span>

        @* Only one state worth flagging: monitoring is paused. *@
        @if (Route.MonitoringStatus != MonitoringStatus.Active)
        {
            <span class="pt-route-flag pt-route-flag-paused">Paused</span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public RouteDto Route { get; set; } = default!;
    [Parameter] public OptimalDepartureDto? OptimalDeparture { get; set; }
    [Parameter] public IReadOnlyList<PollRecordDto> RecentPolls { get; set; } = [];
    [Parameter] public EventCallback OnDeleted { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }

    private string _originStreet = string.Empty;
    private string _destStreet = string.Empty;
    private string _leaveByLabel = string.Empty;
    private string _durationLabel = string.Empty;
    private string _pendingDetail = string.Empty;

    private string AriaLabel =>
        $"{_originStreet} to {_destStreet}. " +
        (OptimalDeparture is not null ? $"{_leaveByLabel}, {_durationLabel}." : "Still learning this route.");

    // Ambient colour: green once the route can actually answer the question,
    // amber while it is still learning, slate when it isn't collecting at all.
    private string AmbientClass => Route.MonitoringStatus switch
    {
        MonitoringStatus.Active when OptimalDeparture is not null => "pt-ambient-green",
        MonitoringStatus.Active => "pt-ambient-amber",
        _ => "pt-ambient-slate"
    };

    private void OpenDetail() => Nav.NavigateTo($"/routes/{Route.Id}");

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
            OpenDetail();
    }

    protected override void OnParametersSet()
    {
        // Display-side title-casing: the API returns addresses verbatim, so a
        // user-entered "4451 telfair blvd" and a Google-resolved "4451 Telfair
        // Blvd" would otherwise sit on the same dashboard with different
        // casings. Storage stays untouched; only the rendered string is shaped.
        _originStreet = TextFormatting.ToTitleCase(Route.OriginAddress.Split(',')[0]);
        _destStreet = TextFormatting.ToTitleCase(Route.DestinationAddress.Split(',')[0]);

        if (OptimalDeparture is { } optimal)
        {
            int h = optimal.TimeSlotBucket / 60;
            int m = optimal.TimeSlotBucket % 60;
            string period = h >= 12 ? "PM" : "AM";
            int displayH = h > 12 ? h - 12 : (h == 0 ? 12 : h);
            int estMin = (int)(optimal.PredictedDurationSeconds / 60);

            _leaveByLabel = $"Leave by {displayH}:{m:D2} {period}";

            // The range is the honest part of the estimate; it belongs on the
            // face of the card rather than behind a confidence meter that asked
            // the reader to convert "38 / 60 samples" into trust on their own.
            _durationLabel = optimal is { LowerBound: { } lower, UpperBound: { } upper }
                ? $"about {estMin} min ({lower / 60:F0}–{upper / 60:F0})"
                : $"about {estMin} min";
        }
        else
        {
            int samples = RecentPolls.Count;
            _pendingDetail = samples == 0
                ? "No samples yet"
                : $"{samples} sample{(samples == 1 ? "" : "s")} so far";
        }
    }

    /// <summary>
    /// Runs a live poll. The card no longer shows a button for this — the swipe
    /// gesture on <see cref="SwipeableRouteCard"/> is the single entry point, so
    /// the one action that spends money is deliberate rather than adjacent to
    /// everything else.
    /// </summary>
    public async Task CheckNowAsync()
    {
        HttpResponseMessage resp = await Http.PostAsync($"/api/routes/{Route.Id}/check-now", null);
        if (resp.IsSuccessStatusCode)
        {
            CheckNowResponse? data = await resp.Content.ReadFromJsonAsync(AppJsonContext.Default.CheckNowResponse);
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Info,
                Summary = "Right now",
                Detail = data is not null
                    ? $"{data.DurationSeconds / 60} min"
                    : "Live travel time retrieved",
                Duration = 6000
            });
            await OnRefresh.InvokeAsync();
            return;
        }

        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = "Couldn't check now",
            Detail = resp.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable
                ? "Traffic provider unavailable — try again later."
                : $"Request failed ({(int)resp.StatusCode}).",
            Duration = 5000
        });
    }

    /// <summary>
    /// Hides the route now and sends the DELETE only once the undo window closes.
    /// Shared with <see cref="SwipeableRouteCard"/>'s swipe gesture.
    /// </summary>
    public void ScheduleDelete() =>
        Pending.Schedule(
            Route.Id,
            $"{_originStreet} → {_destStreet}",
            commit: async () =>
            {
                HttpResponseMessage response = await Http.DeleteAsync($"/api/routes/{Route.Id}");
                response.EnsureSuccessStatusCode();
            },
            onCommitted: () => OnDeleted.InvokeAsync(),
            onFailed: () =>
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Delete failed",
                    Detail = "The route has been restored.",
                    Duration = 5000
                });
                return Task.CompletedTask;
            });
}
