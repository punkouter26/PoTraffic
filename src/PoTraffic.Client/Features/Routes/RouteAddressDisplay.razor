<RadzenText TextStyle="TextStyle.Body2" class="rz-text-truncate pt-route-address">
    <strong>@_street</strong><br />
    <small class="rz-color-on-surface-variant">@_rest</small>
</RadzenText>

@code {
    [Parameter, EditorRequired] public string Address { get; set; } = string.Empty;

    private string _street = string.Empty;
    private string _rest = string.Empty;

    protected override void OnParametersSet()
    {
        var parts = Address.Split(',');
        _street = parts[0];
        _rest = string.Join(',', parts.Skip(1));
    }
}
