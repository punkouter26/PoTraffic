@using PoTraffic.Shared.DTOs.History

@* Collapsible raw poll data table for past 24h records *@

@if (Polls.Count > 0)
{
    <RadzenCard>
        <button class="pt-collapsible-header" @onclick="ToggleRawData" type="button"
                aria-expanded="@_showRawData">
            <PtIcon Name="chevron_right" Class="@(_showRawData ? "pt-collapsible-icon open" : "pt-collapsible-icon")" />
            Raw poll data (past 24h · @Polls.Count records)
        </button>
        @if (_showRawData)
        {
            @* AllowVirtualization = only render visible rows.

               The admin grids already run Density.Compact, column resize and column
               picking; this one — the grid an ordinary user is most likely to open,
               on the narrowest screen — was on defaults. Compact is the point of a
               raw log, and picking is what makes four columns of numbers survive a
               phone without sideways scrolling. *@
            <RadzenDataGrid Data="@Polls" TItem="PollRecordDto"
                            AllowPaging="false" AllowVirtualization="true"
                            VirtualizationOverscanCount="4"
                            FilterMode="FilterMode.Simple"
                            AllowSorting="true"
                            Density="Density.Compact"
                            AllowColumnResize="true"
                            AllowColumnPicking="true"
                            EmptyText="No samples in the last 24 hours."
                            class="pt-mt-2 pt-virtual-grid">
                <Columns>
                    <RadzenDataGridColumn TItem="PollRecordDto" Property="PolledAtDateTime" Title="Polled at"
                                          FormatString="{0:h:mm:ss tt}" Sortable="true" Width="9rem" />
                    <RadzenDataGridColumn TItem="PollRecordDto" Title="Duration" Sortable="true"
                                          Property="TravelDurationSeconds" Width="7rem">
                        <Template Context="p">
                            @{
                                int h = p.TravelDurationSeconds / 3600;
                                int m = (p.TravelDurationSeconds % 3600) / 60;
                            }
                            @(h > 0 ? $"{h}h {m}m" : $"{m}m")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PollRecordDto" Title="Distance" Sortable="true"
                                          Property="DistanceMetres" Width="7rem">
                        <Template Context="p">
                            @($"{p.DistanceMetres * 0.000621371:F1} mi")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PollRecordDto" Title="Rerouted" Width="7rem" Sortable="false">
                        <Template Context="p">
                            @if (p.IsRerouted)
                            {
                                <RadzenBadge Text="Yes" BadgeStyle="BadgeStyle.Danger" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    </RadzenCard>
}

@code {
    [Parameter, EditorRequired] public List<PollRecordDto> Polls { get; set; } = [];

    private bool _showRawData;
    private void ToggleRawData() => _showRawData = !_showRawData;
}
