@page "/routes/{RouteId:guid}"
@using PoTraffic.Shared.DTOs.History
@using PoTraffic.Shared.DTOs.Routes
@using PoTraffic.Shared.Enums
@using PoTraffic.Shared.Constants
@using PoTraffic.Client.Features.MonitoringWindows
@inherits PollingComponentBase
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Route Detail — PoTraffic</PageTitle>

<nav class="pt-breadcrumb" aria-label="breadcrumb">
    <a href="/dashboard">Dashboard</a>
    <span class="pt-breadcrumb-sep">›</span>
    <span class="pt-breadcrumb-current">Route Detail</span>
</nav>

@if (_loading)
{
    <PtProgressLine AriaLabel="Loading route" />
}
else
{
    @* UI-2: Optimal departure is the headline — always visible, not hidden *@
    @if (_optimalDeparture is not null)
    {
        <div class="pt-departure-banner rz-mb-4">
            <span class="pt-departure-banner-icon">⏰</span>
            <div>
                <div class="pt-departure-banner-label">Best departure today</div>
                <div class="pt-departure-banner-time">@_optimalDepartureLabel</div>
            </div>
        </div>
    }

    <RadzenCard class="rz-mb-4">
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Monitoring Snapshot</RadzenText>

        <div class="pt-stat-strip">
            <div class="pt-stat-block @(LatestPoll is null ? "pt-stat-amber" : "pt-stat-blue")">
                <div class="pt-stat-label">Latest Sample</div>
                <div class="pt-stat-value">
                    @if (LatestPoll is null)
                    {
                        <text>No samples yet</text>
                    }
                    else
                    {
                        <text>@(LatestPoll.TravelDurationSeconds / 60)m</text>
                    }
                </div>
                @if (LatestPoll is not null)
                {
                    <div class="pt-stat-meta">at @LatestPoll.PolledAtDateTime.ToLocalTime().ToString("HH:mm:ss")</div>
                }
            </div>
            <div class="pt-stat-block pt-stat-green">
                <div class="pt-stat-label">Samples (24h)</div>
                <div class="pt-stat-value">@_todayPolls.Count</div>
                @if (_todayPolls.Count > 0)
                {
                    <div class="pt-stat-meta">@_todayPolls.Count(p => p.IsRerouted) rerouted</div>
                }
            </div>
            @{
                NextSampleInfo next = NextSample;
            }
            <div class="pt-stat-block @(next.Live ? "pt-stat-green" : "pt-stat-amber")">
                <div class="pt-stat-label">Next Sample ETA</div>
                <div class="pt-stat-value @(next.Live ? "pt-poll-live" : "")">@next.Value</div>
                @if (!string.IsNullOrEmpty(next.Detail))
                {
                    <div class="pt-stat-meta">@next.Detail</div>
                }
            </div>
        </div>
    </RadzenCard>

    @* Monitoring window configuration *@
    <WindowConfigPanel RouteId="RouteId" OnSaved="OnWindowSaved" />

    @* P1/UX-9: Chart always visible — no toggle required.
       Uses the canvas-based TrendChart (GPU-friendly) instead of RadzenChart. *@
    <RadzenCard class="rz-mb-4">
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Travel Time Trend (Past 24h)</RadzenText>
        <TrendChart Points="@_trendPoints"
                    Baseline="@_trendBaseline"
                    UpperBand="@_trendUpperBand"
                    ReroutedFlags="@_trendRerouted" />
    </RadzenCard>

    @* UX-9: Raw poll table — collapsed by default for stat-lovers *@
    <PollHistoryTable Polls="_todayPolls" />
}

@code {
    [Parameter] public Guid RouteId { get; set; }

    private bool _loading = true;
    private List<PollRecordDto> _todayPolls = [];
    private List<BaselineSlotDto> _baselineSlots = [];
    private List<TravelTimeTrendChart.ActualChartPoint> _chartActual = [];
    private List<TravelTimeTrendChart.ActualChartPoint> _chartRerouted = [];
    private List<TravelTimeTrendChart.BaselineChartPoint> _chartBaseline = [];
    private List<TravelTimeTrendChart.UpperBandPoint> _chartUpperBand = [];
    private double[] _trendPoints = [];
    private double[] _trendBaseline = [];
    private double[] _trendUpperBand = [];
    private bool[] _trendRerouted = [];
    private OptimalDepartureDto? _optimalDeparture;
    private string _optimalDepartureLabel = string.Empty;
    private SessionDto? _activeSession;
    private MonitoringWindowDto? _activeWindow;
    private PollRecordDto? LatestPoll => _todayPolls.OrderByDescending(p => p.PolledAtDateTime).FirstOrDefault();

    /// <summary>
    /// True if the active monitoring window currently contains "now" (UTC).
    /// Used by <see cref="NextSample"/> to distinguish "between polls, inside window"
    /// from "window has closed for today, scheduler is silent".
    /// </summary>
    private bool WindowIsOpenNow()
    {
        if (_activeWindow is null) return false;
        if (!TimeOnly.TryParse(_activeWindow.StartTime, out var start)) return false;
        if (!TimeOnly.TryParse(_activeWindow.EndTime, out var end)) return false;
        TimeOnly nowUtc = TimeOnly.FromDateTime(DateTime.UtcNow);
        return nowUtc >= start && nowUtc < end;
    }

    private readonly record struct NextSampleInfo(string Value, string Detail, bool Live);

    // Headline + detail describing when the next traffic sample is expected to complete.
    // Polls run on a self-perpetuating chain every QuotaConstants.PollIntervalMinutes while
    // a session is active and inside the monitoring window; the first poll is enqueued
    // the moment monitoring starts.
    private NextSampleInfo NextSample
    {
        get
        {
            const int intervalMin = QuotaConstants.PollIntervalMinutes;
            bool monitoringActive = _activeSession is { State: SessionState.Active };

            if (!monitoringActive)
            {
                return new NextSampleInfo("—", "Start monitoring to begin sampling", Live: false);
            }

            // Distinguish "session active but window closed for today" from "session active
            // and we're waiting for the next poll tick". Without this, a window that ended
            // an hour ago still shows "Due now" because the next +5min slot has passed.
            if (!WindowIsOpenNow())
            {
                string startLabel = _activeWindow is not null
                    ? $"Window closed — next opens {_activeWindow.StartTime[..5]}"
                    : "Window closed for today";
                return new NextSampleInfo("Idle", startLabel, Live: false);
            }

            // The session's server-recorded last poll is the authoritative cadence anchor;
            // fall back to the loaded poll list if the session hasn't surfaced it yet.
            DateTimeOffset? lastPollUtc = _activeSession!.LastPollAt
                ?? LatestPoll?.PolledAtDateTime;

            if (lastPollUtc is null)
            {
                // Active but no sample yet — first poll fires almost immediately, then retries
                // every interval if the traffic provider is unavailable.
                return new NextSampleInfo(
                    "Pending",
                    $"First sample expected within {intervalMin} min",
                    Live: true);
            }

            DateTime nextLocal = lastPollUtc.Value.ToLocalTime().DateTime.AddMinutes(intervalMin);
            TimeSpan remaining = nextLocal - DateTime.Now;

            if (remaining <= TimeSpan.Zero)
            {
                return new NextSampleInfo("Due now", "expected any moment", Live: true);
            }

            return new NextSampleInfo(
                $"in {Math.Ceiling(remaining.TotalMinutes):F0} min",
                $"~{nextLocal:HH:mm:ss} · every {intervalMin} min",
                Live: false);
        }
    }
    // Observer pattern — PollingComponentBase base handles the timer loop
    protected override TimeSpan PollingInterval => TimeSpan.FromSeconds(15);

    private async Task OnWindowSaved()
    {
        await LoadDataAsync();
        StateHasChanged();
    }

    protected override async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            string dayOfWeek = DateTime.Today.DayOfWeek.ToString();

            // Load the active monitoring window — drives NextSample's window-open detection
            // so the card switches to "Idle / Window closed" instead of "Due now" after the
            // daily window ends.
            var windows = await Http.GetFromJsonAsync(
                $"/api/routes/{RouteId}/windows", AppJsonContext.Default.ListMonitoringWindowDto);
            _activeWindow = windows?.FirstOrDefault(w => w.IsActive);

            // Load today's active monitoring session — drives the Next Sample ETA card
            var sessions = await Http.GetFromJsonAsync(
                $"/api/routes/{RouteId}/sessions", AppJsonContext.Default.ListSessionDto);
            DateOnly today = DateOnly.FromDateTime(DateTime.UtcNow.Date);
            _activeSession = sessions?.FirstOrDefault(
                s => s.State == SessionState.Active && s.SessionDate == today);

            // Load past 24h poll records
            string sinceUtc = Uri.EscapeDataString(DateTime.UtcNow.AddHours(-24).ToString("o"));
            var historyResult = await Http.GetFromJsonAsync(
                $"/api/routes/{RouteId}/poll-history?page=1&pageSize=300&sinceUtc={sinceUtc}", AppJsonContext.Default.PagedResultPollRecordDto);
            if (historyResult is not null)
            {
                _todayPolls = [.. historyResult.Items];
                _chartActual = _todayPolls
                    .Select(p => new TravelTimeTrendChart.ActualChartPoint(
                        p.PolledAtDateTime,
                        p.TravelDurationSeconds / 60.0,
                        p.IsRerouted))
                    .ToList();
                _chartRerouted = _chartActual.Where(p => p.IsRerouted).ToList();
                _trendPoints = _todayPolls.Select(p => p.TravelDurationSeconds / 60.0).ToArray();
                _trendRerouted = _todayPolls.Select(p => p.IsRerouted).ToArray();
            }

            // Load baseline
            var baseline = await Http.GetFromJsonAsync(
                $"/api/routes/{RouteId}/baseline?dayOfWeek={dayOfWeek}", AppJsonContext.Default.BaselineResponse);
            if (baseline is not null)
            {
                _baselineSlots = [.. baseline.Slots];
                _chartBaseline = _baselineSlots
                    .Select(s => new TravelTimeTrendChart.BaselineChartPoint(s.TimeSlotBucket, s.MeanDurationSeconds / 60.0))
                    .ToList();
                _chartUpperBand = _baselineSlots
                    .Where(s => s.StdDevDurationSeconds.HasValue)
                    .Select(s => new TravelTimeTrendChart.UpperBandPoint(
                        s.TimeSlotBucket,
                        (s.MeanDurationSeconds + s.StdDevDurationSeconds!.Value) / 60.0))
                    .ToList();
                _trendBaseline = _baselineSlots.Select(s => s.MeanDurationSeconds / 60.0).ToArray();
                _trendUpperBand = _baselineSlots
                    .Select(s => s.StdDevDurationSeconds.HasValue
                        ? (s.MeanDurationSeconds + s.StdDevDurationSeconds.Value) / 60.0
                        : s.MeanDurationSeconds / 60.0)
                    .ToArray();
            }

            // Load optimal departure
            var optimal = await Http.GetFromJsonAsync(
                $"/api/routes/{RouteId}/optimal-departure?dayOfWeek={dayOfWeek}", AppJsonContext.Default.OptimalDepartureDto);
            if (optimal is not null)
            {
                _optimalDeparture = optimal;
                int h = optimal.TimeSlotBucket / 60;
                int m = optimal.TimeSlotBucket % 60;
                _optimalDepartureLabel = $"Best departure: {h:D2}:{m:D2} " +
                    $"(~{optimal.PredictedDurationSeconds / 60:F0} min)";
            }
        }
        catch
        {
            // Silently handled — partial data shown
        }
        finally
        {
            _loading = false;
        }
    }
}
