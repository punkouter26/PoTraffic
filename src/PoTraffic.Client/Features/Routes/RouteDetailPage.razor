@page "/routes/{RouteId:guid}"
@using PoTraffic.Shared.DTOs.History
@using PoTraffic.Shared.DTOs.Routes
@using PoTraffic.Shared.Enums
@using PoTraffic.Shared.Constants
@using PoTraffic.Client.Features.MonitoringWindows
@inherits PollingComponentBase
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Route Detail — PoTraffic</PageTitle>

<nav class="pt-breadcrumb" aria-label="breadcrumb">
    <a href="/dashboard">Dashboard</a>
    <span class="pt-breadcrumb-sep">›</span>
    <span class="pt-breadcrumb-current">Route Detail</span>
</nav>

@if (IsFirstLoad)
{
    <PtProgressLine AriaLabel="Loading route" />
}
else
{
    @if (IsOffline || IsStale)
    {
        <div class="pt-stale-banner" role="status">
            @(IsOffline ? "⚠︎ Offline — showing the last data received." :
                          "⚠︎ Can't reach the server — retrying.")
        </div>
    }

    @* UI-2: Optimal departure is the headline — always visible, not hidden *@
    @if (_optimalDeparture is not null)
    {
        <div class="pt-departure-banner rz-mb-4">
            <span class="pt-departure-banner-icon">⏰</span>
            <div class="pt-departure-banner-body">
                <div class="pt-departure-banner-label">Best departure today</div>
                <div class="pt-departure-banner-time">@_optimalDepartureLabel</div>
            </div>
            @* #2: one-click calendar reminder (cookie-authenticated same-origin download) *@
            <a class="pt-departure-ics" href="@_icsHref" download="departure.ics"
               title="Add a weekly 'leave by' reminder to your calendar">📅 Add to calendar</a>
        </div>
    }

    @* #10: the sample route says so, plainly and above everything it might be mistaken for *@
    @if (_route?.IsDemo == true)
    {
        <div class="pt-demo-banner rz-mb-4" role="note">
            <span class="pt-demo-banner-tag">SAMPLE DATA</span>
            <span class="pt-demo-banner-text">
                Every number below was generated to show what a well-measured route looks like.
                Monitoring and Check Now are turned off here — add your own route to collect real samples.
            </span>
            <RadzenButton Text="Add a real route" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                          Click="@(() => Nav.NavigateTo("/routes/create"))" />
        </div>
    }

    @* #3: return-trip pairing — not offered for the sample route, whose reverse direction
       would be a real, empty route wearing illustrative addresses. *@
    @if (_route is not null && !_route.IsDemo)
    {
        <div class="pt-returntrip-bar rz-mb-4">
            @if (_route.ReturnRouteId is RouteId rid)
            {
                <span class="pt-returntrip-label">🔁 Return trip linked</span>
                <RadzenButton Text="View return trip" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                              Click="@(() => Nav.NavigateTo($"/routes/{rid}"))" />
            }
            else
            {
                <span class="pt-returntrip-label">🔁 Also track the trip home?</span>
                <RadzenButton Text="Track return trip" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                              Click="CreateReturnTripAsync" IsBusy="_creatingReturn" />
            }
        </div>
    }

    <RadzenCard class="rz-mb-4">
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Monitoring Snapshot</RadzenText>

        <div class="pt-stat-strip">
            <div class="pt-stat-block @(LatestPoll is null ? "pt-stat-amber" : "pt-stat-blue")">
                <div class="pt-stat-label">Latest Sample</div>
                <div class="pt-stat-value">
                    @if (LatestPoll is null)
                    {
                        <text>No samples yet</text>
                    }
                    else
                    {
                        <text>@(LatestPoll.TravelDurationSeconds / 60)m</text>
                    }
                </div>
                @if (LatestPoll is not null)
                {
                    <div class="pt-stat-meta">at @LatestPoll.PolledAtDateTime.ToLocalTime().ToString("HH:mm:ss")</div>
                }
            </div>
            <div class="pt-stat-block pt-stat-green">
                <div class="pt-stat-label">Samples (24h)</div>
                <div class="pt-stat-value">@_todayPolls.Count</div>
                @if (_todayPolls.Count > 0)
                {
                    <div class="pt-stat-meta">@_todayPolls.Count(p => p.IsRerouted) rerouted</div>
                }
            </div>
            @{
                NextSampleInfo next = NextSample;
            }
            <div class="pt-stat-block @(next.Live ? "pt-stat-green" : "pt-stat-amber")">
                <div class="pt-stat-label">Next Sample ETA</div>
                <div class="pt-stat-value @(next.Live ? "pt-poll-live" : "")">
                    @if (next.CountdownTargetUtc is { } target)
                    {
                        @* #4: ticks every second on its own, instead of freezing
                           between the page's 15-second refreshes. *@
                        <LiveCountdown TargetUtc="target"
                                       PeriodHint="@TimeSpan.FromMinutes(_activeSession?.Schedule?.PollIntervalMinutes ?? 5)"
                                       DueText="due now" />
                    }
                    else
                    {
                        @next.Value
                    }
                </div>
                @if (!string.IsNullOrEmpty(next.Detail))
                {
                    <div class="pt-stat-meta">@next.Detail</div>
                }
            </div>
        </div>
    </RadzenCard>

    @* #1/#2: arrival solver and departure scrubber, both answered client-side
       from the baseline this page has already downloaded. *@
    <DeparturePlanner Slots="_baselineSlots"
                      SuggestedDepartureMinute="_optimalDeparture?.TimeSlotBucket" />

    @* Monitoring window configuration. Hidden on the sample route: the server refuses to
       start a chain against it (#10), and a Start button that always fails is worse than none. *@
    @if (_route?.IsDemo != true)
    {
        <WindowConfigPanel RouteId="RouteId" OnSaved="OnWindowSaved" />
    }

    @* P1/UX-9: Chart always visible — no toggle required.
       Uses the canvas-based TrendChart (GPU-friendly) instead of RadzenChart. *@
    <RadzenCard class="rz-mb-4">
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Travel Time Trend (Past 24h)</RadzenText>
        <TrendChart Points="@_trendPoints"
                    Baseline="@_trendBaseline"
                    UpperBand="@_trendUpperBand"
                    ReroutedFlags="@_trendRerouted"
                    Labels="@_trendLabels"
                    OnPointSelected="OnTrendPointSelected" />

        @if (_selectedPoll is { } selected)
        {
            <div class="pt-trend-selection">
                <span class="pt-trend-selection-time">@selected.PolledAtDateTime.ToString("HH:mm:ss")</span>
                <span class="pt-trend-selection-value">@(selected.TravelDurationSeconds / 60) min</span>
                <span class="pt-trend-selection-meta">
                    @($"{selected.DistanceMetres * 0.000621371:F1} mi") · @selected.Provider
                    @if (selected.IsRerouted)
                    {
                        <span class="pt-trend-selection-flag">rerouted</span>
                    }
                </span>
                <button type="button" class="pt-trend-selection-clear"
                        aria-label="Clear selection" @onclick="() => _selectedPoll = null">✕</button>
            </div>
        }
    </RadzenCard>

    @* #4: Day-of-week comparison — which days run worse *@
    @if (_weekdayComparison is not null && _weekdayComparison.Days.Any(d => d.SampleCount > 0))
    {
        <RadzenCard class="rz-mb-4">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-1">Which days run worst?</RadzenText>
            @if (_weekdaySummary is not null)
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-3 pt-weekday-summary">@_weekdaySummary</RadzenText>
            }
            <div class="pt-weekday-grid">
                @foreach (WeekdayMeanDto d in _weekdayComparison.Days)
                {
                    <div class="pt-weekday-label">@d.DayOfWeek[..3]</div>
                    <div class="pt-weekday-track">
                        @if (d.SampleCount > 0)
                        {
                            @* The only thing crossing the markup boundary is the datum
                               itself; .pt-weekday-bar owns the width rule (Rule 4). *@
                            <div class="pt-weekday-bar @WeekdayBarClass(d)"
                                 style="--pt-weekday-pct:@(WeekdayBarPercent(d).ToString("F0"))"></div>
                        }
                    </div>
                    <div class="pt-weekday-value">
                        @(d.SampleCount > 0 ? $"{d.MeanDurationSeconds / 60:F0}m" : "—")
                    </div>
                }
            </div>
        </RadzenCard>
    }

    @* #5: weekly congestion grid — which hour of which day actually hurts *@
    <RadzenCard class="rz-mb-4">
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-1">Your week, hour by hour</RadzenText>
        <VolatilityHeatmap Heatmap="_heatmap" />
    </RadzenCard>

    @* Compare this route against another — e.g. the two ways home *@
    <div class="pt-compare-cta rz-mb-4">
        <span class="pt-compare-cta-label">⚖️ Wondering if the other way is faster?</span>
        <RadzenButton Text="Compare with another route" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                      Click="@(() => Nav.NavigateTo($"/compare?a={RouteId}"))" />
    </div>

    @* UX-9: Raw poll table — collapsed by default for stat-lovers *@
    <PollHistoryTable Polls="_todayPolls" />
}

@code {
    [Parameter] public Guid RouteId { get; set; }

    private List<PollRecordDto> _todayPolls = [];
    private List<BaselineSlotDto> _baselineSlots = [];
    private double[] _trendPoints = [];
    private double[] _trendBaseline = [];
    private double[] _trendUpperBand = [];
    private bool[] _trendRerouted = [];
    private string[] _trendLabels = [];
    private PollRecordDto? _selectedPoll;
    private OptimalDepartureDto? _optimalDeparture;
    private string _optimalDepartureLabel = string.Empty;
    private WeekdayComparisonDto? _weekdayComparison;
    private string? _weekdaySummary;
    private VolatilityHeatmapDto? _heatmap;

    /// <summary>
    /// The heatmap aggregates the route's entire history, so a single new sample can
    /// barely move it — refetching it on every 15-second refresh would be a whole-history
    /// scan per tick for a picture that changes hourly. Null until the first fetch.
    /// </summary>
    private DateTimeOffset? _heatmapFetchedAt;
    private static readonly TimeSpan HeatmapMaxAge = TimeSpan.FromMinutes(5);
    private RouteDto? _route;
    private bool _creatingReturn;
    private string _icsHref = string.Empty;

    private double WeekdayMaxMean =>
        _weekdayComparison?.Days.Where(d => d.SampleCount > 0)
            .Select(d => d.MeanDurationSeconds).DefaultIfEmpty(0).Max() ?? 0;

    private double WeekdayBarPercent(WeekdayMeanDto d) =>
        WeekdayMaxMean > 0 ? Math.Max(4, d.MeanDurationSeconds / WeekdayMaxMean * 100) : 0;

    private string WeekdayBarClass(WeekdayMeanDto d) =>
        d.DayOfWeek == _weekdayComparison?.WorstDay ? "pt-weekday-worst"
        : d.DayOfWeek == _weekdayComparison?.BestDay ? "pt-weekday-best"
        : "pt-weekday-normal";
    private SessionDto? _activeSession;
    // Cached rather than derived on each read: the markup reads it five times per render,
    // and re-sorting up to 300 records each time is pure waste. Refreshed in LoadDataAsync.
    private PollRecordDto? LatestPoll { get; set; }

    /// <param name="Value">Static headline, used when there is nothing to count down to.</param>
    /// <param name="Detail">Supporting line under the headline.</param>
    /// <param name="Live">Whether the window is currently sampling.</param>
    /// <param name="CountdownTargetUtc">
    /// When set, the headline is rendered as a self-ticking countdown to this instant
    /// instead of <paramref name="Value"/>.
    /// </param>
    private readonly record struct NextSampleInfo(
        string Value,
        string Detail,
        bool Live,
        DateTimeOffset? CountdownTargetUtc = null);

    // Headline + detail describing when the next traffic sample is expected to complete.
    // Every schedule decision below — is the window open, when does it reopen, what cadence
    // is in force — comes from the server on SessionDto.Schedule. The client only formats it;
    // it deliberately does not re-derive window or cadence rules (see PollScheduleDto).
    private NextSampleInfo NextSample
    {
        get
        {
            if (_activeSession is not { State: SessionState.Active } session)
            {
                return new NextSampleInfo("—", "Start monitoring to begin sampling", Live: false);
            }

            if (session.Schedule is not { } schedule)
            {
                return new NextSampleInfo("Idle", "No polling days scheduled", Live: false);
            }

            // Distinguish "session active but window not open now" from "session active
            // and we're waiting for the next poll tick". "Not open now" covers both a
            // closed time-of-day AND a day the schedule excludes — on a Mon–Fri schedule
            // viewed Saturday the next poll is days away, not "within 5 min".
            if (!schedule.WindowIsOpenNow)
            {
                if (schedule.NextWindowOpenUtc is not { } nextOpen)
                {
                    return new NextSampleInfo("Idle", "No polling days scheduled", Live: false);
                }

                DateTime openLocal = nextOpen.ToLocalTime().DateTime;
                string when = openLocal.Date == DateTime.Now.Date ? "today" : openLocal.ToString("ddd");
                return new NextSampleInfo("Idle", $"Next poll {when} {openLocal:HH:mm}", Live: false);
            }

            if (schedule.NextPollExpectedUtc is not { } nextPoll)
            {
                // Window open but nothing sampled yet — the first poll fires almost immediately,
                // then retries every interval if the traffic provider is unavailable.
                return new NextSampleInfo(
                    "Pending",
                    $"First sample expected within {schedule.PollIntervalMinutes} min",
                    Live: true);
            }

            DateTime nextLocal = nextPoll.ToLocalTime().DateTime;

            // Hand the instant to LiveCountdown rather than formatting a remaining-minutes
            // string here: this getter only runs on the page's refresh, so a string computed
            // now would sit frozen for the next fifteen seconds.
            return new NextSampleInfo(
                Value: string.Empty,
                Detail: $"~{nextLocal:HH:mm:ss} · every {schedule.PollIntervalMinutes} min",
                Live: false,
                CountdownTargetUtc: nextPoll);
        }
    }
    // Observer pattern — PollingComponentBase base handles the timer loop
    protected override TimeSpan PollingInterval => TimeSpan.FromSeconds(15);

    private async Task OnWindowSaved()
    {
        await RefreshAsync();
        StateHasChanged();
    }

    /// <summary>Clicking a sample on the chart surfaces its raw record beneath (#8).</summary>
    private void OnTrendPointSelected(int index) =>
        _selectedPoll = index >= 0 && index < _todayPolls.Count ? _todayPolls[index] : null;

    /// <summary>Creates (or re-uses) the reverse-direction route and navigates to it (#3).</summary>
    private async Task CreateReturnTripAsync()
    {
        _creatingReturn = true;
        try
        {
            HttpResponseMessage resp = await Http.PostAsync($"/api/routes/{RouteId}/return-trip", null);
            if (resp.IsSuccessStatusCode)
            {
                RouteDto? created = await resp.Content.ReadFromJsonAsync(AppJsonContext.Default.RouteDto);
                if (created is not null)
                    Nav.NavigateTo($"/routes/{created.Id}", forceLoad: false);
            }
        }
        catch { /* transient — user can retry */ }
        finally { _creatingReturn = false; }
    }

    /// <summary>"Fridays run 22% slower than Mondays" — null until both a best and a
    /// materially-slower worst day exist.</summary>
    private static string? BuildWeekdaySummary(WeekdayComparisonDto? c)
    {
        if (c?.BestDay is null || c.WorstDay is null || c.BestDay == c.WorstDay)
            return null;
        double best = c.Days.First(d => d.DayOfWeek == c.BestDay).MeanDurationSeconds;
        double worst = c.Days.First(d => d.DayOfWeek == c.WorstDay).MeanDurationSeconds;
        if (best <= 0)
            return null;
        int pct = (int)Math.Round((worst - best) / best * 100);
        return pct < 5
            ? "Your commute is fairly consistent across the week."
            : $"{c.WorstDay}s run {pct}% slower than {c.BestDay}s.";
    }

    protected override async Task LoadDataAsync()
    {
        // Failures propagate deliberately: PollingComponentBase turns them into backoff
        // and the stale banner. Swallowing them here would report every refresh as a
        // success and keep hammering an endpoint that is down.
        string dayOfWeek = DateTime.Today.DayOfWeek.ToString();
        _icsHref = $"/api/routes/{RouteId}/departure.ics?dayOfWeek={dayOfWeek}";
        string sinceUtc = Uri.EscapeDataString(DateTime.UtcNow.AddHours(-24).ToString("o"));

        // None of these six reads depends on another's result, so they all go out at
        // once. Awaited one-by-one, a refresh cost the SUM of six round-trips — every
        // 15 seconds, per open tab.
        Task<RouteDto?> routeTask =
            Http.GetFromJsonAsync($"/api/routes/{RouteId}", AppJsonContext.Default.RouteDto);
        Task<List<SessionDto>?> sessionsTask =
            Http.GetFromJsonAsync($"/api/routes/{RouteId}/sessions", AppJsonContext.Default.ListSessionDto);
        Task<PagedResult<PollRecordDto>?> historyTask =
            Http.GetFromJsonAsync($"/api/routes/{RouteId}/poll-history?page=1&pageSize=300&sinceUtc={sinceUtc}", AppJsonContext.Default.PagedResultPollRecordDto);
        Task<BaselineResponse?> baselineTask =
            Http.GetFromJsonAsync($"/api/routes/{RouteId}/baseline?dayOfWeek={dayOfWeek}", AppJsonContext.Default.BaselineResponse);
        Task<OptimalDepartureDto?> optimalTask =
            Http.GetFromJsonAsync($"/api/routes/{RouteId}/optimal-departure?dayOfWeek={dayOfWeek}", AppJsonContext.Default.OptimalDepartureDto);
        Task<WeekdayComparisonDto?> weekdayTask =
            Http.GetFromJsonAsync($"/api/routes/{RouteId}/weekday-comparison", AppJsonContext.Default.WeekdayComparisonDto);

        // #5: the weekly grid rides along with the fan-out, but only when the copy in
        // hand has aged out — see HeatmapMaxAge.
        bool refreshHeatmap = _heatmapFetchedAt is not { } fetchedAt
            || DateTimeOffset.UtcNow - fetchedAt > HeatmapMaxAge;
        Task<VolatilityHeatmapDto?> heatmapTask = refreshHeatmap
            ? Http.GetFromJsonAsync($"/api/routes/{RouteId}/heatmap", AppJsonContext.Default.VolatilityHeatmapDto)
            : Task.FromResult(_heatmap);

        await Task.WhenAll(routeTask, sessionsTask, historyTask, baselineTask, optimalTask, weekdayTask, heatmapTask);

        // The route itself — drives the return-trip pairing control (#3)
        _route = await routeTask;

        // Today's active monitoring session — carries the server-computed poll schedule
        // that drives the Next Sample ETA card
        DateOnly today = DateOnly.FromDateTime(DateTime.UtcNow.Date);
        _activeSession = (await sessionsTask)?.FirstOrDefault(
            s => s.State == SessionState.Active && s.SessionDate == today);

        // Past 24h poll records
        PagedResult<PollRecordDto>? historyResult = await historyTask;
        if (historyResult is not null)
        {
            _todayPolls = [.. historyResult.Items];
            LatestPoll = _todayPolls.MaxBy(p => p.PolledAtDateTime);
            _trendPoints = [.. _todayPolls.Select(p => p.TravelDurationSeconds / 60.0)];
            _trendRerouted = [.. _todayPolls.Select(p => p.IsRerouted)];
            // Chart tooltips name the sample by wall-clock time (#8).
            _trendLabels = [.. _todayPolls.Select(p => p.PolledAtDateTime.ToString("HH:mm"))];

            // A selection from the previous payload may no longer exist.
            if (_selectedPoll is not null && !_todayPolls.Contains(_selectedPoll))
                _selectedPoll = null;
        }

        BaselineResponse? baseline = await baselineTask;
        if (baseline is not null)
        {
            _baselineSlots = [.. baseline.Slots];
            _trendBaseline = [.. _baselineSlots.Select(s => s.MeanDurationSeconds / 60.0)];
            _trendUpperBand = [.. _baselineSlots
                .Select(s => s.StdDevDurationSeconds.HasValue
                    ? (s.MeanDurationSeconds + s.StdDevDurationSeconds.Value) / 60.0
                    : s.MeanDurationSeconds / 60.0)];
        }

        OptimalDepartureDto? optimal = await optimalTask;
        if (optimal is not null)
        {
            _optimalDeparture = optimal;
            int h = optimal.TimeSlotBucket / 60;
            int m = optimal.TimeSlotBucket % 60;
            _optimalDepartureLabel = $"Best departure: {h:D2}:{m:D2} " +
                $"(~{optimal.PredictedDurationSeconds / 60:F0} min)";
        }

        // Per-weekday comparison (#4)
        _weekdayComparison = await weekdayTask;
        _weekdaySummary = BuildWeekdaySummary(_weekdayComparison);

        // Weekly congestion grid (#5). Only stamp the fetch time on a real round-trip,
        // so a served-from-memory tick doesn't push the next refresh out another 5 minutes.
        _heatmap = await heatmapTask;
        if (refreshHeatmap)
            _heatmapFetchedAt = DateTimeOffset.UtcNow;
    }
}
