@page "/routes/{RouteId:guid}"
@using PoTraffic.Shared.DTOs.History
@using PoTraffic.Shared.DTOs.Routes
@using PoTraffic.Shared.Enums
@using PoTraffic.Client.Features.MonitoringWindows
@inherits PollingComponentBase
@inject HttpClient Http
@inject NavigationManager Nav

@* ──────────────────────────────────────────────────────────────────────
   Route detail — the answer, the evidence, and everything else folded away.

   This page used to stack twelve blocks: three banners, a return-trip bar, a
   three-tile snapshot, a departure scrubber, a window editor, a trend chart, a
   weekday bar chart, a heatmap, a compare prompt and a poll table. Only the
   first answered the question the app exists to answer, and three of them
   answered "when is it bad?" in three different shapes.

   Now: ANSWER (when to leave), one SETTINGS card (arrive by, schedule, return
   trip), and EVIDENCE (map, today's chart, the weekly grid). The header carries
   the name, renameable in place, and one chip saying when the route was last
   checked and when the next check is due.
   ────────────────────────────────────────────────────────────────────── *@

<PageTitle>@_pageTitle — PoTraffic</PageTitle>

@if (IsFirstLoad)
{
    <PtProgressLine AriaLabel="Loading commute" />
}
else
{
    @* The page is reached by tapping a card, and had no way back but the browser's
       own control — which a PWA in standalone display mode does not render.
       The title renames the route in place; the probe state rides the header. *@
    <PageHeader Title="@_pageTitle" BackHref="/dashboard" BackLabel="Commutes"
                TitleChanged="@(_route is null ? default : EventCallback.Factory.Create<string?>(this, OnNameChangedAsync))"
                EditValue="@_route?.Name" EditPlaceholder="e.g. Home → Work">
        <Actions>
            @* Every chart below is generated data for a sample route. The chip says so
               once, beside the title, where a three-line banner used to. *@
            @if (_route?.IsSample == true)
            {
                <span class="pt-sample-chip" title="Generated history — never probed or counted against your quota">Sample data</span>
            }
            @if (_route is not null)
            {
                <RouteProbeStatus RouteId="RouteId"
                                  LatestProbe="LatestPoll"
                                  Session="_activeSession"
                                  OnProbeCompleted="@OnWindowSaved" />
            }
        </Actions>
    </PageHeader>

    <StaleBanner IsOffline="IsOffline" IsStale="IsStale" />

    @if (_route is null && _notFound)
    {
        <div class="pt-empty-state">
            <PtIcon Name="explore_off" Size="xl" Class="pt-empty-state-icon" />
            <div class="pt-empty-state-title">This commute doesn't exist</div>
            <div class="pt-empty-state-text">It may have been deleted, or the link is wrong.</div>
            <RadzenButton Text="Back to commutes" ButtonStyle="ButtonStyle.Light" Icon="arrow_back"
                          Click="@(() => Nav.NavigateTo("/dashboard"))" />
        </div>
    }
    else if (_route is null)
    {
        @* Nothing ever loaded. Rendering the sections below in this state produced a
           route header with no addresses — a bare "→" — over the words "Still
           learning this route", which reads as a fact about the commute when it is
           really a failed request. An empty answer is worse than no answer. *@
        <div class="pt-empty-state">
            <PtIcon Name="cloud_off" Size="xl" Class="pt-empty-state-icon" />
            <div class="pt-empty-state-title">Couldn't load this commute</div>
            <div class="pt-empty-state-text">
                @* Deliberately not "the server didn't respond": the same branch covers a
                   route that has since been deleted, where the server answered fine. *@
                @(IsOffline
                    ? "You're offline. This page will fill in as soon as you're back."
                    : "The request failed. Retrying automatically — the commute may also have been deleted.")
            </div>
            <RadzenButton Text="Retry now" ButtonStyle="ButtonStyle.Light" Icon="refresh"
                          Click="@RefreshAsync" />
        </div>
    }
    else
    {

    @* Two columns past 1200px: the answer and every control that acts on it on the
       left, every piece of EVIDENCE on the right. Below 1200px, one column. *@
    <div class="pt-route-two">

    <aside class="pt-route-side">

    @* ── THE ANSWER ────────────────────────────────────────────────────
       Leads with "Leave by" whenever there is a plan, because that is the question the
       app exists to answer; the day's range of durations is the supporting line. The
       arrive-by input lives here, beside the answer it produces — in the settings card
       below it was a field users had to find before the page would say anything useful. *@
    <section class="pt-answer" aria-label="Route summary">
        @* The title already reads "Origin → Destination" unless the route is named. *@
        @if (_route.Name is not null)
        {
            <div class="pt-answer-route">
                <span class="pt-answer-from">@_originStreet</span>
                <PtIcon Name="arrow_right_alt" Size="sm" Class="pt-answer-arrow" />
                <span class="pt-answer-to">@_destStreet</span>
            </div>
        }

        @if (_plan is { LeaveBy: { } leaveBy } plan)
        {
            <div class="pt-answer-headline">Leave by @LocalTimeFormatter.FormatWallClock(leaveBy)</div>
            <div class="pt-answer-meta">
                On time on @plan.OnTimePercent% of @plan.SampleCount recorded trips —
                usually @(plan.TypicalSeconds / 60) min, up to @(plan.WorstCaseSeconds / 60) min.
                @if (!plan.DayOfWeekSpecific)
                {
                    <span>Based on every day until today's history fills in.</span>
                }
            </div>
        }
        else if (_todayPolls.Count == 0)
        {
            <div class="pt-answer-headline pt-answer-pending">Still learning this commute</div>
            <div class="pt-answer-duration">@_pendingDetail</div>
        }
        else
        {
            <div class="pt-answer-headline">@_durationLabel</div>
        }

        @if (_plan is { LeaveBy: null })
        {
            <div class="pt-answer-meta">
                Not enough trips in the three hours before @LocalTimeFormatter.FormatWallClock(_plan.ArriveBy)
                to plan a departure yet — the monitoring window needs to cover when you'd leave.
            </div>
        }

        @if (_todayPolls.Count > 0)
        {
            <div class="pt-answer-meta">
                @if (_plan is { LeaveBy: not null })
                {
                    <span>@_durationLabel ·</span>
                }
                @_confidenceNote
                <a class="pt-answer-ics pt-tap" href="@_icsHref" download="departure.ics">Add to calendar</a>
            </div>
        }

        <label class="pt-answer-arrive">
            <span class="pt-setting-label">Arrive by</span>
            <input type="time" class="pt-setting-input" value="@_route.ArriveBy" @onchange="OnArriveByChangedAsync"
                   aria-label="Time you need to arrive" />
            @if (_plan is null)
            {
                <span class="pt-answer-arrive-hint">to get a leave-by time</span>
            }
        </label>

        @if (LatestPoll?.HolidayName is { } holiday)
        {
            <div class="pt-answer-meta">
                Today is @holiday — its trips are shown here but don't count toward your usual times.
            </div>
        }
    </section>

    @* ── THE CONTROLS ────────────────────────────────────────────────────
       Schedule and return trip. Not for the sample: it is never probed, so a schedule
       form on it offers something that would do nothing, and a reversed copy of
       generated data would be a second fake route. *@
    @if (!_route.IsSample)
    {
        <RadzenCard class="pt-route-settings">
            <WindowConfigPanel RouteId="RouteId" Window="_activeWindow" Session="_activeSession" OnSaved="OnWindowSaved" />

            @* Both states go through the same call: the endpoint creates the reversed route and
               links it, or hands back the one already linked. Navigating straight to a stored
               ReturnRouteId could open a route that had since been deleted. *@
            <div class="pt-setting-row">
                <span class="pt-setting-label">Return trip</span>
                <span class="pt-setting-value">@(_route.ReturnRouteId is not null ? "Linked" : "Not tracked")</span>
                <RadzenButton Text="@(_route.ReturnRouteId is not null ? "View" : "Track return trip")"
                              ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                              Click="CreateReturnTripAsync" IsBusy="_creatingReturn" />
            </div>
        </RadzenCard>
    }

    </aside>

    @* ── THE EVIDENCE ──────────────────────────────────────────────────
       The drive and today's samples share a row; the week sits under both. *@
    <div class="pt-route-evidence">

    <div class="pt-route-evidence-top">

    <RadzenCard>
        <RadzenText TextStyle="TextStyle.H3" class="pt-mb-1 pt-section-heading">The drive</RadzenText>
        <RouteMap Path="_path"
                  OriginLabel="@_originStreet"
                  DestinationLabel="@_destStreet" />
    </RadzenCard>

    <RadzenCard>
        @* Not pt-mb-0: the canvas draws its "min" axis caption at its own top edge,
           which collided with this heading's descenders. *@
        <RadzenText TextStyle="TextStyle.H3" class="pt-mb-2 pt-section-heading">Today</RadzenText>

        <TrendChart Points="@_trendPoints"
                    Labels="@_trendLabels"
                    OnPointSelected="OnTrendPointSelected" />

        @if (_selectedPoll is { } selected)
        {
            <div class="pt-trend-selection">
                <span class="pt-trend-selection-time">@selected.PolledAtDateTime.ToString("HH:mm:ss")</span>
                <span class="pt-trend-selection-value">@(selected.TravelDurationSeconds / 60) min</span>
                <span class="pt-trend-selection-meta">
                    @TextFormatting.Distance(selected.DistanceMetres)
                    @if (selected.IsRerouted)
                    {
                        <span class="pt-trend-selection-flag">rerouted</span>
                    }
                </span>
                <button type="button" class="pt-trend-selection-clear"
                        aria-label="Clear selection" @onclick="() => _selectedPoll = null">
                    <PtIcon Name="close" Size="sm" />
                </button>
            </div>
        }
    </RadzenCard>

    </div>

    <RadzenCard>
        <RadzenText TextStyle="TextStyle.H3" class="pt-mb-1 pt-section-heading">Your week, hour by hour</RadzenText>
        <VolatilityHeatmap Heatmap="_heatmap" />

        @* Sits under the weekly grid because it answers the question the grid provokes:
           the grid shows that some mornings are worse, this says which of them were wet. *@
        <WeatherImpact Impact="_weatherImpact" />
    </RadzenCard>

    </div>
    </div>

    }
}

@code {
    [Parameter] public Guid RouteId { get; set; }

    /// <summary>The route this page is showing. Changing it reloads the page from scratch.</summary>
    protected override object? SubjectKey => RouteId;

    /// <summary>
    /// Drops everything held for the previous route. The two fetch timestamps matter most:
    /// they gate their fetches on a five-minute window, so without clearing them the weekly
    /// grid and the weather card would keep showing the route you just navigated away from.
    /// </summary>
    protected override void ResetForSubjectChange()
    {
        _route = null;
        _path = null;
        _heatmap = null;
        _heatmapFetchedAt = null;
        _weatherImpact = null;
        _weatherFetchedAt = null;
        _todayPolls = [];
        _trendPoints = [];
        _trendLabels = [];
        _selectedPoll = null;
        _plan = null;
        _activeSession = null;
        _activeWindow = null;
        LatestPoll = null;
        _pageTitle = "Commute";
        _originStreet = string.Empty;
        _destStreet = string.Empty;
    }

    /// <summary>
    /// Oldest first. Every chart series is built by position from this list, so its order
    /// IS the x-axis.
    /// </summary>
    private List<PollRecordDto> _todayPolls = [];
    private double[] _trendPoints = [];
    private string[] _trendLabels = [];
    private PollRecordDto? _selectedPoll;
    private DeparturePlanDto? _plan;
    private VolatilityHeatmapDto? _heatmap;
    private RoutePathDto? _path;

    private RouteDto? _route;
    private bool _notFound;
    private SessionDto? _activeSession;
    private MonitoringWindowDto? _activeWindow;
    private bool _creatingReturn;
    private string _icsHref = string.Empty;

    // The answer, pre-formatted. Built once per load rather than in the markup,
    // which would recompute them on every one of the page's refreshes.
    private string _originStreet = string.Empty;
    private string _destStreet = string.Empty;
    private string _durationLabel = string.Empty;
    private string _confidenceNote = string.Empty;
    private string _pendingDetail = string.Empty;
    /// <summary>
    /// Heading for the page. Two fallbacks: "Route" until the route lands so the
    /// header has something to render during the first paint, and "Route not
    /// found" once we've tried and the server said no — the bare "Route" was
    /// misleading on its own when the rest of the page is an empty state.
    /// </summary>
    private string _pageTitle = "Commute";

    /// <summary>
    /// The heatmap aggregates the route's entire history, so a single new sample can
    /// barely move it — refetching it on every 15-second refresh would be a whole-history
    /// scan per tick for a picture that changes hourly. Null until the first fetch.
    /// </summary>
    private DateTimeOffset? _heatmapFetchedAt;
    private static readonly TimeSpan HeatmapMaxAge = TimeSpan.FromMinutes(5);

    /// <summary>
    /// Weather impact is the same shape of aggregate as the heatmap — the whole history
    /// behind a picture that shifts over days, not seconds — so it rides the same cadence
    /// rather than the 15-second refresh.
    /// </summary>
    private WeatherImpactResponse? _weatherImpact;
    private DateTimeOffset? _weatherFetchedAt;
    private static readonly TimeSpan WeatherMaxAge = TimeSpan.FromMinutes(5);

    // Cached rather than derived on each read: the markup reads it several times
    // per render, and re-sorting up to 300 records each time is pure waste.
    private PollRecordDto? LatestPoll { get; set; }

    // Observer pattern — PollingComponentBase handles the timer loop
    protected override TimeSpan PollingInterval => TimeSpan.FromSeconds(15);

    private async Task OnWindowSaved()
    {
        await RefreshAsync();
        StateHasChanged();
    }

    /// <summary>Clicking a sample on the chart surfaces its raw record beneath.</summary>
    private void OnTrendPointSelected(int index) =>
        _selectedPoll = index >= 0 && index < _todayPolls.Count ? _todayPolls[index] : null;

    /// <summary>Creates (or re-uses) the reverse-direction route and navigates to it.</summary>
    private async Task CreateReturnTripAsync()
    {
        _creatingReturn = true;
        try
        {
            HttpResponseMessage resp = await Http.PostAsync($"/api/routes/{RouteId}/return-trip", null);
            if (resp.IsSuccessStatusCode)
            {
                RouteDto? created = await resp.Content.ReadFromJsonAsync(AppJsonContext.Default.RouteDto);
                if (created is not null && created.Id.Value != RouteId)
                {
                    // forceLoad stays false: PollingComponentBase now reloads on a route
                    // change, so this is a normal SPA navigation rather than a full
                    // WASM restart. Before that it navigated and showed the old route.
                    Nav.NavigateTo($"/routes/{created.Id}", forceLoad: false);
                }
            }
        }
        catch { /* transient — user can retry */ }
        finally { _creatingReturn = false; }
    }

    protected override async Task LoadDataAsync()
    {
        // Failures propagate deliberately: PollingComponentBase turns them into backoff
        // and the stale banner. Swallowing them here would report every refresh as a
        // success and keep hammering an endpoint that is down.
        string dayOfWeek = DateTime.Today.DayOfWeek.ToString();
        _icsHref = $"/api/routes/{RouteId}/departure.ics?dayOfWeek={dayOfWeek}";
        string sinceUtc = Uri.EscapeDataString(DateTime.UtcNow.AddHours(-24).ToString("o"));

        // None of these reads depends on another's result, so they all go out at once.
        // Awaited one-by-one, a refresh cost the SUM of the round-trips — every 15
        // seconds, per open tab.
        Task<RouteDto?> routeTask = LoadRouteAsync();
        Task<List<SessionDto>?> sessionsTask =
            Http.GetFromJsonAsync($"/api/routes/{RouteId}/sessions", AppJsonContext.Default.ListSessionDto);
        Task<PagedResult<PollRecordDto>?> historyTask =
            Http.GetFromJsonAsync($"/api/routes/{RouteId}/poll-history?page=1&pageSize=300&sinceUtc={sinceUtc}", AppJsonContext.Default.PagedResultPollRecordDto);
        Task<DeparturePlanDto?> planTask = GetOptionalAsync(
            $"/api/routes/{RouteId}/departure-plan?dayOfWeek={dayOfWeek}", AppJsonContext.Default.DeparturePlanDto);

        // The road shape is fetched from the provider once per route and stored, so this
        // rides the normal refresh cadence: after the first call the server is only
        // re-deciding the colour, which is exactly what should follow a new sample.
        // 404 when the route's coordinates can't be parsed — RouteMap has an empty state for that.
        Task<RoutePathDto?> pathTask =
            GetOptionalAsync($"/api/routes/{RouteId}/path", AppJsonContext.Default.RoutePathDto);

        // The weekly grid rides along with the fan-out, but only when the copy in hand
        // has aged out — see HeatmapMaxAge.
        bool refreshHeatmap = _heatmapFetchedAt is not { } fetchedAt
            || DateTimeOffset.UtcNow - fetchedAt > HeatmapMaxAge;
        Task<VolatilityHeatmapDto?> heatmapTask = refreshHeatmap
            ? Http.GetFromJsonAsync($"/api/routes/{RouteId}/heatmap", AppJsonContext.Default.VolatilityHeatmapDto)
            : Task.FromResult(_heatmap);

        bool refreshWeather = _weatherFetchedAt is not { } weatherAt
            || DateTimeOffset.UtcNow - weatherAt > WeatherMaxAge;
        Task<WeatherImpactResponse?> weatherTask = refreshWeather
            ? Http.GetFromJsonAsync($"/api/routes/{RouteId}/weather-impact", AppJsonContext.Default.WeatherImpactResponse)
            : Task.FromResult(_weatherImpact);

        await Task.WhenAll(routeTask, sessionsTask, historyTask, planTask, heatmapTask, pathTask, weatherTask);

        _path = await pathTask;

        _route = await routeTask;
        if (_route is not null)
        {
            // See RouteCard.razor — title-case at the read site so the dashboard
            // list and this header always render the same casing for the same
            // street, regardless of how the address was first entered.
            _originStreet = TextFormatting.ToTitleCase(_route.OriginAddress.Split(',')[0]);
            _destStreet = TextFormatting.ToTitleCase(_route.DestinationAddress.Split(',')[0]);
            _pageTitle = _route.Name ?? $"{_originStreet} → {_destStreet}";
            _activeWindow = _route.Windows.FirstOrDefault(w => w.IsActive);
        }
        else
        {
            // The route genuinely doesn't exist (or isn't ours). "Route" on its
            // own reads as a real heading next to the empty state, not as a
            // loading placeholder, so swap to something that pairs with the
            // "Couldn't load this commute" copy below.
            _pageTitle = "Commute not found";
        }

        // Today's active monitoring session — carries the server-computed poll schedule.
        DateOnly today = DateOnly.FromDateTime(DateTime.UtcNow.Date);
        _activeSession = (await sessionsTask)?.FirstOrDefault(
            s => s.State == SessionState.Active && s.SessionDate == today);

        PagedResult<PollRecordDto>? historyResult = await historyTask;
        if (historyResult is not null)
        {
            // Newest-first off the wire is wrong for everything plotted: the trend line
            // drew today in reverse, so its x-axis ran 08:45 → 08:00 → 18:30. Sorted once
            // here rather than at each of the projections below, all of which are positional.
            _todayPolls = [.. historyResult.Items.OrderBy(p => p.PolledAtDateTime)];
            LatestPoll = _todayPolls.Count > 0 ? _todayPolls[^1] : null;
            _trendPoints = [.. _todayPolls.Select(p => p.TravelDurationSeconds / 60.0)];
            _trendLabels = [.. _todayPolls.Select(p => p.PolledAtDateTime.ToString("HH:mm"))];

            // A selection from the previous payload may no longer exist.
            if (_selectedPoll is not null && !_todayPolls.Contains(_selectedPoll))
                _selectedPoll = null;
        }

        _plan = await planTask;
        BuildAnswer();

        _heatmap = await heatmapTask;
        if (refreshHeatmap)
            _heatmapFetchedAt = DateTimeOffset.UtcNow;

        _weatherImpact = await weatherTask;
        if (refreshWeather)
            _weatherFetchedAt = DateTimeOffset.UtcNow;
    }

    private async Task OnNameChangedAsync(string? name)
    {
        try
        {
            HttpResponseMessage resp = await Http.PutAsJsonAsync($"/api/routes/{RouteId}/name",
                new SetRouteNameRequest(name), AppJsonContext.Default.SetRouteNameRequest);
            if (resp.IsSuccessStatusCode)
                await RefreshAsync();
        }
        catch (HttpRequestException) { /* offline — the header keeps the saved name */ }
    }

    /// <summary>Saves the arrive-by target (empty clears it) and reloads the plan.</summary>
    private async Task OnArriveByChangedAsync(ChangeEventArgs e)
    {
        // Browsers hand back "HH:mm", or "HH:mm:ss" when a step below a minute is set.
        string? value = e.Value is string { Length: >= 5 } s ? s[..5] : null;
        try
        {
            HttpResponseMessage resp = await Http.PutAsJsonAsync($"/api/routes/{RouteId}/arrive-by",
                new SetArriveByRequest(value), AppJsonContext.Default.SetArriveByRequest);
            if (resp.IsSuccessStatusCode)
                await RefreshAsync();
        }
        catch (HttpRequestException) { /* offline — the next refresh restores the saved value */ }
    }

    /// <summary>
    /// Reads the departure recommendation, treating "there isn't one yet" as a value
    /// rather than an error.
    ///
    /// The endpoint answers 204 No Content until a route has enough history to
    /// recommend anything — the normal state of every route for its first few days.
    /// GetFromJsonAsync counts 204 as success and then throws parsing the empty body,
    /// and because this page deliberately lets load failures propagate (so a genuinely
    /// down endpoint produces backoff and the stale banner), that exception took the
    /// whole page down: a brand-new route showed "Couldn't load this commute — the route
    /// may also have been deleted" from the moment it was created. The page already
    /// has the right words for this state a few lines below ("Still learning this
    /// route"); it simply never got to render them.
    ///
    /// The dashboard calls the same endpoint inside a try/catch, which is why the
    /// cards were unaffected and the bug only appeared one tap deeper.
    /// </summary>
    private async Task<T?> GetOptionalAsync<T>(string url, System.Text.Json.Serialization.Metadata.JsonTypeInfo<T> typeInfo)
        where T : class
    {
        HttpResponseMessage response = await Http.GetAsync(url);

        if (response.StatusCode is System.Net.HttpStatusCode.NoContent or System.Net.HttpStatusCode.NotFound)
            return null;

        // Anything else that isn't success SHOULD still propagate — that is the
        // signal PollingComponentBase turns into backoff.
        response.EnsureSuccessStatusCode();

        if (response.Content.Headers.ContentLength is 0)
            return null;

        return await response.Content.ReadFromJsonAsync(typeInfo);
    }

    /// <summary>
    /// Loads the route and converts a 404 — "this id doesn't exist, or it isn't
    /// yours" — into a successful <c>null</c> result so the page can render its
    /// empty state with the "Route not found" heading instead of going into
    /// exponential backoff. Any other failure (network, 5xx) still propagates
    /// to <see cref="PollingComponentBase"/> so the existing retry-with-backoff
    /// machinery keeps working.
    /// </summary>
    private async Task<RouteDto?> LoadRouteAsync()
    {
        HttpResponseMessage response = await Http.GetAsync($"/api/routes/{RouteId}");
        _notFound = response.StatusCode == System.Net.HttpStatusCode.NotFound;
        if (_notFound)
        {
            _pageTitle = "Commute not found";
            return null;
        }
        response.EnsureSuccessStatusCode();
        return await response.Content.ReadFromJsonAsync(AppJsonContext.Default.RouteDto);
    }

    /// <summary>
    /// Formats the answer card's duration line: the fastest and slowest of today's
    /// samples. It is the headline only until an arrive-by target yields a plan.
    /// </summary>
    private void BuildAnswer()
    {
        if (_todayPolls.Count == 0)
        {
            _pendingDetail = "No samples recorded yet.";
            return;
        }

        // The polled values are whole seconds. Round to minutes so the worst
        // ever reads as the integer minute a reader would actually feel on
        // the road; truncation (the previous behaviour) under-reported every
        // sample shorter than 60 s as zero.
        int bestMin = (int)Math.Round(_todayPolls.Min(p => p.TravelDurationSeconds) / 60.0);
        int worstMin = (int)Math.Round(_todayPolls.Max(p => p.TravelDurationSeconds) / 60.0);

        _durationLabel = bestMin == worstMin
            ? $"{bestMin} min today"
            : $"{bestMin}–{worstMin} min today";

        _confidenceNote = $"{_todayPolls.Count} sample{(_todayPolls.Count == 1 ? "" : "s")} so far today.";
    }
}
