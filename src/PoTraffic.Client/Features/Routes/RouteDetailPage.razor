@page "/routes/{RouteId:guid}"
@using PoTraffic.Shared.DTOs.History
@using PoTraffic.Shared.DTOs.Routes
@using PoTraffic.Shared.Enums
@using PoTraffic.Shared.Constants
@using PoTraffic.Client.Features.MonitoringWindows
@inherits PollingComponentBase
@inject HttpClient Http
@inject NavigationManager Nav

@* ──────────────────────────────────────────────────────────────────────
   Route detail — the answer, the evidence, and everything else folded away.

   This page used to stack twelve blocks: three banners, a return-trip bar, a
   three-tile snapshot, a departure scrubber, a window editor, a trend chart, a
   weekday bar chart, a heatmap, a compare prompt and a poll table. Only the
   first answered the question the app exists to answer, and three of them
   answered "when is it bad?" in three different shapes.

   Now: ANSWER (when to leave), EVIDENCE (one chart, one weekly grid), and a
   single Details disclosure holding the settings and the raw records.
   ────────────────────────────────────────────────────────────────────── *@

<PageTitle>Route Detail — PoTraffic</PageTitle>

@if (IsFirstLoad)
{
    <PtProgressLine AriaLabel="Loading route" />
}
else
{
    @* The page is reached by tapping a card, and had no way back but the browser's
       own control — which a PWA in standalone display mode does not render. *@
    <PageHeader Title="@_pageTitle" BackHref="/dashboard" BackLabel="Commutes" />

    @if (IsOffline || IsStale)
    {
        <div class="pt-stale-banner pt-enter" role="status">
            <PtIcon Name="@(IsOffline ? "wifi_off" : "cloud_off")" Size="sm" />
            @(IsOffline ? "Offline — showing the last data received." :
                          "Can't reach the server — retrying.")
        </div>
    }

    @if (_route is null)
    {
        @* Nothing ever loaded. Rendering the sections below in this state produced a
           route header with no addresses — a bare "→" — over the words "Still
           learning this route", which reads as a fact about the commute when it is
           really a failed request. An empty answer is worse than no answer. *@
        <div class="pt-empty-state">
            <PtIcon Name="cloud_off" Size="xl" Class="pt-empty-state-icon" />
            <div class="pt-empty-state-title">Couldn't load this route</div>
            <div class="pt-empty-state-text">
                @* Deliberately not "the server didn't respond": the same branch covers a
                   route that has since been deleted, where the server answered fine. *@
                @(IsOffline
                    ? "You're offline. This page will fill in as soon as you're back."
                    : "The request failed. Retrying automatically — the route may also have been deleted.")
            </div>
            <RadzenButton Text="Retry now" ButtonStyle="ButtonStyle.Light" Icon="refresh"
                          Click="@RefreshAsync" />
        </div>
    }
    else
    {

    @if (_route.IsDemo)
    {
        <div class="pt-demo-banner pt-mb-4 pt-enter" role="note">
            <span class="pt-demo-banner-tag">SAMPLE DATA</span>
            <span class="pt-demo-banner-text">
                Every number below was generated. Add your own route to collect real samples.
            </span>
            <RadzenButton Text="Add a real route" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                          Click="@(() => Nav.NavigateTo("/routes/create"))" />
        </div>
    }

    @* ── THE ANSWER ────────────────────────────────────────────────────
       Route name, when to leave, how long, how live the number is. Nothing
       else competes for this space. *@
    <section class="pt-answer" aria-label="Departure recommendation">
        <div class="pt-answer-route">
            <span class="pt-answer-from">@_originStreet</span>
            <PtIcon Name="arrow_right_alt" Size="sm" Class="pt-answer-arrow" />
            <span class="pt-answer-to">@_destStreet</span>
        </div>

        @if (_optimalDeparture is { } optimal)
        {
            <div class="pt-answer-headline">@_leaveByLabel</div>
            <div class="pt-answer-duration">@_durationLabel</div>
            <div class="pt-answer-meta">
                @_confidenceNote
                <a class="pt-answer-ics" href="@_icsHref" download="departure.ics">Add to calendar</a>
            </div>
        }
        else
        {
            <div class="pt-answer-headline pt-answer-pending">Still learning this route</div>
            <div class="pt-answer-duration">@_pendingDetail</div>
        }

        @{
            NextSampleInfo next = NextSample;
        }
        <div class="pt-answer-live">
            <span class="pt-status-dot @(next.Live ? "pt-status-dot-green" : "pt-status-dot-amber")"></span>
            @if (next.CountdownTargetUtc is { } target)
            {
                <text>Next sample in&nbsp;</text>
                <LiveCountdown TargetUtc="target"
                               PeriodHint="@TimeSpan.FromMinutes(_activeSession?.Schedule?.PollIntervalMinutes ?? 5)"
                               DueText="moments" />
            }
            else
            {
                @next.Detail
            }
        </div>
    </section>

    @* ── THE EVIDENCE ──────────────────────────────────────────────────
       Today's samples against the baseline, and the week at a glance. The
       departure scrubber and the weekday bar chart were removed: all three
       read the same baseline, and the grid says what both of them said. *@
    <RadzenCard class="pt-mb-4">
        <div class="pt-evidence-head">
            <RadzenText TextStyle="TextStyle.H6" class="pt-mb-0">Today</RadzenText>
            @if (_comparableRoutes.Count > 0)
            {
                @* Comparison folded in from the standalone /compare page: it is a
                   second line on this chart, not a destination of its own.

                   A bare <select> here was the only native form control left in the
                   app — a different height, border and focus ring from every Radzen
                   input beside it, and on a phone it opened the OS picker wheel while
                   the identical control in Settings opened a styled list. AllowClear
                   also gives back the "stop comparing" path that the placeholder
                   <option value=""> was standing in for. *@
                <RadzenDropDown Data="@_compareOptions" TValue="string"
                                Value="@_compareRouteId"
                                Change="@OnCompareChanged"
                                ValueProperty="Id" TextProperty="Label"
                                AllowClear="true" AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Placeholder="Compare with…"
                                class="pt-compare-select"
                                aria-label="Compare with another route" />
            }
        </div>

        @if (_compareLabel is not null)
        {
            <div class="pt-compare-legend">
                <span class="pt-compare-legend-item">
                    <span class="pt-compare-key pt-compare-key-a" aria-hidden="true"></span>@_thisLabel
                </span>
                <span class="pt-compare-legend-item">
                    <span class="pt-compare-key pt-compare-key-b" aria-hidden="true"></span>@_compareLabel
                </span>
                @if (_compareVerdict is not null)
                {
                    <span class="pt-compare-verdict-inline">@_compareVerdict</span>
                }
            </div>
        }

        <TrendChart Points="@_trendPoints"
                    Baseline="@_trendBaseline"
                    UpperBand="@_trendUpperBand"
                    ComparePoints="@_comparePoints"
                    ReroutedFlags="@_trendRerouted"
                    Labels="@_trendLabels"
                    SeriesName="@_thisLabel"
                    CompareSeriesName="@(_compareLabel ?? "Other route")"
                    OnPointSelected="OnTrendPointSelected" />

        @if (_selectedPoll is { } selected)
        {
            <div class="pt-trend-selection">
                <span class="pt-trend-selection-time">@selected.PolledAtDateTime.ToString("HH:mm:ss")</span>
                <span class="pt-trend-selection-value">@(selected.TravelDurationSeconds / 60) min</span>
                <span class="pt-trend-selection-meta">
                    @($"{selected.DistanceMetres * 0.000621371:F1} mi")
                    @if (selected.IsRerouted)
                    {
                        <span class="pt-trend-selection-flag">rerouted</span>
                    }
                </span>
                <button type="button" class="pt-trend-selection-clear"
                        aria-label="Clear selection" @onclick="() => _selectedPoll = null">
                    <PtIcon Name="close" Size="sm" />
                </button>
            </div>
        }
    </RadzenCard>

    <RadzenCard class="pt-mb-4">
        <RadzenText TextStyle="TextStyle.H6" class="pt-mb-1">Your week, hour by hour</RadzenText>
        <VolatilityHeatmap Heatmap="_heatmap" />
    </RadzenCard>

    @* ── EVERYTHING ELSE ───────────────────────────────────────────────
       Schedule, return trip and raw records. Real controls, rarely needed,
       behind one disclosure instead of three cards. *@
    <details class="pt-details">
        <summary class="pt-details-summary">
            <PtIcon Name="chevron_right" Class="pt-collapsible-icon" />
            Settings &amp; raw data
        </summary>

        <div class="pt-details-body">
            @if (!_route.IsDemo)
            {
                <div class="pt-returntrip-bar pt-mb-4">
                    @if (_route.ReturnRouteId is RouteId rid)
                    {
                        <span class="pt-returntrip-label">Return trip linked</span>
                        <RadzenButton Text="View return trip" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="@(() => Nav.NavigateTo($"/routes/{rid}"))" />
                    }
                    else
                    {
                        <span class="pt-returntrip-label">Also track the trip home?</span>
                        <RadzenButton Text="Track return trip" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="CreateReturnTripAsync" IsBusy="_creatingReturn" />
                    }
                </div>

                <WindowConfigPanel RouteId="RouteId" OnSaved="OnWindowSaved" />
            }

            <PollHistoryTable Polls="_pollsNewestFirst" />
        </div>
    </details>

    }
}

@code {
    [Parameter] public Guid RouteId { get; set; }

    /// <summary>
    /// Oldest first. Every chart series is built by position from this list, so its order
    /// IS the x-axis; the raw table gets <see cref="_pollsNewestFirst"/> instead, which is
    /// how a log wants to read.
    /// </summary>
    private List<PollRecordDto> _todayPolls = [];
    private List<PollRecordDto> _pollsNewestFirst = [];
    private double[] _trendPoints = [];
    private double[] _trendBaseline = [];
    private double[] _trendUpperBand = [];
    private double[] _comparePoints = [];
    private bool[] _trendRerouted = [];
    private string[] _trendLabels = [];
    private PollRecordDto? _selectedPoll;
    private OptimalDepartureDto? _optimalDeparture;
    private VolatilityHeatmapDto? _heatmap;
    private RouteDto? _route;
    private SessionDto? _activeSession;
    private bool _creatingReturn;
    private string _icsHref = string.Empty;

    // The answer, pre-formatted. Built once per load rather than in the markup,
    // which would recompute them on every one of the page's refreshes.
    private string _originStreet = string.Empty;
    private string _destStreet = string.Empty;
    private string _leaveByLabel = string.Empty;
    private string _durationLabel = string.Empty;
    private string _confidenceNote = string.Empty;
    private string _pendingDetail = string.Empty;
    private string _thisLabel = "This route";

    // Comparison, folded in from the standalone /compare page.
    private List<RouteDto> _comparableRoutes = [];
    private string _compareRouteId = string.Empty;
    private string? _compareLabel;
    private string? _compareVerdict;

    /// <summary>
    /// What the picker binds to. RadzenDropDown reads a value and a text member off each
    /// item, and RouteDto exposes neither a string id nor a display label — projecting
    /// once here beats a Template that would re-run per item per render.
    /// </summary>
    private sealed record CompareOption(string Id, string Label);

    private List<CompareOption> _compareOptions = [];

    /// <summary>Heading for the page. Falls back until the route lands.</summary>
    private string _pageTitle = "Route";

    /// <summary>
    /// The heatmap aggregates the route's entire history, so a single new sample can
    /// barely move it — refetching it on every 15-second refresh would be a whole-history
    /// scan per tick for a picture that changes hourly. Null until the first fetch.
    /// </summary>
    private DateTimeOffset? _heatmapFetchedAt;
    private static readonly TimeSpan HeatmapMaxAge = TimeSpan.FromMinutes(5);

    // Cached rather than derived on each read: the markup reads it several times
    // per render, and re-sorting up to 300 records each time is pure waste.
    private PollRecordDto? LatestPoll { get; set; }

    /// <param name="Detail">Supporting line under the headline.</param>
    /// <param name="Live">Whether the window is currently sampling.</param>
    /// <param name="CountdownTargetUtc">
    /// When set, the line is rendered as a self-ticking countdown to this instant.
    /// </param>
    private readonly record struct NextSampleInfo(
        string Detail,
        bool Live,
        DateTimeOffset? CountdownTargetUtc = null);

    // When the next traffic sample is expected. Every schedule decision — is the window
    // open, when does it reopen, what cadence is in force — comes from the server on
    // SessionDto.Schedule. The client only formats it.
    private NextSampleInfo NextSample
    {
        get
        {
            if (_activeSession is not { State: SessionState.Active } session)
                return new NextSampleInfo("Not monitoring — start it in Settings below", Live: false);

            if (session.Schedule is not { } schedule)
                return new NextSampleInfo("No polling days scheduled", Live: false);

            // Distinguish "session active but window not open now" from "waiting for the
            // next poll tick". On a Mon–Fri schedule viewed Saturday the next poll is days
            // away, not "within 5 min".
            if (!schedule.WindowIsOpenNow)
            {
                if (schedule.NextWindowOpenUtc is not { } nextOpen)
                    return new NextSampleInfo("No polling days scheduled", Live: false);

                DateTime openLocal = nextOpen.ToLocalTime().DateTime;
                string when = openLocal.Date == DateTime.Now.Date ? "today" : openLocal.ToString("ddd");
                return new NextSampleInfo($"Next sample {when} at {openLocal:HH:mm}", Live: false);
            }

            if (schedule.NextPollExpectedUtc is not { } nextPoll)
            {
                return new NextSampleInfo(
                    $"First sample expected within {schedule.PollIntervalMinutes} min", Live: true);
            }

            // Hand the instant to LiveCountdown rather than formatting a remaining-minutes
            // string here: this getter only runs on the page's refresh, so a string computed
            // now would sit frozen for the next fifteen seconds.
            return new NextSampleInfo(string.Empty, Live: true, CountdownTargetUtc: nextPoll);
        }
    }

    // Observer pattern — PollingComponentBase handles the timer loop
    protected override TimeSpan PollingInterval => TimeSpan.FromSeconds(15);

    private static string RouteLabel(RouteDto route) =>
        $"{route.OriginAddress.Split(',')[0].Trim()} → {route.DestinationAddress.Split(',')[0].Trim()}";

    private async Task OnWindowSaved()
    {
        await RefreshAsync();
        StateHasChanged();
    }

    /// <summary>Clicking a sample on the chart surfaces its raw record beneath.</summary>
    private void OnTrendPointSelected(int index) =>
        _selectedPoll = index >= 0 && index < _todayPolls.Count ? _todayPolls[index] : null;

    /// <summary>Creates (or re-uses) the reverse-direction route and navigates to it.</summary>
    private async Task CreateReturnTripAsync()
    {
        _creatingReturn = true;
        try
        {
            HttpResponseMessage resp = await Http.PostAsync($"/api/routes/{RouteId}/return-trip", null);
            if (resp.IsSuccessStatusCode)
            {
                RouteDto? created = await resp.Content.ReadFromJsonAsync(AppJsonContext.Default.RouteDto);
                if (created is not null)
                    Nav.NavigateTo($"/routes/{created.Id}", forceLoad: false);
            }
        }
        catch { /* transient — user can retry */ }
        finally { _creatingReturn = false; }
    }

    /// <summary>
    /// Overlays another route's baseline on today's chart. Replaces the standalone
    /// /compare page: the question is "is the other way faster than this one", which
    /// belongs on the chart already showing this one.
    /// </summary>
    private async Task OnCompareChanged(object? value)
    {
        // AllowClear hands back null rather than "" — both mean "stop comparing".
        _compareRouteId = value?.ToString() ?? string.Empty;
        _comparePoints = [];
        _compareLabel = null;
        _compareVerdict = null;

        // Guid.TryParse, not RouteId.TryParse — the page's own RouteId parameter
        // shadows the identifier type inside this component.
        if (!Guid.TryParse(_compareRouteId, out Guid otherId))
            return;

        RouteDto? other = _comparableRoutes.FirstOrDefault(r => r.Id.Value == otherId);
        if (other is null)
            return;

        try
        {
            string dayOfWeek = DateTime.Today.DayOfWeek.ToString();
            BaselineResponse? otherBaseline = await Http.GetFromJsonAsync(
                $"/api/routes/{otherId}/baseline?dayOfWeek={dayOfWeek}",
                AppJsonContext.Default.BaselineResponse);

            if (otherBaseline is null || otherBaseline.Slots.Count == 0)
                return;

            _compareLabel = RouteLabel(other);
            BuildComparison(otherBaseline);
        }
        catch
        {
            // A failed comparison just leaves the chart as it was.
            _compareLabel = null;
        }
    }

    /// <summary>
    /// Projects the other route's baseline onto the same x-positions as today's samples,
    /// by matching each sample's 15-minute slot. Slots the other route has never sampled
    /// are left at its own mean rather than invented, and the verdict says how much of
    /// the window actually overlapped.
    /// </summary>
    private void BuildComparison(BaselineResponse other)
    {
        Dictionary<int, double> otherSlots = other.Slots
            .GroupBy(s => s.TimeSlotBucket)
            .ToDictionary(g => g.Key, g => g.Last().MeanDurationSeconds);

        if (otherSlots.Count == 0 || _todayPolls.Count == 0)
            return;

        double[] projected = new double[_todayPolls.Count];
        int matched = 0;
        double otherSum = 0, thisSum = 0;

        for (int i = 0; i < _todayPolls.Count; i++)
        {
            DateTimeOffset at = _todayPolls[i].PolledAtDateTime;
            int bucket = (at.Hour * 4) + (at.Minute / 15);

            if (otherSlots.TryGetValue(bucket, out double seconds))
            {
                projected[i] = seconds / 60.0;
                matched++;
                otherSum += seconds / 60.0;
                thisSum += _todayPolls[i].TravelDurationSeconds / 60.0;
            }
            else
            {
                // No sample from the other route at this time of day. Carry the previous
                // value so the line stays continuous rather than dropping to zero.
                projected[i] = i > 0 ? projected[i - 1] : otherSlots.Values.Average() / 60.0;
            }
        }

        _comparePoints = projected;

        if (matched == 0)
        {
            _compareVerdict = "no overlapping times of day yet";
            return;
        }

        double thisMean = thisSum / matched;
        double otherMean = otherSum / matched;
        double gap = Math.Abs(thisMean - otherMean);

        _compareVerdict = gap < 1
            ? "within a minute of each other"
            : $"{(thisMean < otherMean ? _thisLabel : _compareLabel)} faster by ~{gap:F0} min";
    }

    protected override async Task LoadDataAsync()
    {
        // Failures propagate deliberately: PollingComponentBase turns them into backoff
        // and the stale banner. Swallowing them here would report every refresh as a
        // success and keep hammering an endpoint that is down.
        string dayOfWeek = DateTime.Today.DayOfWeek.ToString();
        _icsHref = $"/api/routes/{RouteId}/departure.ics?dayOfWeek={dayOfWeek}";
        string sinceUtc = Uri.EscapeDataString(DateTime.UtcNow.AddHours(-24).ToString("o"));

        // None of these reads depends on another's result, so they all go out at once.
        // Awaited one-by-one, a refresh cost the SUM of the round-trips — every 15
        // seconds, per open tab.
        Task<RouteDto?> routeTask =
            Http.GetFromJsonAsync($"/api/routes/{RouteId}", AppJsonContext.Default.RouteDto);
        Task<List<SessionDto>?> sessionsTask =
            Http.GetFromJsonAsync($"/api/routes/{RouteId}/sessions", AppJsonContext.Default.ListSessionDto);
        Task<PagedResult<PollRecordDto>?> historyTask =
            Http.GetFromJsonAsync($"/api/routes/{RouteId}/poll-history?page=1&pageSize=300&sinceUtc={sinceUtc}", AppJsonContext.Default.PagedResultPollRecordDto);
        Task<BaselineResponse?> baselineTask =
            Http.GetFromJsonAsync($"/api/routes/{RouteId}/baseline?dayOfWeek={dayOfWeek}", AppJsonContext.Default.BaselineResponse);
        Task<OptimalDepartureDto?> optimalTask = GetOptimalDepartureAsync(dayOfWeek);

        // The weekly grid rides along with the fan-out, but only when the copy in hand
        // has aged out — see HeatmapMaxAge.
        bool refreshHeatmap = _heatmapFetchedAt is not { } fetchedAt
            || DateTimeOffset.UtcNow - fetchedAt > HeatmapMaxAge;
        Task<VolatilityHeatmapDto?> heatmapTask = refreshHeatmap
            ? Http.GetFromJsonAsync($"/api/routes/{RouteId}/heatmap", AppJsonContext.Default.VolatilityHeatmapDto)
            : Task.FromResult(_heatmap);

        // The comparison picker needs the user's other routes. Fetched once — the list
        // barely changes and this page refreshes every 15 seconds.
        Task<PagedResult<RouteDto>?> routesTask = _comparableRoutes.Count == 0
            ? Http.GetFromJsonAsync("/api/routes?page=1&pageSize=100", AppJsonContext.Default.PagedResultRouteDto)
            : Task.FromResult<PagedResult<RouteDto>?>(null);

        await Task.WhenAll(routeTask, sessionsTask, historyTask, baselineTask, optimalTask,
                           heatmapTask, routesTask);

        _route = await routeTask;
        if (_route is not null)
        {
            _originStreet = _route.OriginAddress.Split(',')[0].Trim();
            _destStreet = _route.DestinationAddress.Split(',')[0].Trim();
            _thisLabel = _originStreet;
            _pageTitle = $"{_originStreet} → {_destStreet}";
        }

        // Today's active monitoring session — carries the server-computed poll schedule.
        DateOnly today = DateOnly.FromDateTime(DateTime.UtcNow.Date);
        _activeSession = (await sessionsTask)?.FirstOrDefault(
            s => s.State == SessionState.Active && s.SessionDate == today);

        PagedResult<PollRecordDto>? historyResult = await historyTask;
        if (historyResult is not null)
        {
            // Newest-first off the wire, which is right for the raw table and wrong for
            // everything plotted: the trend line drew today in reverse, so its x-axis ran
            // 08:45 → 08:00 → 18:30. Sorted once here rather than at each of the four
            // projections below, all of which are positional.
            _todayPolls = [.. historyResult.Items.OrderBy(p => p.PolledAtDateTime)];
            _pollsNewestFirst = [.. Enumerable.Reverse(_todayPolls)];
            LatestPoll = _todayPolls.Count > 0 ? _todayPolls[^1] : null;
            _trendPoints = [.. _todayPolls.Select(p => p.TravelDurationSeconds / 60.0)];
            _trendRerouted = [.. _todayPolls.Select(p => p.IsRerouted)];
            _trendLabels = [.. _todayPolls.Select(p => p.PolledAtDateTime.ToString("HH:mm"))];

            // A selection from the previous payload may no longer exist.
            if (_selectedPoll is not null && !_todayPolls.Contains(_selectedPoll))
                _selectedPoll = null;
        }

        BaselineResponse? baseline = await baselineTask;
        if (baseline is not null)
        {
            List<BaselineSlotDto> slots = [.. baseline.Slots];
            _trendBaseline = [.. slots.Select(s => s.MeanDurationSeconds / 60.0)];
            _trendUpperBand = [.. slots
                .Select(s => s.StdDevDurationSeconds.HasValue
                    ? (s.MeanDurationSeconds + s.StdDevDurationSeconds.Value) / 60.0
                    : s.MeanDurationSeconds / 60.0)];
        }

        _optimalDeparture = await optimalTask;
        BuildAnswer();

        _heatmap = await heatmapTask;
        if (refreshHeatmap)
            _heatmapFetchedAt = DateTimeOffset.UtcNow;

        PagedResult<RouteDto>? routes = await routesTask;
        if (routes is not null)
        {
            _comparableRoutes = [.. routes.Items.Where(r => r.Id.Value != RouteId)];
            _compareOptions = [.. _comparableRoutes.Select(
                r => new CompareOption(r.Id.Value.ToString(), RouteLabel(r)))];
        }
    }

    /// <summary>
    /// Reads the departure recommendation, treating "there isn't one yet" as a value
    /// rather than an error.
    ///
    /// The endpoint answers 204 No Content until a route has enough history to
    /// recommend anything — the normal state of every route for its first few days.
    /// GetFromJsonAsync counts 204 as success and then throws parsing the empty body,
    /// and because this page deliberately lets load failures propagate (so a genuinely
    /// down endpoint produces backoff and the stale banner), that exception took the
    /// whole page down: a brand-new route showed "Couldn't load this route — the route
    /// may also have been deleted" from the moment it was created. The page already
    /// has the right words for this state a few lines below ("Still learning this
    /// route"); it simply never got to render them.
    ///
    /// The dashboard calls the same endpoint inside a try/catch, which is why the
    /// cards were unaffected and the bug only appeared one tap deeper.
    /// </summary>
    private async Task<OptimalDepartureDto?> GetOptimalDepartureAsync(string dayOfWeek)
    {
        HttpResponseMessage response = await Http.GetAsync(
            $"/api/routes/{RouteId}/optimal-departure?dayOfWeek={dayOfWeek}");

        if (response.StatusCode == System.Net.HttpStatusCode.NoContent)
            return null;

        // Anything else that isn't success SHOULD still propagate — that is the
        // signal PollingComponentBase turns into backoff.
        response.EnsureSuccessStatusCode();

        if (response.Content.Headers.ContentLength is 0)
            return null;

        return await response.Content.ReadFromJsonAsync(AppJsonContext.Default.OptimalDepartureDto);
    }

    /// <summary>
    /// Formats the headline. The confidence note replaces the old meter: "38 of 60
    /// samples" asked the reader to convert a fraction into trust, where a sentence
    /// just says how much to trust it.
    /// </summary>
    private void BuildAnswer()
    {
        if (_optimalDeparture is not { } optimal)
        {
            int samples = _todayPolls.Count;
            _pendingDetail = samples == 0
                ? "No samples recorded yet."
                : $"{samples} sample{(samples == 1 ? "" : "s")} so far — a recommendation needs a few more.";
            return;
        }

        int h = optimal.TimeSlotBucket / 60;
        int m = optimal.TimeSlotBucket % 60;
        string period = h >= 12 ? "PM" : "AM";
        int displayH = h > 12 ? h - 12 : (h == 0 ? 12 : h);

        _leaveByLabel = $"Leave by {displayH}:{m:D2} {period}";

        int estMin = (int)(optimal.PredictedDurationSeconds / 60);
        _durationLabel = optimal is { LowerBound: { } lower, UpperBound: { } upper }
            ? $"about {estMin} min, usually {lower / 60:F0}–{upper / 60:F0}"
            : $"about {estMin} min";

        string basis = optimal.DayOfWeekSpecific
            ? $"{DateTime.Today.DayOfWeek}s"
            : "all days (not enough history for this weekday yet)";

        _confidenceNote = optimal.SampleCount >= QuotaConstants.BaselineConfidentSampleCount
            ? $"Based on {optimal.SampleCount} samples from {basis}."
            : $"Based on {optimal.SampleCount} samples from {basis} — still firming up.";
    }
}
