@using PoTraffic.Shared.DTOs.History
@* UI-12: 24h travel-time sparkline — lightweight inline SVG so it scales to
   whatever container width the card provides. RadzenSparkline was producing
   an empty 200×300 SVG with no path; we draw the line ourselves. *@

@if (_values.Count >= 2)
{
    <div class="pt-sparkline-wrap" title="Travel time over the last 24 hours">
        <svg class="pt-sparkline-svg"
             viewBox="0 0 @(_values.Count - 1) 1"
             preserveAspectRatio="none"
             aria-hidden="true">
            <path class="pt-sparkline-area" d="@_areaPath" fill="@_fill" />
            <path class="pt-sparkline-line" d="@_linePath"
                  fill="none" stroke="@_stroke"
                  stroke-width="0.04" vector-effect="non-scaling-stroke"
                  stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="pt-sparkline-label">@_minMinutes–@_maxMinutes min · 24 h</span>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PollRecordDto> Polls { get; set; } = [];

    private IReadOnlyList<double> _values = [];
    private string _linePath = string.Empty;
    private string _areaPath = string.Empty;
    private string _stroke = "var(--pt-color-info)";
    private string _fill = "rgba(99, 102, 241, 0.12)";
    private int _minMinutes;
    private int _maxMinutes;

    protected override void OnParametersSet()
    {
        var ordered = Polls.OrderBy(p => p.PolledAt).ToList();
        if (ordered.Count < 2)
        {
            _values = [];
            _linePath = string.Empty;
            _areaPath = string.Empty;
            return;
        }

        _values = ordered.Select(p => (double)p.TravelDurationSeconds / 60.0).ToList();
        int minSec = ordered.Min(p => p.TravelDurationSeconds);
        int maxSec = ordered.Max(p => p.TravelDurationSeconds);
        _minMinutes = minSec / 60;
        _maxMinutes = (maxSec + 59) / 60;

        // Normalize y to [0..1] over the actual min/max range with a small pad.
        double min = _values.Min();
        double max = _values.Max();
        double range = Math.Max(max - min, 0.5);  // prevent flat-line collapse
        double yMin = min - range * 0.1;
        double yMax = max + range * 0.1;

        // Build SVG path. x = index, y = 1 - normalized_value
        int n = _values.Count;
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < n; i++)
        {
            double x = i;
            double y = 1.0 - (_values[i] - yMin) / (yMax - yMin);
            if (i == 0) sb.Append($"M {x:R} {y:R}");
            else sb.Append($" L {x:R} {y:R}");
        }
        _linePath = sb.ToString();

        // Closed area path: line + baseline (y = 1)
        _areaPath = $"{_linePath} L {(n - 1):R} 1 L 0 1 Z";

        // Color by latest sample vs mean — gives at-a-glance congestion cue.
        //
        // The three fills were literal rgba()s of the three stroke colours, so a
        // change to --pt-color-danger moved the line and left the wash behind, and
        // a 14%-alpha slate wash is nearly invisible on the dark theme's own slate
        // surface. Both halves now derive from ONE token per state via color-mix,
        // which also means the wash composites against whatever surface it lands on.
        double mean = _values.Average();
        double last = _values[^1];
        (_stroke, _fill) = (last > mean * 1.1, last < mean * 0.9) switch
        {
            (true, _) => Pair("--pt-color-danger"),
            (_, true) => Pair("--pt-color-success"),
            _ => Pair("--pt-fg-tertiary")
        };

        static (string Stroke, string Fill) Pair(string token) =>
            ($"var({token})", $"color-mix(in oklab, var({token}) 16%, transparent)");
    }
}
