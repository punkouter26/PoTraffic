@page "/compare"
@using PoTraffic.Shared.DTOs.History
@using PoTraffic.Shared.DTOs.Routes
@inject HttpClient Http
@inject NavigationManager Nav

@* ──────────────────────────────────────────────────────────────────────
   #8 — Side-by-side route comparison.

   Answers the one question a second route is usually created to settle:
   which way should I actually drive? Both series come from the existing
   per-route baseline endpoint — no new aggregation server-side.

   Only time slots BOTH routes have sampled are plotted. Padding the gaps
   would draw a line through times one of the routes was never measured at,
   which is exactly the comparison a reader would most easily be misled by.
   ────────────────────────────────────────────────────────────────────── *@

<PageTitle>Compare Routes — PoTraffic</PageTitle>

<nav class="pt-breadcrumb" aria-label="breadcrumb">
    <a href="/dashboard">Dashboard</a>
    <span class="pt-breadcrumb-sep">›</span>
    <span class="pt-breadcrumb-current">Compare</span>
</nav>

@if (_loadingRoutes)
{
    <PtProgressLine AriaLabel="Loading routes" />
}
else if (_routes.Count < 2)
{
    <div class="pt-empty-state">
        <div class="pt-empty-state-emoji" aria-hidden="true">⚖️</div>
        <div class="pt-empty-state-title">Comparing needs two routes</div>
        <div class="pt-empty-state-text">
            Add a second route — the alternative way in, or the trip home — and this page
            will show which one actually runs faster, slot by slot.
        </div>
        <RadzenButton Text="Add a route" ButtonStyle="ButtonStyle.Primary" Icon="add"
                      Click="@(() => Nav.NavigateTo("/routes/create"))" />
    </div>
}
else
{
    <RadzenCard class="rz-mb-4">
        <div class="pt-compare-pickers">
            <label class="pt-compare-picker">
                <span class="pt-compare-picker-label pt-compare-swatch-a">Route A</span>
                <select class="pt-compare-select" value="@_routeA" @onchange="OnRouteAChanged">
                    @foreach (RouteDto route in _routes)
                    {
                        <option value="@route.Id">@Label(route)</option>
                    }
                </select>
            </label>

            <button type="button" class="pt-compare-swap" title="Swap A and B" @onclick="SwapAsync">⇄</button>

            <label class="pt-compare-picker">
                <span class="pt-compare-picker-label pt-compare-swatch-b">Route B</span>
                <select class="pt-compare-select" value="@_routeB" @onchange="OnRouteBChanged">
                    @foreach (RouteDto route in _routes)
                    {
                        <option value="@route.Id">@Label(route)</option>
                    }
                </select>
            </label>

            <label class="pt-compare-picker pt-compare-picker-day">
                <span class="pt-compare-picker-label">Day</span>
                <select class="pt-compare-select" value="@_dayOfWeek" @onchange="OnDayChanged">
                    @foreach (string day in Week)
                    {
                        <option value="@day">@day</option>
                    }
                </select>
            </label>
        </div>
    </RadzenCard>

    @if (_loadingSeries)
    {
        <PtProgressLine AriaLabel="Loading comparison" />
    }
    else if (_routeA == _routeB)
    {
        <div class="pt-compare-notice">Pick two different routes to compare.</div>
    }
    else if (_slots.Count == 0)
    {
        <div class="pt-empty-state">
            <div class="pt-empty-state-emoji" aria-hidden="true">🕐</div>
            <div class="pt-empty-state-title">No overlapping samples yet</div>
            <div class="pt-empty-state-text">
                These two routes have never been sampled at the same time of day on a
                @_dayOfWeek, so there is nothing fair to compare. Give them monitoring
                windows that overlap and check back once both have collected samples.
            </div>
        </div>
    }
    else
    {
        <RadzenCard class="rz-mb-4">
            @if (_verdict is not null)
            {
                <div class="pt-compare-verdict">@_verdict</div>
            }
            @if (_caveat is not null)
            {
                <div class="pt-compare-caveat">⚠︎ @_caveat</div>
            }

            <div class="pt-compare-legend">
                <span class="pt-compare-legend-item">
                    <span class="pt-compare-key pt-compare-key-a" aria-hidden="true"></span>@_labelA
                </span>
                <span class="pt-compare-legend-item">
                    <span class="pt-compare-key pt-compare-key-b" aria-hidden="true"></span>@_labelB
                </span>
            </div>

            <TrendChart Points="@_pointsA"
                        ComparePoints="@_pointsB"
                        Labels="@_labels"
                        SeriesName="@_labelA"
                        CompareSeriesName="@_labelB" />

            <div class="pt-compare-stats">
                <div class="pt-compare-stat">
                    <div class="pt-compare-stat-label">@_labelA average</div>
                    <div class="pt-compare-stat-value pt-compare-swatch-a">@_meanA.ToString("F0") min</div>
                </div>
                <div class="pt-compare-stat">
                    <div class="pt-compare-stat-label">@_labelB average</div>
                    <div class="pt-compare-stat-value pt-compare-swatch-b">@_meanB.ToString("F0") min</div>
                </div>
                <div class="pt-compare-stat">
                    <div class="pt-compare-stat-label">Slots A wins</div>
                    <div class="pt-compare-stat-value">@_slotsWonByA of @_slots.Count</div>
                </div>
                <div class="pt-compare-stat">
                    <div class="pt-compare-stat-label">Compared window</div>
                    <div class="pt-compare-stat-value">@_labels[0]–@_labels[^1]</div>
                </div>
            </div>
        </RadzenCard>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "a")] public Guid? RouteAQuery { get; set; }
    [SupplyParameterFromQuery(Name = "b")] public Guid? RouteBQuery { get; set; }

    private static readonly string[] Week =
        ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

    private List<RouteDto> _routes = [];
    private bool _loadingRoutes = true;
    private bool _loadingSeries;

    private RouteId _routeA;
    private RouteId _routeB;
    private string _dayOfWeek = DateTime.Today.DayOfWeek.ToString();

    private string _labelA = "Route A";
    private string _labelB = "Route B";

    /// <summary>15-minute buckets both routes have sampled, ascending.</summary>
    private List<int> _slots = [];
    private double[] _pointsA = [];
    private double[] _pointsB = [];
    private string[] _labels = [];
    private double _meanA;
    private double _meanB;
    private int _slotsWonByA;
    private string? _verdict;
    private string? _caveat;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PagedResult<RouteDto>? result = await Http.GetFromJsonAsync(
                "/api/routes?page=1&pageSize=100", AppJsonContext.Default.PagedResultRouteDto);
            _routes = result is null ? [] : [.. result.Items];
        }
        catch
        {
            _routes = [];
        }
        finally
        {
            _loadingRoutes = false;
        }

        if (_routes.Count < 2)
            return;

        // The route the user arrived from (if any) takes the A slot; B falls to the first
        // route that isn't already selected, so the page lands on a real comparison
        // rather than an empty pair of pickers.
        _routeA = _routes.Any(r => r.Id.Value == RouteAQuery)
            ? RouteId.From(RouteAQuery!.Value)
            : _routes[0].Id;

        _routeB = _routes.Any(r => r.Id.Value == RouteBQuery && r.Id != _routeA)
            ? RouteId.From(RouteBQuery!.Value)
            : _routes.First(r => r.Id != _routeA).Id;

        await LoadSeriesAsync();
    }

    private static string Label(RouteDto route) =>
        $"{route.OriginAddress.Split(',')[0].Trim()} → {route.DestinationAddress.Split(',')[0].Trim()}";

    private async Task OnRouteAChanged(ChangeEventArgs e)
    {
        if (RouteId.TryParse(e.Value?.ToString(), null, out RouteId picked))
            _routeA = picked;
        await LoadSeriesAsync();
    }

    private async Task OnRouteBChanged(ChangeEventArgs e)
    {
        if (RouteId.TryParse(e.Value?.ToString(), null, out RouteId picked))
            _routeB = picked;
        await LoadSeriesAsync();
    }

    private async Task OnDayChanged(ChangeEventArgs e)
    {
        _dayOfWeek = e.Value?.ToString() ?? _dayOfWeek;
        await LoadSeriesAsync();
    }

    private async Task SwapAsync()
    {
        (_routeA, _routeB) = (_routeB, _routeA);
        await LoadSeriesAsync();
    }

    private async Task LoadSeriesAsync()
    {
        Reset();

        if (_routeA == _routeB)
            return;

        _loadingSeries = true;
        try
        {
            // Both baselines are independent — one round-trip, not two in sequence.
            Task<BaselineResponse?> aTask = Http.GetFromJsonAsync(
                $"/api/routes/{_routeA}/baseline?dayOfWeek={_dayOfWeek}", AppJsonContext.Default.BaselineResponse);
            Task<BaselineResponse?> bTask = Http.GetFromJsonAsync(
                $"/api/routes/{_routeB}/baseline?dayOfWeek={_dayOfWeek}", AppJsonContext.Default.BaselineResponse);

            await Task.WhenAll(aTask, bTask);

            BaselineResponse? a = await aTask;
            BaselineResponse? b = await bTask;
            if (a is null || b is null)
                return;

            _labelA = LabelFor(_routeA);
            _labelB = LabelFor(_routeB);
            Build(a, b);
        }
        catch
        {
            // A failed comparison leaves the "no overlapping samples" state up rather than
            // an error page — the user's next action (pick another pair) is the same either way.
            Reset();
        }
        finally
        {
            _loadingSeries = false;
        }
    }

    private void Reset()
    {
        _slots = [];
        _pointsA = [];
        _pointsB = [];
        _labels = [];
        _meanA = 0;
        _meanB = 0;
        _slotsWonByA = 0;
        _verdict = null;
        _caveat = null;
    }

    private string LabelFor(RouteId id)
    {
        RouteDto? route = _routes.FirstOrDefault(r => r.Id == id);
        return route is null ? "Route" : Label(route);
    }

    /// <summary>
    /// Projects both baselines onto the slots they share. Equal-length, identically-indexed
    /// series are what the renderer needs to put two lines on one x-scale.
    /// </summary>
    private void Build(BaselineResponse a, BaselineResponse b)
    {
        Dictionary<int, double> slotsA = a.Slots
            .GroupBy(s => s.TimeSlotBucket)
            .ToDictionary(g => g.Key, g => g.Last().MeanDurationSeconds);
        Dictionary<int, double> slotsB = b.Slots
            .GroupBy(s => s.TimeSlotBucket)
            .ToDictionary(g => g.Key, g => g.Last().MeanDurationSeconds);

        _slots = [.. slotsA.Keys.Where(slotsB.ContainsKey).Order()];
        if (_slots.Count == 0)
            return;

        _pointsA = [.. _slots.Select(s => slotsA[s] / 60.0)];
        _pointsB = [.. _slots.Select(s => slotsB[s] / 60.0)];
        _labels = [.. _slots.Select(BucketLabel)];

        _meanA = _pointsA.Average();
        _meanB = _pointsB.Average();
        _slotsWonByA = _pointsA.Where((value, i) => value < _pointsB[i]).Count();

        _verdict = BuildVerdict();

        // A baseline that fell back to all-days isn't a baseline for the chosen weekday.
        // Comparing two of them is still useful, but the reader has to know.
        List<string> fellBack = [];
        if (!a.DayOfWeekSpecific) fellBack.Add(_labelA);
        if (!b.DayOfWeekSpecific) fellBack.Add(_labelB);
        if (fellBack.Count > 0)
        {
            _caveat = $"{string.Join(" and ", fellBack)} " +
                $"{(fellBack.Count == 1 ? "has" : "have")} too few {_dayOfWeek} samples — " +
                $"showing an all-days average instead.";
        }
    }

    /// <summary>"Route A is 6 min (21%) faster on Tuesdays" — or that it depends on when you leave.</summary>
    private string? BuildVerdict()
    {
        if (_meanA <= 0 || _meanB <= 0)
            return null;

        double gap = Math.Abs(_meanA - _meanB);
        int pct = (int)Math.Round(gap / Math.Max(_meanA, _meanB) * 100);
        string faster = _meanA < _meanB ? _labelA : _labelB;

        if (pct < 5)
            return $"On {_dayOfWeek}s these two run within {pct}% of each other — pick on preference, not on time.";

        // A route can win on average while losing most slots — the gap then lives in a
        // handful of bad ones, which is a different decision from "it is simply faster".
        int slotsWonByFaster = _meanA < _meanB ? _slotsWonByA : _slots.Count - _slotsWonByA;
        string consistency = slotsWonByFaster >= _slots.Count * 0.8
            ? "and wins at nearly every departure time"
            : $"though it only wins {slotsWonByFaster} of the {_slots.Count} compared slots — check the chart before committing";

        return $"On {_dayOfWeek}s, {faster} is about {gap:F0} min ({pct}%) faster on average, {consistency}.";
    }

    /// <summary>Baseline buckets are 15-minute slots: bucket = hour × 4 + minute ÷ 15.</summary>
    private static string BucketLabel(int bucket) => $"{bucket / 4:D2}:{bucket % 4 * 15:D2}";
}
