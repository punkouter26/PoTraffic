@using PoTraffic.Shared.DTOs.Routes
@using PoTraffic.Shared.DTOs.History
@implements IDisposable
@inject PtInterop Pt
@inject NotificationService NotificationService
@inject PendingDeletionService Pending

@* ──────────────────────────────────────────────────────────────────────
   SwipeableRouteCard — adds mobile swipe-to-delete + long-press menu on
   top of the existing RouteCard. Designed so Dashboard doesn't have to
   branch on viewport — gestures simply don't fire on desktop.
   ────────────────────────────────────────────────────────────────────── *@

<div class="pt-swipe-wrap @(_pendingDelete ? "pending-delete" : "")"
     @ref="_cardElement">
    <div class="pt-swipe-action pt-swipe-action-left" aria-hidden="true">
        <span>Check Now</span>
    </div>
    <div class="pt-swipe-action pt-swipe-action-right" aria-hidden="true">
        <span>Delete</span>
    </div>

    <RouteCard @ref="_routeCard"
               Route="Route"
               OptimalDeparture="OptimalDeparture"
               RecentPolls="RecentPolls"
               OnDeleted="OnDeleted"
               OnRefresh="OnRefresh" />
</div>

@code {
    [Parameter, EditorRequired] public RouteDto Route { get; set; } = default!;
    [Parameter] public OptimalDepartureDto? OptimalDeparture { get; set; }
    [Parameter] public IReadOnlyList<PollRecordDto> RecentPolls { get; set; } = [];
    [Parameter] public EventCallback OnDeleted { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }

    private ElementReference _cardElement;
    private RouteCard? _routeCard;
    private DotNetObjectReference<SwipeableRouteCard>? _selfRef;
    private IAsyncDisposable? _gestureCleanup;
    private bool _pendingDelete;

    protected override void OnInitialized()
    {
        _selfRef = DotNetObjectReference.Create(this);
        Pending.Changed += OnPendingChanged;
    }

    /// <summary>
    /// Keeps the slide-out state tied to the service rather than to a local flag: an undo
    /// restores the route, and the card has to come back with it instead of staying
    /// visually deleted because a bool was never reset.
    /// </summary>
    private void OnPendingChanged()
    {
        bool nowPending = Pending.IsPending(Route.Id);
        if (nowPending == _pendingDelete)
            return;

        _pendingDelete = nowPending;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _gestureCleanup = await Pt.AttachSwipeAsync(_cardElement, _selfRef!, nameof(OnGestureAsync));
            await Pt.UnlockAudioAsync(); // unlock on first render after a tap
        }
        await Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnGestureAsync(string gesture)
    {
        switch (gesture)
        {
            case "left":
                await Pt.PlayAsync("click");
                // Swipe-left is the Check Now button by another name — delegate to the card's
                // own implementation instead of a second, drifting copy of the same request.
                if (_routeCard is not null)
                    await _routeCard.CheckNowAsync();
                break;
            case "right":
                await Pt.PlayAsync("delete");
                await TryDeleteWithUndoAsync();
                break;
            case "longpress":
                await Pt.PlayAsync("click");
                await ShowLongPressMenuAsync();
                break;
        }
    }

    /// <summary>
    /// Plays the slide-out, then hands the delete to the card's own scheduler so the
    /// swipe is undoable through the same window the button uses (#3). Nothing is sent
    /// to the server until that window closes.
    /// </summary>
    private async Task TryDeleteWithUndoAsync()
    {
        if (_pendingDelete) return;
        _pendingDelete = true;
        StateHasChanged();

        await Task.Delay(500); // let the slide-out play

        _routeCard?.ScheduleDelete();
    }

    private Task ShowLongPressMenuAsync()
    {
        // Quick surface — second tap also fires via the gesture; for now just beep + hint.
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Info,
            Summary = "Tip",
            Detail = "Swipe left: Check Now · Swipe right: Delete",
            Duration = 3500
        });
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Pending.Changed -= OnPendingChanged;
        _ = _gestureCleanup?.DisposeAsync();
        _selfRef?.Dispose();
    }
}