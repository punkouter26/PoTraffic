@page "/routes/create"
@using System.Net.Http.Json
@using PoTraffic.Shared.DTOs.Routes
@using PoTraffic.Shared.Enums
@inject HttpClient Http
@inject NavigationManager Nav

<RadzenCard class="pt-create-route-card">
    <RadzenText TextStyle="TextStyle.H5" class="rz-mb-2">Create Monitoring Route</RadzenText>
    <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-4">
        One step setup: create route, define monitoring window, and start 5-minute polling.
    </RadzenText>

    @if (!string.IsNullOrEmpty(_error))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" class="rz-mb-3">@_error</RadzenAlert>
    }

    <RadzenFormField Text="Origin Address" class="rz-w-100 rz-mb-1">
        <AddressAutocomplete @bind-Value="_origin" Placeholder="Start typing an address…" />
    </RadzenFormField>
    <small class="pt-field-hint">Enter a full street address or place name (e.g. "1600 Amphitheatre Pkwy, Mountain View").</small>

    <RadzenFormField Text="Destination Address" class="rz-w-100 rz-mb-1">
        <AddressAutocomplete @bind-Value="_destination" Placeholder="Start typing an address…" />
    </RadzenFormField>
    <small class="pt-field-hint">We verify both addresses when you save; unrecognized addresses are rejected.</small>
    <div class="rz-mb-3"></div>

    <RadzenFieldset Text="Monitoring Schedule" class="rz-mb-4">
        <div class="rz-display-flex rz-gap-4 rz-mb-3">
            <RadzenFormField Text="Start Time">
                <RadzenDatePicker @bind-Value="_startTime" ShowTime="true" TimeOnly="true" DateFormat="HH:mm" />
            </RadzenFormField>
            <RadzenFormField Text="End Time">
                <RadzenDatePicker @bind-Value="_endTime" ShowTime="true" TimeOnly="true" DateFormat="HH:mm" />
            </RadzenFormField>
        </div>

        <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-2">Probe on these days:</RadzenText>
        <div class="pt-day-toggles" role="group" aria-label="Probe on these days">
            @foreach ((string label, byte bit) in _days)
            {
                <label class="pt-day-toggle @(IsDaySelected(bit) ? "is-selected" : null)">
                    <input type="checkbox" checked="@IsDaySelected(bit)"
                           @onchange="@(() => ToggleDay(bit))" />
                    <span>@label</span>
                </label>
            }
        </div>
    </RadzenFieldset>

    <RadzenButton Text="Save & Start Monitoring" ButtonStyle="ButtonStyle.Primary" class="rz-w-100"
                  Click="@SaveAsync" IsBusy="_loading" />
    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" class="rz-w-100 rz-mt-2"
                  Click="@Cancel" />
</RadzenCard>

@code {
    private string _origin = string.Empty;
    private string _destination = string.Empty;
    // Defaults: start = the user's current local wall-clock time, end = 2 hours later.
    // Times are shown as wall-clock local and converted to UTC on submit
    // (see ToUtcHHmm / PollRouteJob).
    private DateTime? _startTime = LocalNowToMinute();
    private DateTime? _endTime  = LocalNowToMinute().AddHours(2);

    // Current local wall-clock truncated to the minute. Also used by WindowConfigPanel
    // when adding a window to an existing route (defaults to now → now+2h there).
    internal static DateTime LocalNowToMinute()
    {
        DateTime now = DateTime.Now;
        return new DateTime(now.Year, now.Month, now.Day, now.Hour, now.Minute, 0, DateTimeKind.Unspecified);
    }

    // The form shows wall-clock local time (HH:mm on screen matches the user's clock).
    // The server's PollRouteJob interprets the wire HH:mm as UTC, so we convert
    // local → UTC on submit. Without this, a 15:01 local window is stored as
    // 15:01 UTC = 11:01 EDT-4 and never matches the user's wall-clock window.
    internal static string ToUtcHHmm(DateTime local)
    {
        DateTime utc = local.Kind == DateTimeKind.Utc
            ? local
            : TimeZoneInfo.ConvertTimeToUtc(local, TimeZoneInfo.Local);
        return utc.ToString("HH:mm");
    }
    private string _error = "";
    private bool _loading;
    private readonly int _provider = (int)RouteProvider.GoogleMaps;

    private readonly (string label, byte bit)[] _days =
    [
        ("Mon", 0x01), ("Tue", 0x02), ("Wed", 0x04),
        ("Thu", 0x08), ("Fri", 0x10), ("Sat", 0x20), ("Sun", 0x40)
    ];

    private byte _mask = 0x1F; // Monday-Friday default

    private void ToggleDay(byte bit) => _mask ^= bit;
    private bool IsDaySelected(byte bit) => (_mask & bit) != 0;

    private async Task SaveAsync()
    {
        _error = "";

        // Client-side validation — run before any API call.
        if (string.IsNullOrWhiteSpace(_origin))
        {
            _error = "Please enter an origin address.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_destination))
        {
            _error = "Please enter a destination address.";
            return;
        }

        if (_startTime is null || _endTime is null)
        {
            _error = "Please set both a start and end time.";
            return;
        }

        // End must be after start
        if (_endTime <= _startTime)
        {
            _error = "End time must be after start time.";
            return;
        }

        if (_mask == 0)
        {
            _error = "Select at least one day.";
            return;
        }

        _loading = true;
        try
        {
            HttpResponseMessage createResp = await Http.PostAsJsonAsync("/api/routes", new CreateRouteRequest(
                _origin,
                _destination,
                (RouteProvider)_provider,
                ToUtcHHmm(_startTime!.Value),
                ToUtcHHmm(_endTime!.Value),
                _mask), AppJsonContext.Default.CreateRouteRequest);

            if (!createResp.IsSuccessStatusCode)
            {
                // A session/authorization failure returns a ProblemDetails body with no "error"
                // field, so surface it as an auth problem rather than a misleading "bad address".
                if (createResp.StatusCode is System.Net.HttpStatusCode.Unauthorized
                                          or System.Net.HttpStatusCode.Forbidden)
                {
                    _error = "Your session has expired. Please sign in again.";
                    Nav.NavigateTo("/login?returnUrl=/routes/create");
                    return;
                }

                // Only our structured 4xx responses carry an "error" code and use plain
                // "application/json"; ProblemDetails (401/403/500) uses "application/problem+json",
                // so we skip parsing those and fall through to the status-code messages below.
                string? errorCode = null;
                if (createResp.Content.Headers.ContentType?.MediaType == "application/json")
                {
                    var errBody = await createResp.Content.ReadFromJsonAsync(AppJsonContext.Default.JsonElement);
                    errorCode = errBody.TryGetProperty("error", out var prop) ? prop.GetString() : null;
                }

                _error = errorCode switch
                {
                    RouteErrorCodes.MapsKeyMissing => "Maps integration is not configured on the server.",
                    RouteErrorCodes.AddressNotFound => "We couldn't find that address. Please check and try again.",
                    RouteErrorCodes.GeocodeFailed => "We couldn't find that address. Please check and try again.",
                    RouteErrorCodes.SameCoordinates => "Origin and destination resolve to the same location. Please use different addresses.",
                    _ when (int)createResp.StatusCode >= 500 => "Something went wrong on our end. Please try again in a moment.",
                    _                  => "Failed to create route. Please verify your addresses."
                };
                return;
            }

            RouteDto? createdRoute = await createResp.Content.ReadFromJsonAsync(AppJsonContext.Default.RouteDto);
            MonitoringWindowDto? activeWindow = createdRoute?.Windows.FirstOrDefault(w => w.IsActive);

            if (createdRoute is null || activeWindow is null)
            {
                _error = "Route was created, but monitoring window could not be initialized.";
                Nav.NavigateTo("/routes");
                return;
            }

            HttpResponseMessage startResp = await Http.PostAsync(
                $"/api/routes/{createdRoute.Id}/windows/{activeWindow.Id}/start",
                null);

            if (startResp.IsSuccessStatusCode)
            {
                Nav.NavigateTo($"/routes/{createdRoute.Id}");
                return;
            }

            if (startResp.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
            {
                _error = "Route created, but daily quota is exhausted. Monitoring can start tomorrow.";
            }
            else
            {
                _error = "Route created, but automatic start failed. You can start monitoring from route details.";
            }

            Nav.NavigateTo($"/routes/{createdRoute.Id}");
        }
        catch
        {
            _error = "Unable to connect. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void Cancel() => Nav.NavigateTo("/routes");
}
