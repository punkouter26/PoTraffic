@page "/routes/create"
@using System.Net.Http.Json
@using PoTraffic.Shared.DTOs.Routes
@using PoTraffic.Shared.Enums
@inject HttpClient Http
@inject NavigationManager Nav

<div class="pt-create-route-card">
<PageHeader Title="New route"
            Subtitle="One step: the trip, when to watch it, and polling starts."
            BackHref="/dashboard" BackLabel="Commutes" />

<RadzenCard>
    @if (!string.IsNullOrEmpty(_error))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" class="pt-mb-3 pt-enter">@_error</RadzenAlert>
    }

    @* RadzenTemplateForm gives the form real submit semantics — Enter submits, the
       button is a submit button, and the schedule fields get Radzen validators.
       The two address inputs are a custom component rather than an
       IRadzenFormComponent, so those keep hand-rolled field-level errors instead
       of pretending a Radzen validator can bind to them. *@
    <RadzenTemplateForm TItem="CreateRouteForm" Data="@_form" Submit="@SaveAsync">
        <RadzenFormField Text="Origin Address" class="pt-w-100 pt-mb-1">
            <AddressAutocomplete @bind-Value="_origin" Placeholder="Start typing an address…" />
        </RadzenFormField>
        @if (_originError is not null)
        {
            <div class="pt-field-error" role="alert">@_originError</div>
        }
        else
        {
            <small class="pt-field-hint">Enter a full street address or place name (e.g. "1600 Amphitheatre Pkwy, Mountain View").</small>
        }

        <RadzenFormField Text="Destination Address" class="pt-w-100 pt-mb-1">
            <AddressAutocomplete @bind-Value="_destination" Placeholder="Start typing an address…" />
        </RadzenFormField>
        @if (_destinationError is not null)
        {
            <div class="pt-field-error" role="alert">@_destinationError</div>
        }
        else
        {
            <small class="pt-field-hint">We verify both addresses when you save; unrecognized addresses are rejected.</small>
        }
        <div class="pt-mb-3"></div>

        <RadzenFieldset Text="Monitoring Schedule" class="pt-mb-4">
            <div class="pt-schedule-times pt-mb-3">
                <RadzenFormField Text="Start Time">
                    <ChildContent>
                        <RadzenDatePicker Name="StartTime" @bind-Value="_startTime"
                                          ShowTime="true" TimeOnly="true" DateFormat="HH:mm" />
                    </ChildContent>
                    <Helper>
                        <RadzenRequiredValidator Component="StartTime" Text="Set a start time." />
                    </Helper>
                </RadzenFormField>
                <RadzenFormField Text="End Time">
                    <ChildContent>
                        <RadzenDatePicker Name="EndTime" @bind-Value="_endTime"
                                          ShowTime="true" TimeOnly="true" DateFormat="HH:mm" />
                    </ChildContent>
                    <Helper>
                        <RadzenRequiredValidator Component="EndTime" Text="Set an end time." />
                        @* The window is what the poller reads; an inverted one silently
                           never fires, so it is caught here rather than at the API. *@
                        <RadzenCustomValidator Component="EndTime" Validator="@EndAfterStart"
                                               Text="End time must be after start time." />
                    </Helper>
                </RadzenFormField>
            </div>

            <RadzenText TextStyle="TextStyle.Caption" class="pt-mb-2">Probe on these days:</RadzenText>
            @* Seven hand-built toggle pills, each a <label> wrapping a visually-hidden
               checkbox with its own :focus-within ring — a multi-select segmented
               control, reimplemented. RadzenSelectBar with Multiple="true" IS that
               control, and it keeps the day bitmask out of the markup: the bar binds
               to the selected bits and the mask is folded from them on submit. *@
            <RadzenSelectBar @bind-Value="_selectedDays" TValue="IEnumerable<byte>"
                             Multiple="true" Size="ButtonSize.Medium"
                             class="pt-day-toggles" aria-label="Probe on these days">
                <Items>
                    @foreach ((string label, byte bit) in _days)
                    {
                        <RadzenSelectBarItem Value="@bit" Text="@label" />
                    }
                </Items>
            </RadzenSelectBar>
            @if (_daysError is not null)
            {
                <div class="pt-field-error" role="alert">@_daysError</div>
            }
        </RadzenFieldset>

        <RadzenButton ButtonType="ButtonType.Submit" Text="Save & start monitoring"
                      Icon="play_arrow" ButtonStyle="ButtonStyle.Primary"
                      class="pt-w-100" IsBusy="_loading" />
        <RadzenButton ButtonType="ButtonType.Button" Text="Cancel" ButtonStyle="ButtonStyle.Light"
                      class="pt-w-100 pt-mt-2" Click="@Cancel" />
    </RadzenTemplateForm>
</RadzenCard>
</div>

@code {
    /// <summary>
    /// RadzenTemplateForm needs a model to bind to. The fields it validates are
    /// bound directly to the component's own state, so this carries nothing —
    /// it exists to give the form a TItem.
    /// </summary>
    private sealed class CreateRouteForm { }

    private readonly CreateRouteForm _form = new();

    private string _origin = string.Empty;
    private string _destination = string.Empty;

    // Per-field messages, so a problem is reported next to the input that caused
    // it rather than only in a banner at the top of the card.
    private string? _originError;
    private string? _destinationError;
    private string? _daysError;

    /// <summary>Backs the RadzenCustomValidator on the end-time picker.</summary>
    private bool EndAfterStart() =>
        _startTime is null || _endTime is null || _endTime > _startTime;
    // Defaults: start = the user's current local wall-clock time, end = 2 hours later.
    // Times are shown as wall-clock local and converted to UTC on submit
    // (see ToUtcHHmm / PollRouteJob).
    private DateTime? _startTime = LocalNowToMinute();
    private DateTime? _endTime  = LocalNowToMinute().AddHours(2);

    // Current local wall-clock truncated to the minute. Also used by WindowConfigPanel
    // when adding a window to an existing route (defaults to now → now+2h there).
    internal static DateTime LocalNowToMinute()
    {
        DateTime now = DateTime.Now;
        return new DateTime(now.Year, now.Month, now.Day, now.Hour, now.Minute, 0, DateTimeKind.Unspecified);
    }

    // The form shows wall-clock local time (HH:mm on screen matches the user's clock).
    // The server's PollRouteJob interprets the wire HH:mm as UTC, so we convert
    // local → UTC on submit. Without this, a 15:01 local window is stored as
    // 15:01 UTC = 11:01 EDT-4 and never matches the user's wall-clock window.
    internal static string ToUtcHHmm(DateTime local)
    {
        DateTime utc = local.Kind == DateTimeKind.Utc
            ? local
            : TimeZoneInfo.ConvertTimeToUtc(local, TimeZoneInfo.Local);
        return utc.ToString("HH:mm");
    }
    private string _error = "";
    private bool _loading;
    private readonly int _provider = (int)RouteProvider.GoogleMaps;

    private readonly (string label, byte bit)[] _days =
    [
        ("Mon", 0x01), ("Tue", 0x02), ("Wed", 0x04),
        ("Thu", 0x08), ("Fri", 0x10), ("Sat", 0x20), ("Sun", 0x40)
    ];

    /// <summary>
    /// What the select bar binds to: the day bits currently on. Monday–Friday by
    /// default, matching the 0x1F mask this replaced.
    /// </summary>
    private IEnumerable<byte> _selectedDays = [0x01, 0x02, 0x04, 0x08, 0x10];

    /// <summary>The wire format — the selected bits folded back into one byte.</summary>
    private byte DayMask => _selectedDays.Aggregate((byte)0, (acc, bit) => (byte)(acc | bit));

    private async Task SaveAsync()
    {
        _error = "";
        _originError = null;
        _destinationError = null;
        _daysError = null;

        // The schedule fields are covered by the form's own validators; these are
        // the inputs Radzen can't reach. Every failing field is marked in one pass
        // rather than stopping at the first, so the user fixes the form once.
        if (string.IsNullOrWhiteSpace(_origin))
            _originError = "Enter an origin address.";

        if (string.IsNullOrWhiteSpace(_destination))
            _destinationError = "Enter a destination address.";

        if (DayMask == 0)
            _daysError = "Select at least one day to probe.";

        if (_originError is not null || _destinationError is not null || _daysError is not null)
            return;

        // Belt and braces: the picker validators run first, but a submit that
        // somehow arrives with an unusable window must not reach the API.
        if (_startTime is null || _endTime is null || _endTime <= _startTime)
            return;

        _loading = true;
        try
        {
            HttpResponseMessage createResp = await Http.PostAsJsonAsync("/api/routes", new CreateRouteRequest(
                _origin,
                _destination,
                (RouteProvider)_provider,
                ToUtcHHmm(_startTime!.Value),
                ToUtcHHmm(_endTime!.Value),
                DayMask), AppJsonContext.Default.CreateRouteRequest);

            if (!createResp.IsSuccessStatusCode)
            {
                // A session/authorization failure returns a ProblemDetails body with no "error"
                // field, so surface it as an auth problem rather than a misleading "bad address".
                if (createResp.StatusCode is System.Net.HttpStatusCode.Unauthorized
                                          or System.Net.HttpStatusCode.Forbidden)
                {
                    _error = "Your session has expired. Please sign in again.";
                    Nav.NavigateTo("/login?returnUrl=/routes/create");
                    return;
                }

                // Only our structured 4xx responses carry an "error" code and use plain
                // "application/json"; ProblemDetails (401/403/500) uses "application/problem+json",
                // so we skip parsing those and fall through to the status-code messages below.
                string? errorCode = null;
                if (createResp.Content.Headers.ContentType?.MediaType == "application/json")
                {
                    var errBody = await createResp.Content.ReadFromJsonAsync(AppJsonContext.Default.JsonElement);
                    errorCode = errBody.TryGetProperty("error", out var prop) ? prop.GetString() : null;
                }

                _error = errorCode switch
                {
                    RouteErrorCodes.MapsKeyMissing => "Maps integration is not configured on the server.",
                    RouteErrorCodes.AddressNotFound => "We couldn't find that address. Please check and try again.",
                    RouteErrorCodes.GeocodeFailed => "We couldn't find that address. Please check and try again.",
                    RouteErrorCodes.SameCoordinates => "Origin and destination resolve to the same location. Please use different addresses.",
                    _ when (int)createResp.StatusCode >= 500 => "Something went wrong on our end. Please try again in a moment.",
                    _                  => "Failed to create route. Please verify your addresses."
                };
                return;
            }

            RouteDto? createdRoute = await createResp.Content.ReadFromJsonAsync(AppJsonContext.Default.RouteDto);
            MonitoringWindowDto? activeWindow = createdRoute?.Windows.FirstOrDefault(w => w.IsActive);

            if (createdRoute is null || activeWindow is null)
            {
                _error = "Route was created, but monitoring window could not be initialized.";
                Nav.NavigateTo("/routes");
                return;
            }

            HttpResponseMessage startResp = await Http.PostAsync(
                $"/api/routes/{createdRoute.Id}/windows/{activeWindow.Id}/start",
                null);

            if (startResp.IsSuccessStatusCode)
            {
                Nav.NavigateTo($"/routes/{createdRoute.Id}");
                return;
            }

            if (startResp.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
            {
                _error = "Route created, but daily quota is exhausted. Monitoring can start tomorrow.";
            }
            else
            {
                _error = "Route created, but automatic start failed. You can start monitoring from route details.";
            }

            Nav.NavigateTo($"/routes/{createdRoute.Id}");
        }
        catch
        {
            _error = "Unable to connect. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void Cancel() => Nav.NavigateTo("/routes");
}
