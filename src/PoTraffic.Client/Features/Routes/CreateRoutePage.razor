@page "/routes/create"
@using System.Net.Http.Json
@using PoTraffic.Shared.DTOs.Routes
@using PoTraffic.Shared.Enums
@inject HttpClient Http
@inject NavigationManager Nav

<RadzenCard Style="max-width:560px;margin:auto;margin-top:48px;">
    <RadzenText TextStyle="TextStyle.H5" class="rz-mb-2">Create Monitoring Route</RadzenText>
    <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-4">
        One step setup: create route, define monitoring window, and start 5-minute polling.
    </RadzenText>

    @if (!string.IsNullOrEmpty(_error))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" class="rz-mb-3">@_error</RadzenAlert>
    }

    <RadzenFormField Text="Origin Address" class="rz-w-100 rz-mb-2">
        <RadzenTextBox @bind-Value="_origin" />
    </RadzenFormField>

    <RadzenFormField Text="Destination Address" class="rz-w-100 rz-mb-2">
        <RadzenTextBox @bind-Value="_destination" />
    </RadzenFormField>
    <div class="rz-mb-3"></div>

    <RadzenFieldset Text="Monitoring Schedule" class="rz-mb-4">
        <div class="rz-display-flex rz-gap-4 rz-mb-3">
            <RadzenFormField Text="Start Time">
                <RadzenDatePicker @bind-Value="_startTime" ShowTime="true" TimeOnly="true" DateFormat="HH:mm" />
            </RadzenFormField>
            <RadzenFormField Text="End Time">
                <RadzenDatePicker @bind-Value="_endTime" ShowTime="true" TimeOnly="true" DateFormat="HH:mm" />
            </RadzenFormField>
        </div>

        <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-2">Probe on these days:</RadzenText>
        <div class="rz-display-flex rz-gap-3 rz-flex-wrap">
            @foreach ((string label, byte bit) in _days)
            {
                <label style="display:flex;align-items:center;gap:4px;cursor:pointer;">
                    <input type="checkbox" checked="@IsDaySelected(bit)"
                           @onchange="@(() => ToggleDay(bit))" />
                    @label
                </label>
            }
        </div>
    </RadzenFieldset>

    <RadzenButton Text="Save & Start Monitoring" ButtonStyle="ButtonStyle.Primary" class="rz-w-100"
                  Click="@SaveAsync" IsBusy="_loading" />
    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" class="rz-w-100 rz-mt-2"
                  Click="@Cancel" />
</RadzenCard>

@code {
    private string _origin = string.Empty;
    private string _destination = string.Empty;
    // Default to a sensible morning-commute window (07:30–09:00 local), still editable.
    private DateTime? _startTime = TimeToday(7, 30);
    private DateTime? _endTime  = TimeToday(9, 0);

    private static DateTime TimeToday(int hour, int minute)
    {
        DateTime now = DateTime.Now;
        return new DateTime(now.Year, now.Month, now.Day, hour, minute, 0);
    }
    private string _error = "";
    private bool _loading;
    private readonly int _provider = (int)RouteProvider.GoogleMaps;

    private readonly (string label, byte bit)[] _days =
    [
        ("Mon", 0x01), ("Tue", 0x02), ("Wed", 0x04),
        ("Thu", 0x08), ("Fri", 0x10), ("Sat", 0x20), ("Sun", 0x40)
    ];

    private byte _mask = 0x1F; // Monday-Friday default

    private void ToggleDay(byte bit) => _mask ^= bit;
    private bool IsDaySelected(byte bit) => (_mask & bit) != 0;

    private async Task SaveAsync()
    {
        _error = "";

        // Client-side validation — run before any API call.
        if (string.IsNullOrWhiteSpace(_origin))
        {
            _error = "Please enter an origin address.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_destination))
        {
            _error = "Please enter a destination address.";
            return;
        }

        if (_startTime is null || _endTime is null)
        {
            _error = "Please set both a start and end time.";
            return;
        }

        // End must be after start
        if (_endTime <= _startTime)
        {
            _error = "End time must be after start time.";
            return;
        }

        if (_mask == 0)
        {
            _error = "Select at least one day.";
            return;
        }

        _loading = true;
        try
        {
            HttpResponseMessage createResp = await Http.PostAsJsonAsync("/api/routes", new CreateRouteRequest(
                _origin,
                _destination,
                (RouteProvider)_provider,
                _startTime!.Value.ToString("HH:mm"),
                _endTime!.Value.ToString("HH:mm"),
                _mask), AppJsonContext.Default.CreateRouteRequest);

            if (!createResp.IsSuccessStatusCode)
            {
                var errBody = await createResp.Content.ReadFromJsonAsync(AppJsonContext.Default.JsonElement);
                string? errorCode = errBody.TryGetProperty("error", out var prop) ? prop.GetString() : null;
                _error = errorCode switch
                {
                    "MAPS_KEY_MISSING" => "Maps integration is not configured on the server.",
                    "ADDRESS_NOT_FOUND" => "We couldn't find that address. Please check and try again.",
                    "GEOCODE_FAILED"   => "We couldn't find that address. Please check and try again.",
                    "SAME_COORDINATES" => "Origin and destination resolve to the same location. Please use different addresses.",
                    _                  => "Failed to create route. Please verify your addresses."
                };
                return;
            }

            RouteDto? createdRoute = await createResp.Content.ReadFromJsonAsync(AppJsonContext.Default.RouteDto);
            MonitoringWindowDto? activeWindow = createdRoute?.Windows.FirstOrDefault(w => w.IsActive);

            if (createdRoute is null || activeWindow is null)
            {
                _error = "Route was created, but monitoring window could not be initialized.";
                Nav.NavigateTo("/routes");
                return;
            }

            HttpResponseMessage startResp = await Http.PostAsync(
                $"/api/routes/{createdRoute.Id}/windows/{activeWindow.Id}/start",
                null);

            if (startResp.IsSuccessStatusCode)
            {
                Nav.NavigateTo($"/routes/{createdRoute.Id}");
                return;
            }

            if (startResp.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
            {
                _error = "Route created, but daily quota is exhausted. Monitoring can start tomorrow.";
            }
            else
            {
                _error = "Route created, but automatic start failed. You can start monitoring from route details.";
            }

            Nav.NavigateTo($"/routes/{createdRoute.Id}");
        }
        catch
        {
            _error = "Unable to connect. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void Cancel() => Nav.NavigateTo("/routes");
}
