@page "/"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth

<div class="pt-splash" role="status" aria-live="polite">Loading…</div>

@code {
    // The redirect runs here, not in the markup, so it fires exactly once per
    // component lifetime. A NavigateTo inside AuthorizeView's render blocks fired
    // on every render, on top of this one.
    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await Auth.GetAuthenticationStateAsync();
        string target = state.User.Identity?.IsAuthenticated == true
            ? "/dashboard"
            : "/login";
        // Avoid a redundant navigation if we're already on the target route.
        if (!Nav.Uri.EndsWith(target, StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo(target, forceLoad: false);
        }
    }
}
