@page "/health"
@inject HttpClient Http

@* Rule 3 — /health is a Blazor page showing every connection's status. It is deliberately
   anonymous: the moment you most need it is when sign-in itself is the thing that is broken.
   The machine-readable feeds live at /health/json and /health/ready. *@

<PageTitle>Health &amp; Connections</PageTitle>

<div class="pt-health">
    @* Was a bespoke .pt-health-head with its own <h1> and subtitle rules — the
       only page in the app that got the treatment right, and still the only one
       styling it locally. Same markup, one shared component. *@
    <PageHeader Title="Health &amp; connections"
                Subtitle="Live status of every dependency this deployment talks to."
                BackHref="/dashboard" BackLabel="Commutes">
        <Actions>
            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                          Disabled="_loading" Click="LoadAsync" />
        </Actions>
    </PageHeader>

    @if (!_loading && _error is null)
    {
        <div class="pt-health-summary" data-status="@OverallStatus">
            <span class="pt-health-dot" aria-hidden="true"></span>
            <div>
                <strong>@OverallLabel</strong>
                <span class="pt-health-meta">
                    @_healthy of @_connections.Count healthy · checked @_checkedAt.ToLocalTime().ToString("HH:mm:ss")
                </span>
            </div>
        </div>
    }

    <LoadingErrorCard IsLoading="_loading" Error="@_error">
        <ul class="pt-health-list" role="list">
            @foreach (ConnectionHealthDto c in _connections)
            {
                <li class="pt-health-item" data-status="@Normalise(c.Status)">
                    <span class="pt-health-dot" aria-hidden="true"></span>
                    <div class="pt-health-item-body">
                        <div class="pt-health-item-head">
                            <span class="pt-health-name">@c.Name</span>
                            <span class="pt-health-status">@c.Status</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(c.Description))
                        {
                            <p class="pt-health-desc">@c.Description</p>
                        }
                    </div>
                    @if (c.DurationMs > 0)
                    {
                        <span class="pt-health-duration">@c.DurationMs.ToString("F0") ms</span>
                    }
                </li>
            }
        </ul>
    </LoadingErrorCard>
</div>

@code {
    private List<ConnectionHealthDto> _connections = [];
    private bool _loading = true;
    private string? _error;
    private DateTimeOffset _checkedAt;
    private int _healthy;

    /// <summary>Worst status across all connections — drives the summary banner.</summary>
    private string OverallStatus =>
        _connections.Count == 0 ? "unknown"
        : _connections.Any(c => Normalise(c.Status) == "unhealthy") ? "unhealthy"
        : _connections.Any(c => Normalise(c.Status) == "degraded") ? "degraded"
        : "healthy";

    private string OverallLabel => OverallStatus switch
    {
        "healthy" => "All systems operational",
        "degraded" => "Operating with degraded dependencies",
        "unhealthy" => "One or more dependencies are down",
        _ => "No connection data",
    };

    /// <summary>Health-check statuses arrive PascalCase; the CSS selectors key off lowercase.</summary>
    private static string Normalise(string status) => status.ToLowerInvariant();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _connections = await Http.GetFromJsonAsync(
                "/health/connections", AppJsonContext.Default.ListConnectionHealthDto) ?? [];
            _healthy = _connections.Count(c => Normalise(c.Status) == "healthy");
            _checkedAt = DateTimeOffset.UtcNow;
        }
        catch (Exception ex)
        {
            _error = $"Could not reach the health endpoint: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
