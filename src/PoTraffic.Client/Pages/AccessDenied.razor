@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav

<PageTitle>Access denied — PoTraffic</PageTitle>

<div class="pt-access-denied">
    <PtIcon Name="lock" Size="xl" Class="pt-access-denied-icon" />
    <PageHeader Title="Access denied"
                Subtitle="@($"You're signed in as {_label}, but this page requires elevated permissions your account doesn't have.")" />
    <RadzenButton Text="Back to dashboard" ButtonStyle="ButtonStyle.Primary"
                  Click="@(() => Nav.NavigateTo("/dashboard"))" />
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private string _label = "your account";

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            AuthenticationState state = await AuthState;
            _label = state.User.FindFirst("email")?.Value
                ?? state.User.Identity?.Name
                ?? "your account";
        }
    }
}
