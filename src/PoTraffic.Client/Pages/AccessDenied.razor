@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Access denied — PoTraffic</PageTitle>

<ErrorPage Icon="lock" Title="Access denied"
           Subtitle="@($"You're signed in as {_label}, but this page requires elevated permissions your account doesn't have.")" />

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private string _label = "your account";

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            AuthenticationState state = await AuthState;
            _label = state.User.FindFirst("email")?.Value
                ?? state.User.Identity?.Name
                ?? "your account";
        }
    }
}
