@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav

<div class="pt-access-denied">
    <PtIcon Name="lock" Size="xl" Class="pt-access-denied-icon" />
    <h1>Access denied</h1>
    <p>
        You're signed in as <strong>@_label</strong>, but this page requires
        elevated permissions your account doesn't have.
    </p>
    <RadzenButton Text="Back to dashboard" ButtonStyle="ButtonStyle.Primary"
                  Click="@(() => Nav.NavigateTo("/dashboard"))" />
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private string _label = "your account";

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            AuthenticationState state = await AuthState;
            _label = state.User.FindFirst("email")?.Value
                ?? state.User.Identity?.Name
                ?? "your account";
        }
    }
}
