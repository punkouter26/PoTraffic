@page "/not-found"
@attribute [AllowAnonymous]
@layout MainLayout

<div class="pt-notfound">
    <div class="pt-notfound-emoji" aria-hidden="true">🧭</div>
    <h1 class="pt-notfound-title">Page not found</h1>
    <p class="pt-notfound-text">Sorry, the content you are looking for does not exist or may have moved.</p>
    <RadzenButton Text="Back to Dashboard" ButtonStyle="ButtonStyle.Primary" Icon="home"
                  Click="@(() => Nav.NavigateTo("/dashboard"))" />
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
}
