@implements IAsyncDisposable
@inject IJSRuntime JS

@* ──────────────────────────────────────────────────────────────────────
   #10 — install affordance. Renders only when the browser has actually
   offered a prompt and the app is not already installed, so it never
   nags on desktop Safari or inside the installed app itself.
   ────────────────────────────────────────────────────────────────────── *@

@if (_canInstall && !_dismissed)
{
    <div class="pt-install" role="complementary">
        <PtIcon Name="install_mobile" Size="lg" Class="pt-install-icon" />
        <span class="pt-install-text">
            <strong>Install PoTraffic</strong>
            <span class="pt-install-sub">Opens instantly and works offline on the platform.</span>
        </span>
        <button type="button" class="pt-install-cta" @onclick="InstallAsync">Install</button>
        <button type="button" class="pt-install-dismiss" aria-label="Dismiss" @onclick="Dismiss">
            <PtIcon Name="close" Size="sm" />
        </button>
    </div>
}

@code {
    private IJSObjectReference? _module;
    private bool _canInstall;
    private bool _dismissed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pt-pwa.js");
            await _module.InvokeAsync<bool>("register");

            if (await _module.InvokeAsync<bool>("isInstalled"))
                return;

            // beforeinstallprompt can arrive after first render, so re-check shortly
            // after boot rather than deciding once and never looking again.
            _canInstall = await _module.InvokeAsync<bool>("canInstall");
            if (!_canInstall)
            {
                await Task.Delay(TimeSpan.FromSeconds(3));
                _canInstall = await _module.InvokeAsync<bool>("canInstall");
            }

            if (_canInstall)
                StateHasChanged();
        }
        catch
        {
            // No service worker or no install support — nothing to show.
        }
    }

    private async Task InstallAsync()
    {
        if (_module is null)
            return;

        try
        {
            await _module.InvokeAsync<string>("promptInstall");
        }
        catch
        {
            // Fall through — the card hides either way.
        }

        // The browser will not replay a prompt, so the card has done its job
        // whether the user accepted, dismissed, or it turned out to be gone.
        _canInstall = false;
    }

    private void Dismiss() => _dismissed = true;

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { /* ignore */ }
        }
    }
}
