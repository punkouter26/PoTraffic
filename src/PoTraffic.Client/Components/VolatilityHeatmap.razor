@using PoTraffic.Shared.DTOs.History

@* ──────────────────────────────────────────────────────────────────────
   #5 — Day-of-week × half-hour congestion grid.

   Colour encodes how much slower a half-hour slot runs than the route's
   typical (median) sample; the dot marks slots whose spread is wide enough
   that the time is unpredictable rather than merely slow. Those are
   different problems: a reliably-40-minute slot can be planned around, a
   25-to-55-minute one can't.

   Only the half-hour slots that actually carry samples are drawn. A 07:00–
   09:00 commute would otherwise render as two columns of data and
   twenty-two of blank per hour-of-day.

   Rule 4: the markup hands CSS the level class only — the ramp itself is
   owned by .pt-heat-l0…l4 in app.css.

   Times are US Eastern (the user's wall clock) at 30-minute resolution,
   so "17:30" reads as the rush hour it actually is for the driver.
   ────────────────────────────────────────────────────────────────────── *@

@if (Heatmap is null || Heatmap.TotalSamples == 0)
{
    <div class="pt-heatmap-empty">
        <PtIcon Name="calendar_month" Size="xl" Class="pt-heatmap-empty-icon" />
        <div class="pt-heatmap-empty-text">
            The weekly pattern appears once this route has sampled a few commutes.
        </div>
    </div>
}
else
{
    @if (_summary is not null)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="pt-mb-3 pt-heatmap-summary">@_summary</RadzenText>
    }

    <div class="pt-heatmap-scroll">
        <table class="pt-heatmap">
            <caption class="pt-visually-hidden">
                Mean travel time by day of week and half-hour, in US Eastern time.
            </caption>
            <thead>
                <tr>
                    <th scope="col"><span class="pt-visually-hidden">Day</span></th>
                    @foreach (HalfHourSlot slot in _slots)
                    {
                        <th scope="col" class="pt-heatmap-hour">@SlotLabel(slot)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (string day in Week)
                {
                    <tr>
                        <th scope="row" class="pt-heatmap-day">@day[..3]</th>
                        @foreach (HalfHourSlot slot in _slots)
                        {
                            HeatmapCellDto? cell = _byKey.GetValueOrDefault((day, slot.Hour, slot.HalfHour));
                            @if (cell is null)
                            {
                                <td class="pt-heat pt-heat-empty" title="@EmptyTooltip(day, slot)">
                                    <span class="pt-visually-hidden">@EmptyTooltip(day, slot)</span>
                                </td>
                            }
                            else
                            {
                                <td class="pt-heat @LevelClass(cell) @(IsVolatile(cell) ? "pt-heat-volatile" : "")"
                                    title="@CellTooltip(cell)">
                                    <span class="pt-heat-value">@((cell.MeanDurationSeconds / 60).ToString("F0"))</span>
                                    <span class="pt-visually-hidden">@CellTooltip(cell)</span>
                                </td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pt-heatmap-legend">
        <span class="pt-heatmap-legend-label">Typical</span>
        <span class="pt-heat pt-heat-l0" aria-hidden="true"></span>
        <span class="pt-heat pt-heat-l1" aria-hidden="true"></span>
        <span class="pt-heat pt-heat-l2" aria-hidden="true"></span>
        <span class="pt-heat pt-heat-l3" aria-hidden="true"></span>
        <span class="pt-heat pt-heat-l4" aria-hidden="true"></span>
        <span class="pt-heatmap-legend-label">Congested</span>
        <span class="pt-heatmap-legend-sep">·</span>
        <span class="pt-heat pt-heat-l2 pt-heat-volatile" aria-hidden="true"></span>
        <span class="pt-heatmap-legend-label">dot = unpredictable</span>
        <span class="pt-heatmap-legend-sep">·</span>
        <span class="pt-heatmap-legend-label">minutes, half-hours in US Eastern — only times you travel are shown</span>
    </div>
}

@code {
    [Parameter] public VolatilityHeatmapDto? Heatmap { get; set; }

    private static readonly string[] Week =
        ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

    /// <summary>
    /// Coefficient of variation above which a half-hour is called unpredictable. Matches
    /// the stability threshold the adaptive poller uses, so "volatile" means the same
    /// thing on the grid as it does to the scheduler.
    /// </summary>
    private const double VolatileCoefficient = 0.08;

    /// <summary>One 30-minute slot in the local day.</summary>
    /// <param name="Hour">Local Eastern hour 0–23.</param>
    /// <param name="HalfHour">0 for :00–:29, 1 for :30–:59.</param>
    private readonly record struct HalfHourSlot(int Hour, int HalfHour)
    {
        public int StartMinute => HalfHour * 30;
    }

    private Dictionary<(string Day, int Hour, int HalfHour), HeatmapCellDto> _byKey = [];
    private List<HalfHourSlot> _slots = [];
    private string? _summary;

    protected override void OnParametersSet()
    {
        if (Heatmap is null || Heatmap.Cells.Count == 0)
        {
            _byKey = [];
            _slots = [];
            _summary = null;
            return;
        }

        // Last cell wins on a duplicate key — the server groups by exactly that triple,
        // so a duplicate would be a server bug rather than something to render twice.
        _byKey = Heatmap.Cells
            .GroupBy(c => (c.DayOfWeek, c.Hour, c.HalfHour))
            .ToDictionary(g => g.Key, g => g.Last());

        // Only slots that actually carry a sample get a column. A commute that runs
        // 07:00–09:00 and 16:00–19:00 spans 12 half-hours but occupies 12 of them;
        // rendering a contiguous range would put six empty columns between the two blocks.
        _slots = Heatmap.Cells
            .Select(c => new HalfHourSlot(c.Hour, c.HalfHour))
            .Distinct()
            .OrderBy(static s => s.Hour)
            .ThenBy(static s => s.HalfHour)
            .ToList();

        _summary = BuildSummary(Heatmap);
    }

    /// <summary>"Tuesdays at 17:30 run 62% over your typical 23 min." Null until a cell
    /// is materially worse than the route's median — flagging a 4% bump as a hotspot is noise.</summary>
    private static string? BuildSummary(VolatilityHeatmapDto heatmap)
    {
        if (heatmap.MedianDurationSeconds <= 0)
            return null;

        HeatmapCellDto? worst = heatmap.Cells.MaxBy(c => c.MeanDurationSeconds);
        if (worst is null)
            return null;

        int pct = (int)Math.Round((worst.MeanDurationSeconds - heatmap.MedianDurationSeconds)
            / heatmap.MedianDurationSeconds * 100);

        string when = $"{worst.DayOfWeek}s at {worst.Hour:D2}:{worst.HalfHour * 30:D2}";
        return pct < 10
            ? $"This route holds steady all week — no slot runs more than {Math.Max(pct, 0)}% over its typical {heatmap.MedianDurationSeconds / 60:F0} min."
            : $"{when} are the worst 30 minutes of your week — {pct}% over the typical {heatmap.MedianDurationSeconds / 60:F0} min.";
    }

    private string LevelClass(HeatmapCellDto cell)
    {
        double median = Heatmap?.MedianDurationSeconds ?? 0;
        if (median <= 0)
            return "pt-heat-l0";

        double ratio = cell.MeanDurationSeconds / median;
        return ratio switch
        {
            <= 1.05 => "pt-heat-l0",
            <= 1.20 => "pt-heat-l1",
            <= 1.40 => "pt-heat-l2",
            <= 1.70 => "pt-heat-l3",
            _ => "pt-heat-l4"
        };
    }

    /// <summary>Wide spread relative to the cell's own mean — slow is plannable, erratic isn't.</summary>
    private static bool IsVolatile(HeatmapCellDto cell) =>
        cell.SampleCount > 1
        && cell.MeanDurationSeconds > 0
        && cell.StdDevDurationSeconds / cell.MeanDurationSeconds > VolatileCoefficient;

    private static string SlotLabel(HalfHourSlot slot) =>
        $"{slot.Hour:D2}:{slot.StartMinute:D2}";

    private static string EmptyTooltip(string day, HalfHourSlot slot) =>
        $"{day} {SlotLabel(slot)} — no samples";

    private string CellTooltip(HeatmapCellDto cell)
    {
        double median = Heatmap?.MedianDurationSeconds ?? 0;
        string delta = median > 0
            ? $" · {(cell.MeanDurationSeconds - median) / median * 100:+0;-0;0}% vs typical"
            : string.Empty;
        string spread = IsVolatile(cell)
            ? $" · ±{cell.StdDevDurationSeconds / 60:F0} min swing"
            : string.Empty;

        return $"{cell.DayOfWeek} {SlotLabel(new HalfHourSlot(cell.Hour, cell.HalfHour))} — {cell.MeanDurationSeconds / 60:F0} min avg{delta}{spread} · {cell.SampleCount} sample(s)";
    }
}