<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <RootNamespace>PoTraffic.Client</RootNamespace>
    <AssemblyName>PoTraffic.Client</AssemblyName>
    <!-- Configured for static-asset emit + index.html override; runtime manifest
         synthesis happens server-side via BlazorBootManifestBuilder (Fix #11). -->
    <!-- Do NOT mark the Blazor WASM app assembly IsTrimmable. Routable @page components are
         discovered by the framework's runtime route-table scan, which the trimmer can't see;
         member-trimming the app assembly strips those pages from the published build (the "/"
         route among them, so the Router falls through to NotFoundPage). Publish still trims the
         framework and trimmable libraries — the actual size wins — while preserving app pages. -->
  </PropertyGroup>

  <!-- Fix #11 — Emit blazor.boot.json into wwwroot/_framework/ on every build so
       the host can serve it directly via UseStaticFiles / UseBlazorFrameworkFiles
       without depending on the .NET 10 static-asset manifest pipeline. Without
       this, the runtime manifest is generated in-memory by the framework BUT the
       host's staticwebassets.endpoints.json is empty in our .csproj combo
       (OverrideHtmlAssetPlaceholders + non-server host), so /_framework/blazor.boot.json
       routes to a 401/404. We post-process the publish output via a target that
       regenerates the manifest using the framework's own
       ComputeBlazorBootJson logic — see Program.cs Fix #1 for the host side. -->
  <Target Name="EmitBlazorBootJson" AfterTargets="Publish">
    <!-- The .NET runtime stub here keeps the file empty if the framework generator
         could not be loaded; the host's fallback endpoint /api/diag/client-error
         will report the gap. We prefer the framework-generated content because it
         carries the exact assembly list the trimmer produced. -->
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\PoTraffic.Shared\PoTraffic.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <!-- Radzen Blazor component library -->
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

</Project>
