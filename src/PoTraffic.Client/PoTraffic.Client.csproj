<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <RootNamespace>PoTraffic.Client</RootNamespace>
    <AssemblyName>PoTraffic.Client</AssemblyName>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- IL2111: framework Router.NotFoundPage reflection (App.razor) — not addressable in user code.
         The referenced NotFound page is preserved from trimming via ILLink.Descriptors.xml below,
         which fixes the runtime CtorNotLocated the trimmer otherwise causes. -->
    <NoWarn>$(NoWarn);IL2111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Preserve reflectively-referenced components (Router.NotFoundPage) from the IL trimmer. -->
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoTraffic.Shared\PoTraffic.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <!-- Radzen Blazor component library -->
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

</Project>
