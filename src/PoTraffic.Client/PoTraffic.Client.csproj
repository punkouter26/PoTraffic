<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <!-- Hosted WASM is served by the classic middleware pipeline in the Api host
         (UseBlazorFrameworkFiles + UseStaticFiles + MapFallbackToFile). That pipeline
         serves physical files by their on-disk name, so asset fingerprinting must be
         OFF — otherwise the published index.html references (blazor.webassembly.js,
         PoTraffic.Client.bundle.scp.css) never match the fingerprinted files on disk
         and every asset 404s. Fingerprinting + placeholder rewriting only works when
         index.html is served through MapStaticAssets(), which a hosted WASM host does
         not use for the client's assets. -->
    <StaticWebAssetFingerprintingEnabled>false</StaticWebAssetFingerprintingEnabled>
    <StaticWebAssetsFingerprintContent>false</StaticWebAssetsFingerprintContent>
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>
    <RootNamespace>PoTraffic.Client</RootNamespace>
    <AssemblyName>PoTraffic.Client</AssemblyName>
    <!-- Run the trim analyzer for OUR code without marking the app assembly IsTrimmable
         (routable @page components must survive — see note below). Surfaces IL2xxx
         trim-safety warnings in the client project so trimming stays clean.
         IL2111 is suppressed: it originates in framework-generated App.razor Router
         code (Router.NotFoundPage setter is accessed via reflection) — inherent to a
         hosted Blazor WASM app that is deliberately NOT IsTrimmable, and not actionable
         in our source. All other trim warnings remain build-breaking. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <NoWarn>$(NoWarn);IL2111</NoWarn>
    <!-- Do NOT mark the Blazor WASM app assembly IsTrimmable. Routable @page components are
         discovered by the framework's runtime route-table scan, which the trimmer can't see;
         member-trimming the app assembly strips those pages from the published build (the "/"
         route among them, so the Router falls through to NotFoundPage). Publish still trims the
         framework and trimmable libraries — the actual size wins — while preserving app pages. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoTraffic.Shared\PoTraffic.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <!-- Radzen Blazor component library -->
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

</Project>
