@PoTraffic.API_HostAddress = http://localhost:5000
@PoTraffic.API_HttpsAddress = https://localhost:5001

###############################################################################
# PoTraffic API - HTTP File for Development & Testing
# Use with VS Code REST Client extension or .NET http requirements
###############################################################################

### ============================================================================
# HEALTH & DIAGNOSTICS
# ============================================================================

# Health check endpoint - returns JSON status of all dependencies
GET {{PoTraffic.API_HostAddress}}/health/json
Accept: application/json

###

# Connection health (admin only) - detailed status of external connections
GET {{PoTraffic.API_HostAddress}}/api/admin/connection-health
Authorization: Bearer {{token}}
Accept: application/json

###

# Diagnostics page - HTML page showing connection status and masked secrets
GET {{PoTraffic.API_HostAddress}}/diag
Accept: text/html

###

### ============================================================================
# AUTHENTICATION
# ============================================================================

# Get available OAuth providers
GET {{PoTraffic.API_HostAddress}}/api/auth/providers
Accept: application/json

###

# Register new user
POST {{PoTraffic.API_HostAddress}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "email": "test@example.com",
  "password": "Test123!",
  "locale": "en-US"
}

###

# Login with email/password
# @name loginResponse
POST {{PoTraffic.API_HostAddress}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "admin@potraffic.dev",
  "password": "Admin123!"
}

###

# Extract token from login response
@token = {{loginResponse.response.body.accessToken}}

###

# Refresh token
POST {{PoTraffic.API_HostAddress}}/api/auth/refresh-token
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{token}}"
}

###

# Logout
POST {{PoTraffic.API_HostAddress}}/api/auth/logout
Authorization: Bearer {{token}}

###

# Confirm email
GET {{PoTraffic.API_HostAddress}}/api/auth/confirm-email?token=verification_token
Accept: application/json

###

### ============================================================================
# ACCOUNT
# ============================================================================

# Get user profile
GET {{PoTraffic.API_HostAddress}}/api/account/profile
Authorization: Bearer {{token}}
Accept: application/json

###

# Update profile
PUT {{PoTraffic.API_HostAddress}}/api/account/profile
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "locale": "en-US"
}

###

# Change password
POST {{PoTraffic.API_HostAddress}}/api/account/change-password
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "currentPassword": "Admin123!",
  "newPassword": "NewPassword123!",
  "confirmNewPassword": "NewPassword123!"
}

###

# Get quota
GET {{PoTraffic.API_HostAddress}}/api/account/quota
Authorization: Bearer {{token}}
Accept: application/json

###

# Delete account
DELETE {{PoTraffic.API_HostAddress}}/api/account/
Authorization: Bearer {{token}}

###

### ============================================================================
# ROUTES
# ============================================================================

# Get all routes
GET {{PoTraffic.API_HostAddress}}/api/routes?page=1&pageSize=20
Authorization: Bearer {{token}}
Accept: application/json

###

# Get available providers
GET {{PoTraffic.API_HostAddress}}/api/routes/providers
Authorization: Bearer {{token}}
Accept: application/json

###

# Verify single address
POST {{PoTraffic.API_HostAddress}}/api/routes/verify-address
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "address": "123 Main St, New York, NY",
  "provider": 0
}

###

# Create route
POST {{PoTraffic.API_HostAddress}}/api/routes
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "originAddress": "123 Main St, New York, NY 10001",
  "destinationAddress": "456 Broadway, New York, NY 10002",
  "provider": 0,
  "startTime": "08:00",
  "endTime": "09:00",
  "daysOfWeekMask": 31
}

###

# Get route by ID
GET {{PoTraffic.API_HostAddress}}/api/routes/{routeId}
Authorization: Bearer {{token}}
Accept: application/json

###

# Update route
PUT {{PoTraffic.API_HostAddress}}/api/routes/{routeId}
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "originAddress": "789 New Address, New York, NY",
  "destinationAddress": "456 Broadway, New York, NY 10002",
  "provider": 1
}

###

# Delete route
DELETE {{PoTraffic.API_HostAddress}}/api/routes/{routeId}
Authorization: Bearer {{token}}

###

# Check now (instant poll)
POST {{PoTraffic.API_HostAddress}}/api/routes/{routeId}/check-now
Authorization: Bearer {{token}}
Accept: application/json

###

### ============================================================================
# MONITORING WINDOWS
# ============================================================================

# Get all windows for a route
GET {{PoTraffic.API_HostAddress}}/api/routes/{routeId}/windows
Authorization: Bearer {{token}}
Accept: application/json

###

# Create monitoring window
POST {{PoTraffic.API_HostAddress}}/api/routes/{routeId}/windows
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "startTime": "07:00",
  "endTime": "09:00",
  "daysOfWeekMask": 31
}

###

# Delete monitoring window
DELETE {{PoTraffic.API_HostAddress}}/api/routes/{routeId}/windows/{windowId}
Authorization: Bearer {{token}}

###

# Start monitoring window
POST {{PoTraffic.API_HostAddress}}/api/routes/{routeId}/windows/{windowId}/start
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{}

###

# Stop monitoring window
POST {{PoTraffic.API_HostAddress}}/api/routes/{routeId}/windows/{windowId}/stop
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "sessionId": "00000000-0000-0000-0000-000000000000"
}

###

### ============================================================================
# HISTORY
# ============================================================================

# Get poll history
GET {{PoTraffic.API_HostAddress}}/api/routes/{routeId}/poll-history?page=1&pageSize=50
Authorization: Bearer {{token}}
Accept: application/json

###

# Get baseline for day of week
GET {{PoTraffic.API_HostAddress}}/api/routes/{routeId}/baseline?dayOfWeek=Monday
Authorization: Bearer {{token}}
Accept: application/json

###

# Get sessions
GET {{PoTraffic.API_HostAddress}}/api/routes/{routeId}/sessions
Authorization: Bearer {{token}}
Accept: application/json

###

# Get optimal departure
GET {{PoTraffic.API_HostAddress}}/api/routes/{routeId}/optimal-departure?dayOfWeek=Monday
Authorization: Bearer {{token}}
Accept: application/json

###

### ============================================================================
# ADMIN (requires AdminOnly role)
# ============================================================================

# Get all users
GET {{PoTraffic.API_HostAddress}}/api/admin/users
Authorization: Bearer {{token}}
Accept: application/json

###

# Get system configuration
GET {{PoTraffic.API_HostAddress}}/api/admin/configuration
Authorization: Bearer {{token}}
Accept: application/json

###

# Update system configuration
PUT {{PoTraffic.API_HostAddress}}/api/admin/configuration/{key}
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "value": "new_value"
}

###

# Get global volatility
GET {{PoTraffic.API_HostAddress}}/api/admin/global-volatility
Authorization: Bearer {{token}}
Accept: application/json

###

# Get recent volatility
GET {{PoTraffic.API_HostAddress}}/api/admin/global-volatility/recent?hours=24
Authorization: Bearer {{token}}
Accept: application/json

###

# Get poll cost summary
GET {{PoTraffic.API_HostAddress}}/api/admin/poll-cost-summary
Authorization: Bearer {{token}}
Accept: application/json

###

# Start triple test
POST {{PoTraffic.API_HostAddress}}/api/admin/triple-test
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "originAddress": "123 Main St, New York, NY",
  "destinationAddress": "456 Broadway, New York, NY",
  "provider": 0,
  "startAt": null
}

###

# Get triple test session
GET {{PoTraffic.API_HostAddress}}/api/admin/triple-test/{sessionId}
Authorization: Bearer {{token}}
Accept: application/json

###

# Seed database
POST {{PoTraffic.API_HostAddress}}/api/admin/seed-data
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "routeCount": 3,
  "daysOfHistory": 14
}

###

# Clear database
POST {{PoTraffic.API_HostAddress}}/api/admin/clear-data
Authorization: Bearer {{token}}
Accept: application/json

{}

###

### ============================================================================
# SYSTEM / CONFIG
# ============================================================================

# Get system endpoints info
GET {{PoTraffic.API_HostAddress}}/api/system/info
Accept: application/json

###

# Get feature flags
GET {{PoTraffic.API_HostAddress}}/api/system/features
Accept: application/json

###

### ============================================================================
# ERROR ENDPOINT
# ============================================================================

# Test error handling
GET {{PoTraffic.API_HostAddress}}/error
Accept: application/json

###
