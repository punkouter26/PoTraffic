{
  // Testing is a local-only environment (E2E host + WebApplicationFactory), never deployed.
  // Without an explicit connection string it is not Development either, so the storage client
  // falls through to the Production managed-identity branch, fails against IMDS, and the host
  // degrades to memory-only with /health/json stuck at 503 — which the E2E readiness gate
  // never passes. Integration tests override this with ConnectionStrings__TableStorage
  // pointing at their own Testcontainer; that env var still wins over this file.
  "ConnectionStrings": {
    "TableStorage": "UseDevelopmentStorage=true"
  },
  "AzureTable": {
    "UseManagedIdentity": false
  },
  "Features": {
    "UseMockProviders": true,
    "EnableAiFeatures": false,
    "EnableExternalTrafficProviders": false,
    "EnableAdvancedAnalytics": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Authentication": "Information",
        "PoTraffic": "Debug"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "PoTraffic": "Debug"
    }
  },
  "AzureKeyVault": {
    "VaultUri": ""
  }
}