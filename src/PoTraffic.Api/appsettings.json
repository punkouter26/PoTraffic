{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/potraffic-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "ConnectionStrings": {
    "TableStorage": ""
  },
  "ExternalAuth": {
    "Google": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": "",
      "Scopes": [
        "openid",
        "email",
        "profile"
      ]
    },
    "Microsoft": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": "",
      "Scopes": [
        "openid",
        "email",
        "profile"
      ]
    }
  },
  "KeyVault": {
    "Uri": ""
  },
  "Diag": {
    "SecretToken": ""
  },
  "Features": {
    "TripleTestEnabled": true,
    "UseMockProviders": false,
    "EnableAiFeatures": false,
    "EnableExternalTrafficProviders": true,
    "EnableAdvancedAnalytics": false
  },
  "AllowedHosts": "*",
  "Auth": {
    "AdminEmail": "punkouter26@outlook.com"
  },
  "AzureTable": {
    "AccountName": "potraffic"
  }
}