{
  "ConnectionStrings": {
    "TableStorage": "UseDevelopmentStorage=true"
  },
  "GoogleMaps": {
    "ApiKey": ""
  },
  "Features": {
    "UseMockProviders": false,
    "EnableAiFeatures": true,
    "EnableExternalTrafficProviders": true,
    "EnableAdvancedAnalytics": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Authentication": "Information"
      }
    }
  },
  "AzureCredential": {
    "ExcludeManagedIdentityCredential": true
  },
  "KeyVault": {
    "Uri": "https://kv-poshared.vault.azure.net/"
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  }
}