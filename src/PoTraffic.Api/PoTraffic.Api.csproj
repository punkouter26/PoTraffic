<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PoTraffic.Api</RootNamespace>
    <AssemblyName>PoTraffic.Api</AssemblyName>
    <UserSecretsId>7c9e89ba-4021-4c24-82f9-585eb1df7be1</UserSecretsId>
  </PropertyGroup>

  <!--
    Host project. CPM owns versions (Directory.Packages.props); this file only
    references packages the host uses directly. Everything else is pulled in
    transitively via the Infrastructure ProjectReference.
  -->

  <ItemGroup>
    <ProjectReference Include="..\PoTraffic.Domain\PoTraffic.Domain.csproj" />
    <ProjectReference Include="..\PoTraffic.Application\PoTraffic.Application.csproj" />
    <ProjectReference Include="..\PoTraffic.Infrastructure\PoTraffic.Infrastructure.csproj" />
    <!-- Shared DTOs/Enums/Constants -->
    <ProjectReference Include="..\PoTraffic.Shared\PoTraffic.Shared.csproj" />
    <!-- Blazor WASM hosted client assets -->
    <ProjectReference Include="..\PoTraffic.Client\PoTraffic.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Blazor WASM server hosting (composition root) -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <!-- OpenAPI document + Scalar UI -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- Pin Newtonsoft.Json to a patched 13.x release (CVE-2024-21907) -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

</Project>
