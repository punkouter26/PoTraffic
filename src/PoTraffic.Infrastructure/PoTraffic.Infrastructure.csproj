<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PoTraffic.Infrastructure</RootNamespace>
    <AssemblyName>PoTraffic.Infrastructure</AssemblyName>
    <!--
      Library output despite using the Web SDK: we need ASP.NET Core
      (IWebHostEnvironment, IServiceCollection, IKeyedServiceProvider) at
      compile time. The host API project links against this DLL.
      Microsoft.NET.Sdk.Web + OutputType=Library is the only sanctioned way
      to share a single assembly between the host and a class library.
    -->
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!--
    Infrastructure project — shares the Microsoft.AspNetCore.App framework with
    the host API project. CPM is the single source of truth for package versions
    — see Directory.Packages.props.
  -->

  <ItemGroup>
    <ProjectReference Include="..\PoTraffic.Shared\PoTraffic.Shared.csproj" />
    <ProjectReference Include="..\PoTraffic.Domain\PoTraffic.Domain.csproj" />
    <ProjectReference Include="..\PoTraffic.Application\PoTraffic.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packages that Infrastructure uses directly (not just transitively).
         The host API project also references these and pulls in transitive deps. -->
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Pin Newtonsoft.Json to a patched 13.x release (CVE-2024-21907). -->
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.ApplicationInsights" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="AspNetCore.HealthChecks.Uris" />
  </ItemGroup>

</Project>
