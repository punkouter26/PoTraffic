# Build outputs
bin/
obj/

# Visual Studio / JetBrains
.vs/
# Ignore .vscode CONTENTS but keep the shared F5 wiring (Rule 3.4). Use .vscode/* (not
# .vscode/) so the negations below can re-include specific files — a directory-level
# ignore is never descended into, so file negations under it would be dead.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
*.user
*.suo
*.userosscache
*.sln.docstates
.idea/

# NuGet
*.nupkg
*.snupkg
packages/
!**/packages/build/
project.lock.json
project.fragment.lock.json
artifacts/

# Serilog rolling file logs
logs/
*.log

# Test results
TestResults/
coverage/
*.coverage
*.coveragexml

# OS artefacts
.DS_Store
Thumbs.db

# Secrets / environment
.env
.env.*
appsettings.*.local.json

# PoTune session state (local tooling only)
.potune-state.json

# Playwright test artifacts
test-results/
playwright-report/
*.webm
*.zip
.playwright/

# Node modules (if any E2E tooling adds them)
node_modules/

# Merge conflict originals
*.orig

# GitHub Copilot agent files (local tooling)
.copilotignore

# dotnet publish output
publish/

# Bootstrap vendor dist — only bootstrap.min.css is intentionally tracked.
# All other variants (grid, reboot, utilities, RTL, JS bundles, source maps)
# were removed in cleanup and must not be re-added accidentally.
src/**/wwwroot/lib/bootstrap/dist/css/bootstrap-*.css
src/**/wwwroot/lib/bootstrap/dist/css/bootstrap-*.css.map
src/**/wwwroot/lib/bootstrap/dist/css/bootstrap.css
src/**/wwwroot/lib/bootstrap/dist/css/bootstrap.css.map
src/**/wwwroot/lib/bootstrap/dist/css/bootstrap.min.css.map
src/**/wwwroot/lib/bootstrap/dist/css/bootstrap.rtl*
src/**/wwwroot/lib/bootstrap/dist/js/

# Test binary artefacts
**/*.trx
*.coverage
*.coveragexml

# JetBrains Rider
.idea/
*.sln.iml

# Visual Studio Code workspace-specific settings (not launch/tasks)
.vscode/settings.json
.vscode/*.code-snippets

# Azure Functions local settings (may contain secrets)
local.settings.json

# User secrets manifest (secrets themselves are in %APPDATA%)
secrets.json

logs_out/
logs.zip
*.zip

# Azurite (local Azure Storage emulator) data
azurite/
.azurite/

# Playwright MCP page snapshots
.playwright-mcp/

# Ad-hoc QA screenshots at repo root
/*.png

# Container runtime data
.docker/

# LLMDOCS generated artifacts (all)
LLMDOCS/

# Azure App Service / Kudu diagnostic log dumps (never committed)
app-logs-fresh/
app-logs-latest/
app-logs*/

# Debug logging
*.log.txt

# Rider
*.dotSettings.user

# ReSharper
*_ReSharper*
*.DotSettings.user

# LSCache build artifacts
*.csproj.lscache

# CI/CD output snapshots — generated at runtime, never source-controlled
output.json

# Azure Developer CLI
.azure/

# Terraform / Bicep state
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Cursor / Windsurf / AI editor metadata
.cursor/
.cursorignore
.windsurfrules

# dotnet tool manifests local overrides
.config/dotnet-tools.json
