#!/bin/sh
# PoTraffic pre-commit hook — runs `dotnet format` on staged C# files only (fast).
# This replaces the old CI `dotnet format --verify-no-changes` gate, which blocked
# deploys on pure-whitespace diffs. Catch style locally instead of in the pipeline.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass for a commit:     git commit --no-verify

staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.cs')
[ -z "$staged" ] && exit 0

echo "pre-commit: dotnet format (staged C# files)…"
dotnet format PoTraffic.slnx --include $staged --verify-no-changes --verbosity minimal
if [ $? -ne 0 ]; then
  echo "" >&2
  echo "✗ Formatting issues in staged files. Fix with:" >&2
  echo "    dotnet format PoTraffic.slnx --include $staged" >&2
  echo "  then re-stage and commit (or 'git commit --no-verify' to skip)." >&2
  exit 1
fi
