{
  "version": 1,
  "conventions": {
    "packageManager": "dotnet",
    "languages": ["csharp"],
    "test": "./SCRIPTS/run-tests.ps1",
    "lint": "./SCRIPTS/lint-inline-styles.ps1",
    "typecheck": "dotnet build",
    "build": "dotnet build src/PoTraffic.Api/PoTraffic.Api.csproj -c Debug",
    "ci": ".github/workflows/deploy.yml",
    "defaultBranch": "master"
  },
  "preferences": {
    "outputStyle": "normal",
    "autonomy": "gate-all",
    "tdd": "pragmatic",
    "specDir": "docs",
    "boardTracking": "gitignored",
    "families": ["health"],
    "health": {
      "protectedPaths": [
        "**/bin/**",
        "**/obj/**",
        "**/*.generated.cs",
        "**/*.designer.cs",
        "**/*.g.cs"
      ],
      "deflakeRuns": 20
    }
  }
}
