<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PoTraffic.UnitTests — STRICT Unit tier.

    Rules:
      • No I/O of any kind (no HTTP, no disk, no real clock, no network).
      • No Azurite. No Testcontainers. No WebApplicationFactory.
      • Only NSubstitute mocks, FluentAssertions, FluentValidation,
        FluentValidation.TestHelper, xUnit.
      • FluentValidation tests live here.
      • DTO mapping tests live here.
      • Handler tests that need I/O go to PoTraffic.IntegrationTests (Integration).

    Enforced by UnitTierGuard module initializer in GlobalUsings.cs.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PoTraffic.UnitTests</RootNamespace>
    <AssemblyName>PoTraffic.UnitTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PoTraffic.Shared\PoTraffic.Shared.csproj" />
    <ProjectReference Include="..\..\src\PoTraffic.API\PoTraffic.API.csproj" />
    <!--
      The client's departure solver is pure arithmetic over baseline slots — no I/O,
      no JS interop, no component. It belongs in the strict Unit tier, and it is the
      one piece of client code that decides what time a user actually leaves.
    -->
    <ProjectReference Include="..\..\src\PoTraffic.Client\PoTraffic.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>